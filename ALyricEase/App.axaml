<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ALyricEase.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ALyricEase/Styles/Foundation/Colors.axaml" />
                <ResourceInclude Source="avares://ALyricEase/Styles/Foundation/Dimensions.axaml" />
                <ResourceInclude Source="avares://ALyricEase/Styles/Foundation/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ALyricEase/Styles/Foundation/Typography.axaml" />
        <StyleInclude Source="avares://ALyricEase/Styles/Controls/Buttons.axaml" />
        <StyleInclude Source="avares://ALyricEase/Styles/Controls/Common.axaml" />
    </Application.Styles>
</Application>
