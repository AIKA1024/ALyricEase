<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ALyricEase.Views"
        xmlns:vm="using:ALyricEase.ViewModels"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="ALyricEase.MainWindow"
        Title="ALyricEase" Width="1200" Height="720" MinWidth="360" MinHeight="560"
        Icon="/Assets/app.ico" Background="Transparent" TransparencyLevelHint="AcrylicBlur"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="48">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:RecommendViewModel">
      <views:RecommendView />
    </DataTemplate>
    <DataTemplate DataType="vm:SearchViewModel">
      <views:SearchView />
    </DataTemplate>
    <DataTemplate DataType="vm:PlaylistViewModel">
      <views:PlaylistView />
    </DataTemplate>
    <DataTemplate DataType="vm:PlaceholderViewModel">
      <views:PlaceholderView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Button.navigation-button">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Button.navigation-button:pointerover"><Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" /></Style>
    <Style Selector="ListBox.shell-navigation > ListBoxItem">
      <Setter Property="MinHeight" Value="40" /><Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="12,0" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.shell-navigation > ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="ListBox.shell-navigation > ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource NavigationSelected}" />
    </Style>
      <Style Selector="ListBox.shell-navigation > ListBoxItem:disabled">
        <Setter Property="Opacity" Value="1" /><Setter Property="Background" Value="Transparent" /><Setter Property="Cursor" Value="Arrow" />
      </Style>
    <Style Selector="TextBlock.nav-header">
      <Setter Property="FontWeight" Value="Bold" /><Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.close-control:pointerover">
      <Setter Property="Background" Value="#E81123" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <ExperimentalAcrylicBorder Material="{DynamicResource AppAcrylicMaterial}">
    <Grid RowDefinitions="48,*">
      <!-- 原版风格自绘标题栏：左侧拖拽区，右侧窗口控制。 -->
      <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" PointerPressed="OnTitleBarPointerPressed"
            ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Classes="icon-button" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"
                  Width="40" Height="40" ToolTip.Tip="返回上一页">
            <TextBlock x:Name="BackGlyph" Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          </Button>
          <Image Source="avares://ALyricEase/Assets/icon_24.png" Width="24" Height="24" />
          <TextBlock Text="ALyricEase" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimary}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Classes="window-control" Click="OnMinimizeClick" ToolTip.Tip="最小化"
                  HorizontalContentAlignment="Center">
            <TextBlock x:Name="MinGlyph" Text="—" FontSize="16" VerticalAlignment="Center" />
          </Button>
          <Button Classes="window-control" Click="OnMaximizeClick" ToolTip.Tip="最大化"
                  HorizontalContentAlignment="Center">
            <TextBlock x:Name="MaxGlyph" Text="□" FontSize="15" VerticalAlignment="Center" />
          </Button>
          <Button Classes="window-control close-control" Click="OnCloseClick" ToolTip.Tip="关闭"
                  HorizontalContentAlignment="Center">
            <TextBlock x:Name="CloseGlyph" Text="×" FontSize="22" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
        <!-- 完整导航：截图中的桌面展开态。 -->
        <Border Grid.Column="0" Width="320" IsVisible="{Binding IsNavigationExpanded}"
                Background="Transparent" BorderThickness="0">
          <DockPanel>
            <Button DockPanel.Dock="Top" Classes="icon-button" Command="{Binding ToggleNavigationExpandedCommand}"
                    Width="48" Height="48" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip.Tip="收起侧边栏">
              <TextBlock Text="☰" FontSize="18" />
            </Button>
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorder}"
                    Padding="0,10,0,0">
              <StackPanel Margin="8,0,8,8">
                <Button Classes="navigation-button" Command="{Binding GoAccountCommand}">
                  <Grid ColumnDefinitions="24,*" ColumnSpacing="10"><TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="18" /><TextBlock Grid.Column="1" Text="账号" FontSize="14" /></Grid>
                </Button>
                <Button Classes="navigation-button" Command="{Binding GoSettingsCommand}">
                  <Grid ColumnDefinitions="24,*" ColumnSpacing="10"><TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="18" /><TextBlock Grid.Column="1" Text="设置" FontSize="14" /></Grid>
                </Button>
              </StackPanel>
            </Border>
            <ListBox Classes="shell-navigation" ItemsSource="{Binding ShellNavItems}" SelectedItem="{Binding SelectedNav}"
                     Background="Transparent" BorderThickness="0" Margin="4,4,0,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem" x:DataType="vm:NavItemViewModel">
                <Setter Property="IsEnabled" Value="{Binding IsItem}" />
                <Setter Property="Focusable" Value="{Binding IsItem}" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                  <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                    <TextBlock Text="{Binding IconGlyph}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="17" VerticalAlignment="Center" IsVisible="{Binding IsItem}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" IsVisible="{Binding IsItem}" />
                    <TextBlock Classes="nav-header" Text="{Binding Label}" Grid.ColumnSpan="2" Margin="0,4,0,-2" IsVisible="{Binding IsHeader}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- 原版中/小屏态：仍是左侧图标栏，不用底部导航取代。 -->
        <Border Grid.Column="0" Width="48" IsVisible="{Binding IsNavigationCompact}"
                Background="Transparent" BorderThickness="0">
          <DockPanel>
            <Button DockPanel.Dock="Top" Classes="icon-button" Command="{Binding ToggleNavigationExpandedCommand}"
                    Width="48" Height="48" ToolTip.Tip="展开侧边栏">
              <TextBlock Text="☰" FontSize="18" />
            </Button>
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorder}"
                    Padding="0,8,0,0">
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <Button Classes="icon-button" Command="{Binding GoAccountCommand}" Width="48" Height="40">
                  <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="18" />
                </Button>
                <Button Classes="icon-button" Command="{Binding GoSettingsCommand}" Width="48" Height="40">
                  <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="18" />
                </Button>
              </StackPanel>
            </Border>
            <ListBox Classes="shell-navigation" ItemsSource="{Binding PrimaryNavItems}"
                     SelectedItem="{Binding SelectedNav}"
                     Width="48" Background="Transparent" BorderThickness="0" Margin="0,4,0,4">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                  <TextBlock Text="{Binding IconGlyph}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="18"
                             HorizontalAlignment="Center" ToolTip.Tip="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource AppBackground}" CornerRadius="8,0,0,0">
          <Grid x:Name="ContentArea" ClipToBounds="True">
            <!-- 内容页:延伸到播放条后面,滚动内容从播放条下方穿过 -->
            <TransitioningContentControl x:Name="PageHost" Content="{Binding CurrentContent}">
              <TransitioningContentControl.PageTransition>
                <CompositePageTransition>
                  <CompositePageTransition.PageTransitions>
                    <PageSlide Orientation="Horizontal" Duration="0:0:0.3" /><CrossFade Duration="0:0:0.3" />
                  </CompositePageTransition.PageTransitions>
                </CompositePageTransition>
              </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
            <!-- 应用内毛玻璃曾用 VisualBrush+BlurEffect,但 Avalonia 12.1.1 的 BlurEffect 不实际渲染(见诊断),已移除 -->
            <views:PlayerBarView DataContext="{Binding Player}" VerticalAlignment="Bottom" ZIndex="1" />
          </Grid>
        </Border>
      </Grid>

      <TransitioningContentControl Grid.Row="0" Grid.RowSpan="2" Content="{Binding NowPlayingContent}"
                                   IsVisible="{Binding ShowNowPlaying}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="100">
        <TransitioningContentControl.ContentTemplate>
          <DataTemplate>
            <views:NowPlayingView
              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
          </DataTemplate>
        </TransitioningContentControl.ContentTemplate>
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.25" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>
  </ExperimentalAcrylicBorder>
</Window>