<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button.icon-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.icon-button:pressed">
        <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
    </Style>

    <Style Selector="Button.player-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="1000" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.player-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.player-button:pressed">
        <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
    </Style>

    <Style Selector="Button.navigation-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.navigation-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>

    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="{DynamicResource LyricEaseTeal}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.primary-action:pointerover">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- 歌手页关注按钮:teal #5EA9A2 轮廓,悬停填充 teal,按下加深(原版 FluentFollowButton 无自定义样式,按此实现) -->
    <Style Selector="Button.follow-button">
        <Setter Property="Foreground" Value="#FF5EA9A2" />
        <Setter Property="BorderBrush" Value="#FF5EA9A2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.follow-button:pointerover">
        <Setter Property="Background" Value="#FF5EA9A2" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.follow-button:pressed">
        <Setter Property="Background" Value="#FF4E8B85" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- 通用"更多/展开"圆按钮(歌手页/专辑页/各处复用):悬停 SystemBaseLow、按下 SystemBaseMediumLow -->
    <Style Selector="Button.more-button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.more-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>
    <Style Selector="Button.more-button:pressed">
        <Setter Property="Background" Value="{DynamicResource SystemBaseMediumLow}" />
    </Style>

    <!-- 每日行歌手/专辑菜单项:在 Flyout 弹层里,必须全局样式才能命中(弹层不在行的视觉树)。
         高 32、圆角 8、左内边距 12、图标16+间距8+文本;横向撑满菜单宽度,悬停整项高亮 -->
    <Style Selector="Button.track-menu-item">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.track-menu-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>
    <!-- 多歌手"表演者"子菜单打开态:弹层盖住按钮时 :pointerover 会消失,用此类保持高亮 -->
    <Style Selector="Button.track-menu-item.track-menu-open">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>

    <!-- 每日行歌手/专辑菜单项(MenuFlyout 版):高 32、圆角 8、左内边距 12、图标16,悬停高亮;
         纵向 margin 2 让相邻项之间有间距 -->
    <Style Selector="MenuItem.track-menu-item">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="MenuItem.track-menu-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>
    <!-- 子菜单项:ItemsSource 生成的 MenuItem 未必带 track-menu-item 类,用后代选择器统一继承主菜单项样式 -->
    <Style Selector="MenuItem.track-menu-item MenuItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="MenuItem.track-menu-item MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>
</Styles>
