<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:AlbumViewModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ALyricEase.Views.AlbumView">
  <Grid RowDefinitions="96,*">
    <Grid Grid.Row="0" Margin="48,0,32,0">
      <TextBlock Text="专辑" Classes="page-title" VerticalAlignment="Center" />
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="48,0,32,116" Spacing="0">
        <!-- 头部卡片(仿原版 AlbumDetailViewHeaderCard):300 高 + 260 封面 + 右下信息/按钮 -->
        <Border BorderBrush="{DynamicResource ListCardBorder}" BorderThickness="1"
                Background="{DynamicResource AppSurfaceElevated}" Height="300" CornerRadius="8" Padding="20"
                Margin="0,0,0,12">
          <Grid ColumnDefinitions="260,*" ColumnSpacing="20">
            <Border CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ArtFallback}">
              <Image Source="{Binding Cover}" Stretch="UniformToFill" />
            </Border>
            <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="32" FontWeight="Bold"
                         TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Text="{Binding ArtistName}" FontSize="24" FontWeight="Bold"
                         Foreground="{DynamicResource LyricEaseTeal}" TextTrimming="CharacterEllipsis" MaxLines="1"
                         HorizontalAlignment="Left" />
              <TextBlock Grid.Row="2" Text="{Binding PublishDateText}" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="3" Text="{Binding Description}" FontSize="16" Foreground="{DynamicResource TextTertiary}"
                         MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding HasDescription}" HorizontalAlignment="Left" />
              <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                <Button Background="{DynamicResource LyricEaseRed}" Foreground="White" BorderThickness="0"
                        CornerRadius="18" Height="36" Padding="14,0" Command="{Binding PlayAllCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▶" FontSize="13" />
                    <TextBlock Text="播放全部" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Width="36" Height="36" Padding="0" Background="{DynamicResource AppSurface}"
                        BorderThickness="1" BorderBrush="{DynamicResource AppBorder}" CornerRadius="18"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="更多操作(后续接入)">
                  <TextBlock Text="•••" LetterSpacing="1" />
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <!-- 曲目列表卡(仿原版 ListView 卡) -->
        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource ListCardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="8,6">
          <ItemsControl ItemsSource="{Binding Songs}" ContainerPrepared="OnTrackContainerPreparing">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SongItemViewModel">
                <views:TrackRow />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
