<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:views="using:ALyricEase.Views"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="ALyricEase.Views.NowPlayingView" Focusable="True">
    <UserControl.Styles>
        <Style Selector="Grid#DesktopPlaybackLayout">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Grid#PhonePlaybackLayout">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UserControl.compact Grid#DesktopPlaybackLayout">
            <Setter Property="Margin" Value="56,76,56,40" />
            <Setter Property="ColumnSpacing" Value="36" />
        </Style>
        <Style Selector="UserControl.compact Border#DesktopArtwork">
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="360" />
        </Style>
        <Style Selector="UserControl.narrow Grid#DesktopPlaybackLayout">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UserControl.narrow Grid#PhonePlaybackLayout">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="UserControl.narrow Button.top-action">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>
    </UserControl.Styles>

    <Grid KeyDown="OnKeyDown" Background="#FF000000">
        <Image Source="{Binding Player.Cover}" Stretch="UniformToFill" Opacity="0.9">
            <Image.Effect><BlurEffect Radius="100" /></Image.Effect>
        </Image>
        <Rectangle Fill="#CC000000" />

        <!-- 顶部拖拽条:播放详情页盖住标题栏时,按住顶部空白区可拖动窗口 -->
        <Grid Height="48" VerticalAlignment="Top" Background="Transparent" ZIndex="1"
              PointerPressed="OnTitleDragPressed" />

        <Button Classes="player-button top-action" Command="{Binding CloseNowPlayingCommand}"
                Width="50" Height="50" Margin="20,16,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip.Tip="收起" ZIndex="2">
            <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" Foreground="White" />
        </Button>
        <Button Classes="player-button top-action" Width="50" Height="50" Margin="0,16,20,0"
                HorizontalAlignment="Right" VerticalAlignment="Top" IsEnabled="False"
                ToolTip.Tip="更多操作将在后续阶段接入" ZIndex="2">
            <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" Foreground="White" />
        </Button>

        <Grid x:Name="DesktopPlaybackLayout" ColumnDefinitions="*,400" ColumnSpacing="54"
              Margin="86,76,86,50" MaxWidth="1120" HorizontalAlignment="Center">
            <Border x:Name="DesktopArtwork" Grid.Column="0" Width="480" Height="480" MaxWidth="600" MaxHeight="600"
                    CornerRadius="16" ClipToBounds="True" Background="#22FFFFFF"
                    BoxShadow="0 10 50 #4D000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Player.Cover, Converter={x:Static infra:CoverImageConverter.Instance}}" Stretch="UniformToFill" />
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
                    <TextBlock Text="{Binding Player.Title}" FontSize="20" FontWeight="Bold" LetterSpacing="-0.2"
                               TextTrimming="CharacterEllipsis" Foreground="White" />
                    <TextBlock Text="{Binding Player.Artist}" FontSize="16" TextTrimming="CharacterEllipsis" Foreground="#BFFFFFFF" />
                </StackPanel>
                <Grid Grid.Row="1" RowDefinitions="30,Auto" Margin="0,0,0,12">
                    <Slider Classes="player-progress" Minimum="0" Maximum="{Binding Player.ProgressMaximum}"
                            Value="{Binding Player.PositionMs}" Height="30" IsEnabled="{Binding Player.HasProgress}"
                            PointerPressed="OnTimelinePointerPressed" PointerReleased="OnTimelinePointerReleased" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*">
                        <TextBlock Text="{Binding Player.PositionText}" FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                        <TextBlock Grid.Column="1" Text="{Binding Player.DurationText}" HorizontalAlignment="Right"
                                   FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                    </Grid>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="50,*,50" Margin="0,0,0,10">
                    <Button Classes="player-button" Grid.Column="0" Width="50" Height="50" IsEnabled="False">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                        <Button Classes="player-button" Width="50" Height="50" IsEnabled="False">
                            <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="20" Foreground="White" />
                        </Button>
                        <Button Classes="player-button" Command="{Binding Player.TogglePlayPauseCommand}" Width="60" Height="60">
                            <Grid>
                                <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" Foreground="White"
                                           IsVisible="{Binding Player.ShowPauseIcon}" />
                                <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" Foreground="White"
                                           IsVisible="{Binding Player.ShowPlayIcon}" />
                                <TextBlock Text="•••" FontSize="14" LetterSpacing="2" Foreground="White"
                                           IsVisible="{Binding Player.ShowLoadingIcon}" />
                            </Grid>
                        </Button>
                        <Button Classes="player-button" Width="50" Height="50" IsEnabled="False">
                            <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="20" Foreground="White" />
                        </Button>
                    </StackPanel>
                    <Button Classes="player-button" Grid.Column="2" Width="50" Height="50" IsEnabled="False">
                        <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="20" Foreground="White" />
                    </Button>
                </Grid>
                <Grid Grid.Row="3" Height="300">
                    <views:LyricView DataContext="{Binding Lyric}" />
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="PhonePlaybackLayout" Margin="20,74,20,20" RowDefinitions="Auto,Auto,*,Auto,Auto">
            <Border Grid.Row="0" Width="220" Height="220" CornerRadius="14" ClipToBounds="True"
                    Background="#22FFFFFF" BoxShadow="0 8 40 #4D000000" HorizontalAlignment="Center">
                <Image Source="{Binding Player.Cover, Converter={x:Static infra:CoverImageConverter.Instance}}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Row="1" Margin="0,16,0,8" Spacing="2">
                <TextBlock Text="{Binding Player.Title}" FontSize="20" FontWeight="Bold" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="White" />
                <TextBlock Text="{Binding Player.Artist}" FontSize="14" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="#BFFFFFFF" />
            </StackPanel>
            <views:LyricView Grid.Row="2" DataContext="{Binding Lyric}" MinHeight="96" />
            <Grid Grid.Row="3" RowDefinitions="28,Auto" Margin="0,8,0,4">
                <Slider Classes="player-progress" Minimum="0" Maximum="{Binding Player.ProgressMaximum}"
                        Value="{Binding Player.PositionMs}" Height="28" IsEnabled="{Binding Player.HasProgress}"
                        PointerPressed="OnTimelinePointerPressed" PointerReleased="OnTimelinePointerReleased" />
                <Grid Grid.Row="1" ColumnDefinitions="*,*">
                    <TextBlock Text="{Binding Player.PositionText}" FontSize="12" Foreground="#BFFFFFFF" />
                    <TextBlock Grid.Column="1" Text="{Binding Player.DurationText}" FontSize="12"
                               HorizontalAlignment="Right" Foreground="#BFFFFFFF" />
                </Grid>
            </Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                <Button Classes="player-button" Width="48" Height="48" IsEnabled="False">
                    <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="19" Foreground="White" />
                </Button>
                <Button Classes="player-button" Command="{Binding Player.TogglePlayPauseCommand}" Width="64" Height="64">
                    <Grid>
                        <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="30" Foreground="White"
                                   IsVisible="{Binding Player.ShowPauseIcon}" />
                        <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="30" Foreground="White"
                                   IsVisible="{Binding Player.ShowPlayIcon}" />
                        <TextBlock Text="•••" FontSize="14" LetterSpacing="2" Foreground="White"
                                   IsVisible="{Binding Player.ShowLoadingIcon}" />
                    </Grid>
                </Button>
                <Button Classes="player-button" Width="48" Height="48" IsEnabled="False">
                    <TextBlock Text="" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="19" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
