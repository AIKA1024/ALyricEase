<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:views="using:ALyricEase.Views"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d" d:DesignWidth="930" d:DesignHeight="600"
             x:Class="ALyricEase.Views.NowPlayingView">
    <!-- LyricEase/Apple Music 式正在播放页:模糊封面背景 + 大封面 + 歌词 + 控制。
         响应式:宽窗=封面左歌词右;窄窗(<840)=封面在上歌词在下(代码后置 SizeChanged 切换) -->
    <Grid KeyDown="OnKeyDown">
        <!-- 模糊封面背景 + 深色遮罩 -->
        <Image Source="{Binding Player.Cover}" Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect Radius="40" />
            </Image.Effect>
        </Image>
        <Rectangle Fill="#99000000" />

        <!-- 前景内容 -->
        <Grid RowDefinitions="Auto,*,Auto" Margin="28,18,24,18">
            <!-- 顶栏:返回 + 曲目(共享) -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <Button Classes="playerctl" Command="{Binding CloseNowPlayingCommand}" ToolTip.Tip="返回"
                        Width="44" Height="44" CornerRadius="22">
                    <PathIcon Data="M 6,10 L 13,3 L 14.4,4.4 L 9,10 L 14.4,15.6 L 13,17 Z M 4,10 L 8,10 L 16,10 L 16,11 L 8,11 Z"
                              Width="18" Height="18" Foreground="White" />
                </Button>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Player.Title}" FontSize="20" FontWeight="SemiBold"
                               LetterSpacing="-0.02" TextTrimming="CharacterEllipsis" Foreground="White" />
                    <TextBlock Text="{Binding Player.Artist}" FontSize="13" Opacity="0.7"
                               TextTrimming="CharacterEllipsis" Foreground="White" />
                </StackPanel>
            </Grid>

            <!-- 中部:宽布局(封面左 / 歌词右) -->
            <Grid Grid.Row="1" x:Name="WideLayout" ColumnDefinitions="Auto,*" Margin="0,10,0,6">
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="320" Height="320" CornerRadius="16" ClipToBounds="True"
                            Background="#22FFFFFF"
                            BoxShadow="0 12 50 #66000000">
                        <Image Source="{Binding Player.Cover}" Stretch="UniformToFill" />
                    </Border>
                </StackPanel>
                <views:LyricView Grid.Column="1" DataContext="{Binding Lyric}" Margin="28,0,0,0" />
            </Grid>

            <!-- 中部:窄布局(封面上 / 歌词下) -->
            <Grid Grid.Row="1" x:Name="NarrowLayout" RowDefinitions="Auto,*" Margin="0,10,0,6" IsVisible="False">
                <Border Grid.Row="0" Width="200" Height="200" CornerRadius="14" ClipToBounds="True"
                        Background="#22FFFFFF" HorizontalAlignment="Center"
                        BoxShadow="0 10 40 #66000000">
                    <Image Source="{Binding Player.Cover}" Stretch="UniformToFill" />
                </Border>
                <views:LyricView Grid.Row="1" DataContext="{Binding Lyric}" Margin="0,14,0,0" />
            </Grid>

            <!-- 底部:时间线 + 控制(共享) -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="44,0">
                    <TextBlock Text="{Binding Player.PositionText}" FontSize="12" Opacity="0.75"
                               VerticalAlignment="Center" Foreground="White" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding Player.ProgressMaximum}"
                            Value="{Binding Player.PositionMs}" Margin="12,0"
                            IsEnabled="{Binding Player.HasProgress}"
                            PointerPressed="OnTimelinePointerPressed"
                            PointerReleased="OnTimelinePointerReleased" />
                    <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="12" Opacity="0.75"
                               VerticalAlignment="Center" Foreground="White" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,10,0,0" Spacing="28">
                    <Button Classes="playerctl" Width="48" Height="48" CornerRadius="24" IsEnabled="False">
                        <PathIcon Data="M 4,2 L 9,2 L 9,14 L 4,14 Z M 11,2 L 13.5,2 L 13.5,14 L 11,14 Z"
                                  Width="18" Height="18" Foreground="White" />
                    </Button>
                    <Button Classes="playerctl" Command="{Binding Player.TogglePlayPauseCommand}"
                            Width="60" Height="60" CornerRadius="30">
                        <Grid>
                            <PathIcon IsVisible="{Binding Player.ShowLoadingIcon}" Width="26" Height="26"
                                      Foreground="White"
                                      Data="M 4,2 L 10,5 L 10,11 L 4,14 Z M 12,2 L 12,14" />
                            <PathIcon IsVisible="{Binding Player.ShowPauseIcon}" Width="26" Height="26"
                                      Foreground="White"
                                      Data="M 3,2 L 6,2 L 6,14 L 3,14 Z M 10,2 L 13,2 L 13,14 L 10,14 Z" />
                            <PathIcon IsVisible="{Binding Player.ShowPlayIcon}" Width="26" Height="26"
                                      Foreground="White"
                                      Data="M 4,1 L 14,7 L 4,13 Z" />
                        </Grid>
                    </Button>
                    <Button Classes="playerctl" Width="48" Height="48" CornerRadius="24" IsEnabled="False">
                        <PathIcon Data="M 13,2 L 18,2 L 18,14 L 13,14 Z M 6,2 L 8.5,2 L 8.5,14 L 6,14 Z"
                                  Width="18" Height="18" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
