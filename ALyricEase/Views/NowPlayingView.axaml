<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:views="using:ALyricEase.Views"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="ALyricEase.Views.NowPlayingView" Focusable="True">
    <UserControl.Styles>
        <Style Selector="UserControl.narrow Button.top-action">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>

        <!-- 底部切换按钮(歌词/全屏/播放列表 + 歌词面板的翻译开关):仿原版 DefaultLyricEaseToggleButtonStyle
             —— 默认透明、悬停 SystemBaseLow、按下 SystemBaseMediumLow、选中白底黑字 -->
        <Style Selector="ToggleButton.le-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.le-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.le-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.le-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="ToggleButton.le-toggle:checked">
            <Setter Property="Foreground" Value="#FF1F1F1F" />
        </Style>
        <Style Selector="ToggleButton.le-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0FFFFFF" />
        </Style>

        <!-- 歌词面板右下字号按钮:与 le-toggle 同观感但不可选中(弹出字号菜单) -->
        <Style Selector="Button.le-panel-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.le-panel-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Button.le-panel-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>

        <!-- 详情页红心:仿原版 PlaybackDetailViewLikeToggleButtonStyle —— 实心爱心白→红(#E74C3C),悬停浅底 -->
        <Style Selector="ToggleButton.le-like">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="25" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.le-like:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.le-like:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.le-like TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.le-like:checked TextBlock">
            <Setter Property="Foreground" Value="#FFE74C3C" />
        </Style>

        <!-- 播放列表行:60px,悬停 SystemBaseHigh 10%(原版 QueueTrackItem PointerOver)。
             用 ItemsControl(无选中概念,对齐原版 SelectionMode=None),容器即 ContentPresenter,无需压主题态 -->
        <Style Selector="Grid.queue-row Border.queue-row-hover">
            <Setter Property="Background" Value="#19FFFFFF" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.queue-row:pointerover Border.queue-row-hover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.queue-remove">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.queue-remove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#FF000000">
        <Image Source="{Binding Player.Cover}" Stretch="UniformToFill" Opacity="0.9">
            <Image.Effect><BlurEffect Radius="100" /></Image.Effect>
        </Image>
        <Rectangle Fill="#CC000000" />

        <!-- 顶部拖拽条:播放详情页盖住标题栏时,按住顶部空白区可拖动窗口。
             压在画布之下:Canvas 无背景不命中,顶部空白处仍穿透到这里拖拽;画布上的按钮自行命中 -->
        <Grid Height="48" VerticalAlignment="Top" Background="Transparent"
              PointerPressed="OnTitleDragPressed" />

        <!-- 播放详情页主画布(仿原版 RootCanvas):所有控件绝对定位,坐标由代码后置
             UpdateDesktopLayout() 按 尺寸档(小/中/大)×面板状态 计算;
             每个子元素通过 Composition Animation 动画 Translation,0.3s 平滑漂移到新位置。 -->
        <Canvas x:Name="DesktopCanvas" ClipToBounds="True">
            <!-- 封面:大屏/小屏无面板为大图居中;中屏无面板为居中中图;开面板缩为 60px 左上角迷你头 -->
            <Border x:Name="Artwork" CornerRadius="16" ClipToBounds="True" Background="#22FFFFFF"
                    BoxShadow="0 10 50 #4D000000">
                <Image Source="{Binding Player.Cover, Converter={x:Static infra:CoverImageConverter.Instance}}" Stretch="UniformToFill" />
            </Border>

            <!-- 歌名/歌手:大/小屏无面板在封面下方左对齐;中屏无面板在窗口正上方(居中);
                 开面板在迷你封面右侧 -->
            <StackPanel x:Name="InfoPanel" Spacing="4">
                <TextBlock x:Name="TitleText" Text="{Binding Player.Title}" FontSize="20" FontWeight="Bold" LetterSpacing="-0.2"
                           TextTrimming="CharacterEllipsis" Foreground="White" />
                <TextBlock x:Name="ArtistText" Text="{Binding Player.Artist}" FontSize="16" TextTrimming="CharacterEllipsis" Foreground="#BFFFFFFF" />
            </StackPanel>

            <!-- 收起按钮:通常顶部居中;中屏无面板时信息区占据正上方,故挪到左上(原版行为)。
                 Escape 快捷键是原版 KeyboardAccelerator 的移植(HotKey 注册为窗口级 KeyBinding,详情页关闭时随 IsVisible 失效)。 -->
            <Button x:Name="CollapseButton" Classes="player-button top-action" Command="{Binding CloseNowPlayingCommand}"
                    HotKeyManager.HotKey="Escape"
                    Width="50" Height="50" ToolTip.Tip="收起">
                <TextBlock Text="{DynamicResource IconChevronDown}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" Foreground="White" />
            </Button>

            <!-- 进度条 + 两侧时间 -->
            <Grid x:Name="ProgressArea" RowDefinitions="30,Auto">
                <Slider Classes="player-progress" Minimum="0" Maximum="{Binding Player.ProgressMaximum}"
                        Value="{Binding Player.PositionMs}" Height="30" IsEnabled="{Binding Player.HasProgress}"
                        PointerPressed="OnTimelinePointerPressed" PointerReleased="OnTimelinePointerReleased" />
                <Grid Grid.Row="1" ColumnDefinitions="*,*">
                    <TextBlock Text="{Binding Player.PositionText}" FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                    <TextBlock Grid.Column="1" Text="{Binding Player.DurationText}" HorizontalAlignment="Right"
                               FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                </Grid>
            </Grid>

            <!-- 核心控制:上一曲/播放暂停/下一曲(各自独立定位,小屏无面板时隐藏上一曲) -->
            <Button x:Name="PrevButton" Classes="player-button" Command="{Binding Player.PlayPreviousCommand}"
                    Width="50" Height="50" ToolTip.Tip="上一曲">
                <TextBlock Text="{DynamicResource IconPrevious}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="20" Foreground="White" />
            </Button>
            <Button x:Name="PlayButton" Classes="player-button" Command="{Binding Player.TogglePlayPauseCommand}" Width="60" Height="60">
                <Grid>
                    <TextBlock Text="{DynamicResource IconPause}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" Foreground="White"
                               IsVisible="{Binding Player.ShowPauseIcon}" />
                    <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" Foreground="White"
                               IsVisible="{Binding Player.ShowPlayIcon}" />
                    <TextBlock Text="•••" FontSize="14" LetterSpacing="2" Foreground="White"
                               IsVisible="{Binding Player.ShowLoadingIcon}" />
                </Grid>
            </Button>
            <Button x:Name="NextButton" Classes="player-button" Command="{Binding Player.PlayNextCommand}"
                    Width="50" Height="50" ToolTip.Tip="下一曲">
                <TextBlock Text="{DynamicResource IconNext}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="20" Foreground="White" />
            </Button>

            <!-- 红心:大屏/中屏在次级行居中;小屏无面板占据控制行左槽位;开面板隐藏 -->
            <ToggleButton x:Name="LikeButton" Classes="le-like" Width="50" Height="50"
                          IsChecked="{Binding Player.IsCurrentLiked, Mode=OneWay}"
                          Command="{Binding Player.ToggleLikeCommand}" ToolTip.Tip="红心">
                <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" />
            </ToggleButton>

            <!-- 播放模式:大屏/中屏在次级行左,弹出单选菜单;小屏隐藏 -->
            <Button x:Name="ModeButton" Classes="player-button" Width="50" Height="50"
                    ToolTip.Tip="{Binding Player.PlaybackModeName}">
                <TextBlock Text="{Binding Player.PlaybackModeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                <Button.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuItem Header="列表循环" ToggleType="Radio" IsChecked="{Binding Player.IsListLoopMode}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="单曲循环" ToggleType="Radio" IsChecked="{Binding Player.IsSingleLoopMode}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8ED;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="随机播放" ToggleType="Radio" IsChecked="{Binding Player.IsShuffleMode}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- 音量:大屏/中屏在次级行右;小屏无面板在底部行右;开面板隐藏 -->
            <Button x:Name="VolumeButton" Classes="player-button" Width="50" Height="50" ToolTip.Tip="音量">
                <TextBlock Text="{DynamicResource IconVolume}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="20" Foreground="White" />
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <StackPanel Spacing="10" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{DynamicResource IconVolume}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Player.Volume}" Width="28" FontSize="16" VerticalAlignment="Center" />
                            </StackPanel>
                            <Slider Value="{Binding Player.Volume}" Minimum="0" Maximum="100" Width="200" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- 底部切换:歌词(左) / 全屏(中) / 播放列表(右,小屏无面板时让位给音量) -->
            <ToggleButton x:Name="LyricsToggle" Classes="le-toggle" Width="48" Height="32"
                          IsChecked="{Binding ShowLyricsPanel, Mode=OneWay}"
                          Command="{Binding ToggleLyricsPanelCommand}" ToolTip.Tip="歌词">
                <TextBlock Text="{DynamicResource IconLyrics}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="FullScreenToggle" Classes="le-toggle" Width="48" Height="32"
                          Click="OnFullScreenClick" ToolTip.Tip="全屏">
                <TextBlock x:Name="FullScreenGlyph" Text="{DynamicResource IconEnterFullScreen}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="QueueToggle" Classes="le-toggle" Width="48" Height="32"
                          IsChecked="{Binding ShowQueuePanel, Mode=OneWay}"
                          Command="{Binding ToggleQueuePanelCommand}" ToolTip.Tip="播放列表">
                <TextBlock Text="{DynamicResource IconPlaylist}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16" />
            </ToggleButton>

            <!-- 歌词面板:大号歌词(距离渐变 + 上下淡出);右下翻译开关 + 字号菜单 -->
            <Grid x:Name="LyricsPanel" IsVisible="{Binding ShowLyricsPanel}">
                <views:LyricView Classes="detail" DataContext="{Binding Lyric}"
                                 FontScale="{Binding LyricFontScale}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Spacing="10" Margin="0,0,10,10">
                    <ToggleButton Classes="le-toggle" Width="40" Height="40"
                                  IsChecked="{Binding Lyric.ShowTranslation}" ToolTip.Tip="翻译">
                        <TextBlock Text="{DynamicResource IconTranslation}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="20" />
                    </ToggleButton>
                    <Button Classes="le-panel-button" Width="40" Height="40" ToolTip.Tip="歌词字号">
                        <TextBlock Text="{DynamicResource IconFontSize}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="20" />
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Spacing="10" Margin="4">
                                    <TextBlock Text="歌词字号" FontWeight="SemiBold" />
                                    <ComboBox Width="200" SelectedIndex="{Binding Lyric.FontScaleIndex}">
                                        <ComboBoxItem>自动</ComboBoxItem>
                                        <ComboBoxItem>60%</ComboBoxItem>
                                        <ComboBoxItem>80%</ComboBoxItem>
                                        <ComboBoxItem>100%</ComboBoxItem>
                                        <ComboBoxItem>120%</ComboBoxItem>
                                        <ComboBoxItem>150%</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 播放列表面板:头部(接下来播放 + 播放来源) + 圆角边框列表(仿原版 PlaybackQueueListView) -->
            <Grid x:Name="QueuePanel" IsVisible="{Binding ShowQueuePanel}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,21,0,14">
                        <TextBlock Text="接下来播放" FontSize="24" FontWeight="Bold" Foreground="White" />
                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding Player.HasQueueSource}">
                            <TextBlock Text="播放来源" FontSize="16" VerticalAlignment="Center" Foreground="#BFFFFFFF" />
                            <TextBlock Text="{Binding Player.QueueSourceName}" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource LyricEaseTeal}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True">
                        <ItemsControl x:Name="QueueList" ItemsSource="{Binding Player.UpcomingItems}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ContainerPrepared="OnQueueContainerPrepared">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:QueueItemViewModel">
                                    <Grid Classes="queue-row" ColumnDefinitions="60,*,60" Height="60"
                                          Background="Transparent" Tapped="OnQueueItemTapped">
                                        <Border Classes="queue-row-hover" />
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4" ClipToBounds="True"
                                                Background="#3A3A3A" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding Cover, Converter={x:Static infra:CoverImageConverter.Instance}}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="5,0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArtistAlbumText}" FontSize="12" Foreground="#73FFFFFF" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="queue-remove" Width="40" Height="40"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Command="{Binding RemoveCommand}" ToolTip.Tip="从播放列表移除">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#73FFFFFF" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Grid>
        </Canvas>

        <Button Classes="player-button top-action" Width="50" Height="50" Margin="0,16,20,0"
                HorizontalAlignment="Right" VerticalAlignment="Top" IsEnabled="False"
                ToolTip.Tip="更多操作将在后续阶段接入" ZIndex="2">
            <TextBlock Text="{DynamicResource IconMore}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="28" Foreground="White" />
        </Button>
    </Grid>
</UserControl>
