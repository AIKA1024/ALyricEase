<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:PlaceholderViewModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ALyricEase.Views.PlaceholderView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding Description}" FontSize="14"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
        <!-- 临时调试按钮:删除本地 Cookie 回到未登录状态(仅账号页显示)。 -->
        <Button Classes="primary" Content="删除本地 Cookie 并退出登录" Command="{Binding LogoutCommand}"
                Height="36" Padding="20,0" Margin="0,16,0,0" HorizontalAlignment="Center"
                IsVisible="{Binding ShowLogout}" />
    </StackPanel>
</UserControl>
