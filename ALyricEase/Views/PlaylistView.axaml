<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:PlaylistViewModel"
             mc:Ignorable="d" d:DesignWidth="930" d:DesignHeight="600"
             x:Class="ALyricEase.Views.PlaylistView">
  <UserControl.Styles>
    <Style Selector="Border.login-card">
      <Setter Property="MaxWidth" Value="600" /><Setter Property="MinWidth" Value="400" />
    </Style>
    <Style Selector="UserControl.narrow Border.login-card">
      <Setter Property="MinWidth" Value="0" /><Setter Property="Width" Value="320" />
    </Style>
    <Style Selector="Grid.detail-shell">
      <Setter Property="Margin" Value="10,16,16,110" />
    </Style>
    <Style Selector="Border.playlist-hero">
      <Setter Property="Height" Value="300" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
      <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="UserControl.compact Border.playlist-hero">
      <Setter Property="Height" Value="300" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0,20" />
    </Style>
    <Style Selector="UserControl.compact Border.hero-art">
      <Setter Property="Width" Value="300" /><Setter Property="Height" Value="300" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="UserControl.compact StackPanel.hero-copy">
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,18,0,0" />
    </Style>
    <Style Selector="UserControl.compact TextBlock.hero-title">
      <Setter Property="TextAlignment" Value="Center" /><Setter Property="FontSize" Value="28" />
    </Style>
    <Style Selector="UserControl.compact Button.hero-creator">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="UserControl.compact StackPanel.hero-actions">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="UserControl.narrow Grid.detail-shell">
      <Setter Property="Margin" Value="0,0,0,110" />
    </Style>
    <Style Selector="UserControl.narrow Border.playlist-hero">
      <Setter Property="Padding" Value="0,14" />
    </Style>
    <Style Selector="UserControl.narrow Border.hero-art">
      <Setter Property="Width" Value="300" /><Setter Property="Height" Value="300" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- 曲目列表:ItemsControl 无选中逻辑(不可选中);悬停高亮交给行内样式(共享 TrackRow),容器只留行间距 -->
    <Style Selector="ItemsControl.tracks">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ItemsControl.tracks > ContentPresenter">
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <!-- 滚动条底部留白:离底部 100(播放条高度),仿 UWP ScrollViewer 模板内 ScrollBar Margin -->
    <Style Selector="ScrollViewer.tracks-scroller ScrollBar">
      <Setter Property="Margin" Value="0,0,0,100" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <ScrollViewer x:Name="PageScroller" Classes="tracks-scroller" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Classes="detail-shell" RowDefinitions="Auto,*" IsVisible="{Binding IsLoggedIn}">
        <Border Classes="playlist-hero" Grid.Row="0">
          <Grid Classes="hero-layout" ColumnDefinitions="260,*">
            <Border Classes="hero-art" Grid.Column="0" Width="260" Height="260" CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource ArtFallback}" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Image Source="{Binding SelectedPlaylist.LargeCover}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Classes="hero-copy" Grid.Column="1" Margin="20,0,10,0" VerticalAlignment="Center" Spacing="8">
              <TextBlock Classes="hero-title" Text="{Binding SelectedPlaylist.Name}" FontSize="28" FontWeight="Bold"
                         TextTrimming="CharacterEllipsis" MaxLines="2" />
              <Button Classes="hero-creator" Content="{Binding UserName}" HorizontalAlignment="Left"
                      Background="Transparent" BorderThickness="0" Padding="0"
                      Foreground="{DynamicResource LyricEaseTeal}" FontSize="18" ToolTip.Tip="打开用户页（后续接入）" />
              <TextBlock Text="{Binding SelectedPlaylist.TrackCountText}" FontSize="16"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Text="{Binding SelectedPlaylist.Description}" FontSize="14"
                         Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxLines="3"
                         IsVisible="{Binding SelectedPlaylist.HasDescription}" />
              <StackPanel Classes="hero-actions" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Classes="primary" Content="▶ 播放全部" Command="{Binding PlayAllCommand}" Height="40"
                        Padding="18,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Button Background="{DynamicResource LyricEaseRed}" Foreground="White" BorderThickness="0"
                        CornerRadius="4" Height="40" Padding="14,0" IsEnabled="False" ToolTip.Tip="心动模式将在播放队列阶段接入"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="♥" FontSize="17" /><TextBlock Text="心动模式" />
                  </StackPanel>
                </Button>
                <Button Width="40" Height="40" Padding="0" Background="{DynamicResource AppSurface}"
                        BorderThickness="1" BorderBrush="{DynamicResource AppBorder}" CornerRadius="4"
                        IsEnabled="False" ToolTip.Tip="更多操作将在后续阶段接入"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                  <TextBlock Text="•••" LetterSpacing="2" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <!-- 卡片本体(列表在其中) -->
          <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource ListCardBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="8,6">
            <!-- 外层 ScrollViewer(仿 UWP ListView 模板)直接包裹 ItemsControl + VirtualizingStackPanel -->

            <!-- 底部留白由 detail-shell 的底部 margin 提供(仿 UWP ScrollViewer 内容末尾留白) -->
            <ItemsControl x:Name="TracksList" Classes="tracks" ItemsSource="{Binding Tracks}"
                          ContainerPrepared="OnTrackContainerPreparing">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SongItemViewModel">
                  <views:TrackRow />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <!-- 卡片顶部内阴影:覆盖卡片内侧顶边(圆角贴合,Margin 1px 避开边框),不拦截点击 -->
          <Border IsHitTestVisible="False" Height="12" VerticalAlignment="Top" CornerRadius="8,8,0,0"
                  Margin="1,1,1,0" ZIndex="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#2E000000" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <!-- 卡片底部内阴影:与顶部对称,覆盖卡片内侧底边 -->
          <Border IsHitTestVisible="False" Height="12" VerticalAlignment="Bottom" CornerRadius="0,0,8,8"
                  Margin="1,0,1,1" ZIndex="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#2E000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>
        <TextBlock Text="请选择左侧歌单查看曲目" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Grid.Row="0" Grid.RowSpan="2"
                   IsVisible="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNull}}"
                   Foreground="{DynamicResource TextTertiary}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>