<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="ALyricEase.MainView">
    <Grid RowDefinitions="48,*">
        <!-- Android 顶部横幅:左侧固定汉堡按钮,右侧 20 间距 + 当前页面名称 -->
        <Border Grid.Row="0" Background="{DynamicResource AppBackground}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="48,20,*" Margin="4,0,12,0">
                <Button Grid.Column="0" Classes="navigation-button" Width="40" Height="40"
                        Command="{Binding ToggleNavigationDrawerCommand}" ToolTip.Tip="展开侧边栏"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="☰" FontSize="18" />
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding CurrentPageTitle}" FontSize="18"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <views:AppShell Grid.Row="1" />

        <!-- 正在播放覆盖层:内容区 Grid 常驻,靠 RenderTransform 在"原位/屏幕外"间滑入滑出。
             RenderTransform 目标值由 NowPlayingOverlayController 按 MainViewModel.ShowNowPlaying 切换。
             Android 顶部横幅是应用内容不是窗口标题栏 → 覆盖层只挂第 1 行,不往上盖。 -->
        <Grid x:Name="NowPlayingOverlay" Grid.Row="1" ZIndex="100"
              IsHitTestVisible="{Binding ShowNowPlaying}" ClipToBounds="True">
            <Grid.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4"
                                                   Easing="0.215,0.61,0.355,1" />
                </Transitions>
            </Grid.Transitions>
            <views:NowPlayingView DataContext="{Binding}" />
        </Grid>

        <!-- 登录对话框(共享 LoginDialogView):ZIndex 200 高于正在播放覆盖层(100),
             播放详情页里点红心也能弹登录。 -->
        <views:LoginDialogView IsVisible="{Binding IsLoginDialogOpen}"
                               Grid.Row="1" ZIndex="200" />

        <!-- 添加聚合歌单对话框(与登录弹层同层,声明在其后 → 同时可见时盖在其上) -->
        <views:AddAggregateDialogView IsVisible="{Binding IsAggregateDialogOpen}"
                                      Grid.Row="1" ZIndex="200" />

        <!-- 聚合歌单设置对话框(齿轮;同层最末 → 同时可见时盖在最上) -->
        <views:AggregateSettingsDialogView IsVisible="{Binding IsAggregateSettingsDialogOpen}"
                                           Grid.Row="1" ZIndex="200" />

        <!-- 重命名歌单对话框(侧栏歌单子项右键/长按;同层,声明在聚合设置弹层之后) -->
        <views:RenamePlaylistDialogView IsVisible="{Binding IsRenamePlaylistDialogOpen}"
                                        Grid.Row="1" ZIndex="200" />

        <!-- 删除歌单确认对话框(侧栏歌单子项右键/长按;同层,声明在重命名弹层之后) -->
        <views:DeletePlaylistDialogView IsVisible="{Binding IsDeletePlaylistDialogOpen}"
                                        Grid.Row="1" ZIndex="200" />
    </Grid>
</UserControl>
