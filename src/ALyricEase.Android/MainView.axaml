<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="ALyricEase.MainView">
    <Grid RowDefinitions="48,*">
        <!-- Android 顶部横幅:左侧固定汉堡按钮,右侧 20 间距 + 当前页面名称 -->
        <Border Grid.Row="0" Background="{DynamicResource AppBackground}" IsEnabled="{Binding !IsErrorDialogOpen}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="48,20,*" Margin="4,0,12,0">
                <Button Grid.Column="0" Classes="navigation-button" Width="40" Height="40"
                        Command="{Binding ToggleNavigationDrawerCommand}" ToolTip.Tip="展开侧边栏"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="☰" FontSize="18" />
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding CurrentPageTitle}" FontSize="18"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <views:AppShell Grid.Row="1" IsEnabled="{Binding !IsErrorDialogOpen}" />

        <!-- 正在播放覆盖层:内容区 Grid 常驻,靠 RenderTransform 在"原位/屏幕外"间滑入滑出。
             RenderTransform 目标值由 NowPlayingOverlayController 按 MainViewModel.ShowNowPlaying 切换。
             横跨两行(与桌面端一致)→ 打开时连顶部横幅一起盖住,整页沉浸式。
             顶部横幅是应用内容不是系统栏,盖掉不影响状态栏:Avalonia 的 AndroidInsetsManager
             默认按系统栏 insets 给整个视图加 padding,所以本 Grid 的 y=0 本来就在状态栏下方。
             关闭态位移取覆盖层 Bounds.Height,横跨两行后自动 +48,无需改 Controller。 -->
        <Grid x:Name="NowPlayingOverlay" Grid.Row="0" Grid.RowSpan="2" ZIndex="100"
              IsHitTestVisible="{Binding ShowNowPlaying}" ClipToBounds="True">
            <Grid.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45"
                                                   Easing="0.45,0.08,0.7,0.85" />
                </Transitions>
            </Grid.Transitions>
            <views:NowPlayingView DataContext="{Binding}" />
        </Grid>

        <!-- 登录对话框(共享 LoginDialogView):ZIndex 200 高于正在播放覆盖层(100),
             播放详情页里点红心也能弹登录。 -->
        <views:LoginDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsLoginDialogOpen}"
                               Grid.Row="1" ZIndex="200" />

        <!-- 添加聚合歌单对话框(与登录弹层同层,声明在其后 → 同时可见时盖在其上) -->
        <views:AddAggregateDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsAggregateDialogOpen}"
                                      Grid.Row="1" ZIndex="200" />

        <!-- 聚合歌单设置对话框(齿轮;同层最末 → 同时可见时盖在最上) -->
        <views:AggregateSettingsDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsAggregateSettingsDialogOpen}"
                                           Grid.Row="1" ZIndex="200" />

        <!-- 本地音乐歌单设置对话框(齿轮;布局同聚合设置) -->
        <views:LocalPlaylistSettingsDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsLocalPlaylistSettingsDialogOpen}"
                                               Grid.Row="1" ZIndex="200" />

        <!-- 重命名歌单对话框(侧栏歌单子项右键/长按;同层,声明在聚合设置弹层之后) -->
        <views:RenamePlaylistDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsRenamePlaylistDialogOpen}"
                                        Grid.Row="1" ZIndex="200" />

        <!-- 删除歌单确认对话框(侧栏歌单子项右键/长按;同层,声明在重命名弹层之后) -->
        <views:DeletePlaylistDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsDeletePlaylistDialogOpen}"
                                        Grid.Row="1" ZIndex="200" />

        <!-- 播放条长按菜单中的“添加到歌单”。 -->
        <views:AddSongToPlaylistDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsAddSongToPlaylistDialogOpen}"
                                           Grid.Row="1" ZIndex="200" />

        <!-- 音频输出设备选择弹窗(设置页;同层最末 → 同时可见时盖在最上) -->
        <views:AudioDeviceDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsAudioDeviceDialogOpen}"
                                     Grid.Row="1" ZIndex="200" />

        <!-- 清除缓存确认弹窗(设置页;声明在设备弹层之后 → 同时可见时盖在最上) -->
        <views:ClearCacheDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsClearCacheDialogOpen}"
                                    Grid.Row="1" ZIndex="200" />

        <!-- 应用更新弹窗(设置页;同层最末 → 同时可见时盖在最上;安卓=下载 APK 后调系统安装器) -->
        <views:UpdateDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsUpdateDialogOpen}"
                                Grid.Row="1" ZIndex="200" />

        <!-- 综合搜索合并歌曲的红心平台选择；移动端长按红心也进入此模态层。 -->
        <views:LikeSourceDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsLikeSourceDialogOpen}"
                                    Grid.Row="1" ZIndex="200" />
        <views:ErrorDialogView IsVisible="False" infra:ModalVisibilityTransition.IsOpen="{Binding IsErrorDialogOpen}"
                               Grid.Row="0" Grid.RowSpan="2" ZIndex="210" />
    </Grid>
</UserControl>
