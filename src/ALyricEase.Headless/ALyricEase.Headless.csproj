<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>ALyricEase.Headless</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><!-- TEMP-DIAG:真窗口探针 BGRA 落盘 -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <!-- WebView 探针:NativeControlHost 需要 supportedOS 声明,否则子窗口创建失败 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- 直接验证桌面端的生命周期控制器，避免测试替身复制关闭逻辑。 -->
    <Compile Include="..\ALyricEase.Windows\Services\DesktopLifecycleController.cs" Link="DesktopLifecycleController.cs" />
    <!-- 同上：歌词窗口的显示/收起逻辑只此一份，探针直接编真实控制器。 -->
    <Compile Include="..\ALyricEase.Windows\Services\DesktopLyricController.cs" Link="DesktopLyricController.cs" />
    <ProjectReference Include="..\ALyricEase\ALyricEase.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" /><!-- TEMP-DIAG:真实渲染截图 -->
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" /><!-- TEMP-DIAG:真窗口探针 UsePlatformDetect -->
  </ItemGroup>
</Project>
