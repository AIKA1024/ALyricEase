<Application xmlns="https://github.com/avaloniaui"
             xmlns:fluent2="using:Avalonia.Themes.Fluent2"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:Class="ALyricEase.Headless.HeadlessApp"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <DataTemplate DataType="vm:RecommendViewModel">
            <views:RecommendView />
        </DataTemplate>
        <DataTemplate DataType="vm:SearchViewModel">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaylistViewModel">
            <views:PlaylistView />
        </DataTemplate>
        <DataTemplate DataType="vm:ArtistViewModel">
            <views:ArtistView />
        </DataTemplate>
        <DataTemplate DataType="vm:AlbumViewModel">
            <views:AlbumView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlayerViewModel">
            <views:PersonalFmView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderViewModel">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="vm:DebugViewModel">
            <views:DebugView />
        </DataTemplate>
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ALyricEase/Styles/Foundation/Colors.axaml" />
                <ResourceInclude Source="avares://ALyricEase/Styles/Foundation/Dimensions.axaml" />
                <ResourceInclude Source="avares://ALyricEase/Styles/Foundation/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
            <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
            <Thickness x:Key="FlyoutBorderThemePadding">4</Thickness>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
            <!-- Fluent 2 给 ToggleSwitch 模板留了 154px 的 MinWidth(WinUI 3 为 On/Off 文案预留),
                 本项目所有开关都是纯开关、右侧对齐,留着会把整列撑宽 154px ⇒ 压回 Fluent 1 的 0 -->
            <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <fluent2:Fluent2Theme />
        <StyleInclude Source="avares://ALyricEase/Styles/Controls/FluentComboBox.axaml" />
        <StyleInclude Source="avares://ALyricEase/Styles/Foundation/Typography.axaml" />
        <StyleInclude Source="avares://ALyricEase/Styles/Controls/Buttons.axaml" />
        <StyleInclude Source="avares://ALyricEase/Styles/Controls/Sliders.axaml" />
        <StyleInclude Source="avares://ALyricEase/Styles/Controls/Common.axaml" />
        <StyleInclude Source="avares://ALyricEase/Views/TrackRow.axaml" />
    </Application.Styles>
</Application>
