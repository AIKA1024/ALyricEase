<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ALyricEase.Views"
        xmlns:vm="using:ALyricEase.ViewModels"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="ALyricEase.Headless.TestMainWindow"
        Title="ALyricEase" Width="1200" Height="720" MinWidth="360" MinHeight="560"
        Icon="avares://ALyricEase/Assets/app.ico" Background="Transparent" TransparencyLevelHint="AcrylicBlur"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="48">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:RecommendViewModel">
      <views:RecommendView />
    </DataTemplate>
    <DataTemplate DataType="vm:SearchViewModel">
      <views:SearchView />
    </DataTemplate>
    <DataTemplate DataType="vm:PlaylistViewModel">
      <views:PlaylistView />
    </DataTemplate>
    <DataTemplate DataType="vm:ArtistViewModel">
      <views:ArtistView />
    </DataTemplate>
    <DataTemplate DataType="vm:AlbumViewModel">
      <views:AlbumView />
    </DataTemplate>
    <!-- 私人FM:页面直接绑定播放器 VM(FM 无限流在播放器内) -->
    <DataTemplate DataType="vm:PlayerViewModel">
      <views:PersonalFmView />
    </DataTemplate>
    <DataTemplate DataType="vm:PlaceholderViewModel">
      <views:PlaceholderView />
    </DataTemplate>
    <DataTemplate DataType="vm:DebugViewModel">
      <views:DebugView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Button.navigation-button">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Button.navigation-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.navigation-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
    </Style>
    <Style Selector="Button.navigation-button:disabled">
      <Setter Property="Opacity" Value="1" /><Setter Property="Background" Value="Transparent" />
      <!-- 禁用时图标变灰弱化(和 UWP 一致),背景保持透明 -->
      <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>
    <!-- 主题的 Button:disabled /template/ ContentPresenter#PART_ContentPresenter 会给禁用态设 20% 白背景,
         覆盖为透明(带 :disabled + /template/ 提高优先级,否则被主题样式盖掉) -->
    <Style Selector="Button.navigation-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.shell-navigation > ListBoxItem">
      <Setter Property="MinHeight" Value="40" /><Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="12,0" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <!-- 暂时关闭 IsHoldWithMouseEnabled:它会导致特定导航顺序下歌单子项选中样式不刷新 -->
      <Setter Property="InputElement.IsHoldWithMouseEnabled" Value="False" />
    </Style>
    <Style
      Selector="ListBox.shell-navigation > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="ListBox.shell-navigation > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavigationSelected}" />
    </Style>
    <Style Selector="ListBox.shell-navigation > ListBoxItem:disabled">
      <Setter Property="Opacity" Value="1" /><Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.nav-header">
      <Setter Property="FontWeight" Value="Bold" /><Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.close-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- 返回按钮(仿 UWP NavigationView 默认返回按钮):40x40 方钮,返回箭头 E72B 居中;
         hover/pressed/disabled 必须经 /template/ ContentPresenter 才生效(Fluent 模板的 VisualState 直接改 ContentPresenter 背景) -->
    <Style Selector="Button.back-button">
      <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />

      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.back-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.back-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
    </Style>
    <Style Selector="Button.back-button:disabled">
      <Setter Property="Opacity" Value="1" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>
    <!-- 主题的 Button:disabled 会给 ContentPresenter 设 20% 白背景/禁用前景,覆盖为透明 + 灰字 -->
    <Style Selector="Button.back-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>

    <!-- Tooltip 圆角收小:OverlayCornerRadius 全局 12 波及了 Tooltip,单独压回 4 -->
    <Style Selector="ToolTip">
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- ContentDialog 主按钮(WinUI3 AccentButton 样式):强调色底白字,悬停/按下用系统强调色变体 -->
    <Style Selector="Button.dialog-primary">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.dialog-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
    </Style>
    <Style Selector="Button.dialog-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
    </Style>
  </Window.Styles>

  <ExperimentalAcrylicBorder Material="{DynamicResource AppAcrylicMaterial}">
    <Grid RowDefinitions="48,*">
      <!-- 原版风格自绘标题栏：左侧拖拽区，右侧窗口控制。 -->
      <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" PointerPressed="OnTitleBarPointerPressed"
            ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" VerticalAlignment="Center">
          <Button Classes="back-button" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"
                  ToolTip.Tip="返回上一页">
            <TextBlock x:Name="BackGlyph" Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
          </Button>
          <!-- 小屏汉堡按钮(仿原版 NavigationView Minimal):窄窗无侧栏,汉堡移入标题栏、在返回键右侧,点开抽屉。
               IsVisible 由代码后置按宽度控制(ResponsiveClasses 的 narrow)。 -->
          <Button x:Name="TitleBarHamburger" Classes="back-button" IsVisible="False"
                  Command="{Binding ToggleNavigationDrawerCommand}" ToolTip.Tip="展开侧边栏">
            <TextBlock x:Name="TitleBarHamburgerGlyph" Text="☰" FontSize="16" />
          </Button>
          <Image Source="avares://ALyricEase/Assets/icon_24.png" Width="24" Height="24" />
          <TextBlock Text="ALyricEase" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimary}" />
        </StackPanel>
        <StackPanel Grid.Column="2" x:Name="WindowControls" Orientation="Horizontal">
          <Button Classes="window-control" Click="OnMinimizeClick" ToolTip.Tip="最小化"
                  HorizontalContentAlignment="Center">
            <TextBlock x:Name="MinGlyph" Text="&#xE921;" FontSize="16" VerticalAlignment="Center"
                       Margin="0 4 0 0" />
          </Button>
          <Button Classes="window-control" Click="OnMaximizeClick" ToolTip.Tip="最大化"
                  HorizontalContentAlignment="Center">
            <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                       VerticalAlignment="Center" />
          </Button>
          <Button Classes="window-control close-control" Click="OnCloseClick" ToolTip.Tip="关闭"
                  HorizontalContentAlignment="Center">
            <TextBlock x:Name="CloseGlyph" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>

      <views:AppShell Grid.Row="1" DataContext="{Binding}" />

      <!-- 正在播放覆盖层:整窗 Grid 常驻,靠 RenderTransform 在"原位/屏幕外"间滑入滑出。
           RenderTransform 目标值由 NowPlayingOverlayController 按 MainViewModel.ShowNowPlaying 切换,
           过渡(时长/缓动)在这里声明。直接挂在窗口网格并横跨两行 → 渲染盖住标题栏(原版行为);
           不能放进 AppShell(会被宿主裁剪在其边界内)。不用 TransitioningContentControl
           (空→有内容会先露末帧再启动动画;关闭时 IsVisible 直接隐藏会杀掉退出动画)。 -->
      <Grid x:Name="NowPlayingOverlay" Grid.Row="0" Grid.RowSpan="2" ZIndex="100"
            IsHitTestVisible="{Binding ShowNowPlaying}" ClipToBounds="True">
        <Grid.Transitions>
          <Transitions>
            <!-- 时长/缓动对齐原版 LyricEase:实际手感 0.4s 缓出;曲线取 Toolkit 默认缓出 cubic-bezier(0.215,0.61,0.355,1)。 -->
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="0.215,0.61,0.355,1" />
          </Transitions>
        </Grid.Transitions>
        <views:NowPlayingView DataContext="{Binding}" />
      </Grid>

      <!-- 登录对话框(共享 LoginDialogView):ZIndex 200 高于正在播放覆盖层(100),
           播放详情页里点红心也能弹登录。 -->
      <views:LoginDialogView IsVisible="{Binding IsLoginDialogOpen}"
                             Grid.Row="0" Grid.RowSpan="2" ZIndex="200" />
    </Grid>
  </ExperimentalAcrylicBorder>
</Window>