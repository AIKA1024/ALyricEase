<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ALyricEase.Headless.VGridWindow"
        x:CompileBindings="False"
        Width="1000" Height="480" Background="White">
  <!-- 与 SongGridView 目标结构同构:外部 ScrollViewer + 横向 VirtualizingStackPanel 按列虚拟化,
       每列为纵向 6 行(行 400x60 + Margin 2) -->
  <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="Columns">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ItemsControl Classes="col" ItemsSource="{Binding}" ContainerPrepared="OnRowPrepared">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="400" Height="60" Margin="2" Background="Gray" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</Window>
