<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- 探针进程也要声明 supportedOS:否则 Avalonia 的 NativeControlHost 创建子窗口时会抛
       "Application manifest with supported OS list might be required"(WebView 探针需要)。 -->
  <assemblyIdentity version="1.0.0.0" name="ALyricEase.Headless"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
