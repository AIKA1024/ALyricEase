<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ALyricEase</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 核心库承载绝大部分代码,不开分析器就扫不到这里的反射/AOT 风险 -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- 官方原生 WebView(Windows=WebView2, Android=系统 WebView),用于 QQ 登录安全验证窗口 -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="AsyncImageLoader.Avalonia" Version="4.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 官方客户端代理登录:Go MITM 代理(仅 win-x64/win-arm64 native),入口按平台守卫 -->
    <PackageReference Include="ProjectCirrus.Copycat" Version="0.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <!-- 网易云扫码登录:纯托管二维码编码(无 System.Drawing 依赖,Android/AOT 可用) -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
  </ItemGroup>
</Project>
