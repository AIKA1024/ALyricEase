<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:controls="using:ALyricEase.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:CompileBindings="True"
             x:Class="ALyricEase.Controls.AlbumGrid">
  <UserControl.DataTemplates>
    <!-- 专辑卡片:200 宽,封面黑遮罩悬停,点击跳专辑页(歌手页横滑卡片同款视觉,含发布信息行) -->
    <DataTemplate x:DataType="vm:AlbumCardViewModel">
      <Button Theme="{StaticResource RowButtonTheme}" Classes="album-card" Command="{Binding OpenCommand}">
        <!-- 三行(封面/标题/发布信息)而非"标题用 Margin 下移":Grid 内 Stretch + 固定 Height 的封面会被垂直居中
             (实测 225 高的卡片里封面落在 y=12),标题就压到封面底部去了。分行后封面顶对齐,
             标题与封面的间隔由 StackPanel 式的 Margin 决定(6,与个性推荐卡片一致)。 -->
        <Grid Width="200" RowDefinitions="200,Auto,Auto">
          <Border Grid.Row="0" Width="200" Height="200" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ArtFallback}">
            <Grid>
              <Image infra:ManagedCoverImage.DecodeSize="300"
                     infra:ManagedCoverImage.Source="{Binding CoverUrl}"
                     Stretch="UniformToFill" />
              <Border Classes="album-card-mask" CornerRadius="8" Background="#FF000000" IsHitTestVisible="False" />
            </Grid>
          </Border>
          <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     MaxLines="1" Margin="4,6,4,0" />
          <TextBlock Grid.Row="2" Text="{Binding InfoText}" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                     IsVisible="{Binding HasInfo}" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="4,3,4,0" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- 行内卡片间距:横向 StackPanel 无 Spacing,由容器右边距提供(歌手页同款做法) -->
    <Style Selector="ItemsControl.row > ContentPresenter">
      <Setter Property="Margin" Value="0,0,12,16" />
    </Style>
    <Style Selector="Button.album-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.album-card-mask">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.album-card:pointerover Border.album-card-mask">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
  </UserControl.Styles>

  <!-- 仿 SongGridView 的分块虚拟化:卡片按 ColumnsPerRow 切成行,纵向 VirtualizingStackPanel
       只实例化视口附近的行;列数随控件宽度自适应(窄窗 1 列,宽屏 6 列) -->
  <ItemsControl x:Name="Rows">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="controls:AlbumRow">
        <ItemsControl Classes="row" ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
