<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:controls="using:ALyricEase.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:CompileBindings="True"
             x:Class="ALyricEase.Controls.AlbumGrid">
  <UserControl.DataTemplates>
    <!-- 专辑卡片:200 宽,封面黑遮罩悬停,点击跳专辑页(歌手页横滑卡片同款视觉,含发布信息行) -->
    <DataTemplate x:DataType="vm:AlbumCardViewModel">
      <controls:AlbumCard />
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- 行内卡片间距:横向 StackPanel 无 Spacing,由容器右边距提供(歌手页同款做法) -->
    <Style Selector="ItemsControl.row > ContentPresenter">
      <Setter Property="Margin" Value="0,0,12,16" />
    </Style>
    <!-- 卡片外观(遮罩 / ▶ / •••)在 Controls/AlbumCard.axaml,这里不再重复 -->
  </UserControl.Styles>

  <!-- 仿 SongGridView 的分块虚拟化:卡片按 ColumnsPerRow 切成行,纵向 VirtualizingStackPanel
       只实例化视口附近的行;列数随控件宽度自适应(窄窗 1 列,宽屏 6 列) -->
  <ItemsControl x:Name="Rows">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="controls:AlbumRow">
        <ItemsControl Classes="row" ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
