<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ALyricEase.Controls"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="60"
             x:Class="ALyricEase.Controls.DesktopLyricText"
             x:Name="Root">
  <!-- 桌面歌词的一行文字,两层:
       1) TextOutlineLayer —— FormattedText → BuildGeometry → DrawGeometry(pen)。一份排版、一次描边,
          粗细均匀、斜角不变厚;早先的 8 份偏移副本已退役(原因见 TextOutlineLayer 的注释)。
       2) KaraokeText —— 正文。没有逐字时画单色(= 原来的 TextBlock);有逐字时画"暗底 + 已唱亮色",
          每帧只重画这一层,描边几何不重建。
       两层共用同一格、同一宽度、同一对齐与高度上限,行高与换行位置一致(见 text-geometry 探针)。 -->
  <Grid ClipToBounds="False">
    <controls:TextOutlineLayer x:Name="Outline"
                               Text="{Binding #Root.Text}"
                               Stroke="{Binding #Root.OutlineBrush}"
                               StrokeThickness="{Binding #Root.OutlineThickness}"
                               TextAlignment="Center" />
    <controls:KaraokeText x:Name="Body"
                          Text="{Binding #Root.Text}"
                          Words="{Binding #Root.Words}"
                          PositionMs="{Binding #Root.PositionMs}"
                          IsPlaying="{Binding #Root.IsPlaying}"
                          AccentBrush="{Binding #Root.TextBrush}"
                          DimBrush="{Binding #Root.DimTextBrush}"
                          TextAlignment="Center" />
  </Grid>
</UserControl>
