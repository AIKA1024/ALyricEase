<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="using:ALyricEase.Infrastructure.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:views="using:ALyricEase.Views"
             xmlns:controls="using:ALyricEase.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="404"
             x:CompileBindings="True"
             x:Class="ALyricEase.Controls.SongGridView">
  <!-- 行模板:复用 TrackRow 套 Search 主题(400x60,播放按钮靠右);悬停高亮/操作浮现由共享 TrackRow 样式驱动 -->
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:SongItemViewModel">
      <views:TrackRow Theme="{StaticResource TrackRowSearchTheme}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- 行间距 2px,与原版 GridViewItem Margin="2" 一致(相邻行/列间隙 4px) -->
    <Style Selector="ItemsControl.col > ContentPresenter">
      <Setter Property="Margin" Value="2" />
    </Style>
  </UserControl.Styles>

  <!-- 仿原版 HorizontalScrollableGridView:圆角8 + 1px 边框 + 列表背景 + 内边距6,
       底部再多留 8px 给滚动条(6 是四边内边距,+8 才是滚动条与下边框之间的距离)。
       滚动条位置由**两层**决定,别混:
       · 外层 Border 的 padding.Bottom(8) = 滚动条下沿到下边框的距离(视觉留白,只是把边框往下放);
       · 内层 ScrollViewer 的 padding.Bottom(4) = 真正把滚动条往下推的那 4px。
       ⚠ 横向滚动条占的是 ScrollViewer 模板的最底一行(与内容 overlay,见 Scrolling.axaml 的模板),
       它**永远钉在 ScrollViewer 盒子的下沿**、而 ScrollViewer 自带 ClipToBounds ⇒ 想让它往下走,
       只能让**盒子变高**:模板里 ScrollContentPresenter 的 Margin 绑的就是 Padding,所以给 ScrollViewer
       留 4px 底部内边距 = 盒子长高 4px(滚动条跟着下移)、内容区仍留在原处(歌曲一行都不动)。
       反过来用 RenderTransform 做绘制位移,只是把像素画到裁剪矩形外面 —— 2026-09-20 实测被切 4px
       (曾用 12px 底部内边距 + TranslateTransform Y=4)。回归线:Headless 的 sgbottom 探针。 -->
  <Border Background="{DynamicResource AppListBackground}" BorderBrush="{DynamicResource AppBorder}"
          BorderThickness="1" CornerRadius="8" Padding="6 6 6 8" ClipToBounds="True">
    <ScrollViewer Classes="song-grid-scroller" Padding="0,0,0,4"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <i:Interaction.Behaviors>
        <b:CtrlHorizontalWheelBehavior />
      </i:Interaction.Behaviors>
      <!-- 横向虚拟化:ItemsSource 按 RowsPerColumn 切成列,横向 VirtualizingStackPanel 只实例化
           视口附近的列(12 由有效视口驱动,外部 ScrollViewer 物理滚动同样生效,见 Headless 探针 vgrid/sg);
           列高 = 行数 × (60 行高 + 2×2 边距) 由列内容自然测量得出,不卡固定高度。
           ⚠ 不要换成普通 StackPanel:非虚拟化会把所有列的行控件一次性实化。
           同一份代码只改这一行、跑 15 轮真窗口往返实测(其余配置完全不变):
           首页实化歌曲行 18→60、视觉树节点 1411→2209、"返回首页"每轮分配 23.7MB→43.5MB。
           见 docs/avalonia-tips.md「横向虚拟化面板不能去掉」。 -->
      <ItemsControl x:Name="Columns">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="controls:SongColumn">
            <ItemsControl Classes="col" ItemsSource="{Binding Rows}" ContainerPrepared="OnRowContainerPrepared">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Border>
</UserControl>
