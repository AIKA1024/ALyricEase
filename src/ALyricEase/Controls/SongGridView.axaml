<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="using:ALyricEase.Infrastructure.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:views="using:ALyricEase.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="360"
             x:Class="ALyricEase.Controls.SongGridView">
  <!-- 行模板:复用 TrackRow 套 Search 主题(400x60,播放按钮靠右);悬停高亮/操作浮现由共享 TrackRow 样式驱动 -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:SongItemViewModel">
      <views:TrackRow Theme="{StaticResource TrackRowSearchTheme}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- 行间距 2px,与原版 GridViewItem Margin="2" 一致 -->
    <Style Selector="ItemsControl#Rows > ContentPresenter">
      <Setter Property="Margin" Value="2" />
    </Style>
  </UserControl.Styles>

  <!-- 仿原版 HorizontalScrollableGridView:圆角8 + 1px 边框 + 列表背景 + 内边距6,
       内部横向滚动条贴卡片底边内侧(底部内边距留出空间) -->
  <Border Background="{DynamicResource AppListBackground}" BorderBrush="{DynamicResource AppBorder}"
          BorderThickness="1" CornerRadius="8" Padding="6 6 6 12" ClipToBounds="True">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <i:Interaction.Behaviors>
        <b:CtrlHorizontalWheelBehavior />
      </i:Interaction.Behaviors>
      <!-- 显式 320 = 5 行 × (60 行高 + 2×2 边距):WrapPanel 测量高度不依赖外层减法,
           避免平台滚动条/舍入差挤掉第 5 行 -->
      <ItemsControl x:Name="Rows" Height="320" ContainerPrepared="OnRowContainerPrepared">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>
  </Border>
</UserControl>
