<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent2/WinUI 的 Button 内容默认居中,而 Avalonia 的 HorizontalContentAlignment 默认是
         Stretch(反射实测),裸按钮文字会靠左(登录弹窗实测)。这里设为项目级默认;
         需要拉伸内容的按钮(login-method/navigation-button 等)在自己的样式里显式设回 Stretch。 -->
    <Style Selector="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Fluent 主题按下会把按钮 scale(0.98) 缩小,而 Click 在释放时对释放点做视觉命中测试
         (Button.OnPointerReleased → GetVisualsAt):点按钮最外缘时,松手瞬间该点已落在
         缩小后的可视内容之外 ⇒ "有按下样式但 Click 不触发"。网易云原版无缩放,项目内
         统一去掉(Button/ToggleButton 同款问题);按下反馈由背景变色承担。 -->
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="ToggleButton:pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="Button.icon-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.icon-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
    </Style>

    <Style Selector="Button.player-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="1000" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- 播放条/正在播放按钮:hover/pressed 必须经 /template/ ContentPresenter 才生效(主题模板直接改
         ContentPresenter 背景,优先级压过控件属性 setter)。色对齐原版标准按钮:SystemBaseLow/SystemBaseMediumLow。 -->
    <Style Selector="Button.player-button /template/ ContentPresenter#PART_ContentPresenter">
        <!-- 只清模板内容宿主的 Transitions,避免和 Composition 位移动画叠加 -->
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.player-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>
    <Style Selector="Button.player-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemBaseMediumLow}" />
    </Style>

    <Style Selector="Button.navigation-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.navigation-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>

    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="{DynamicResource LyricEaseTeal}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.primary-action:pointerover">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- 原版 ExpanderToggleButtonStyle：36px 上下箭头按钮，用于展开/收起排序筛选栏；
         三态颜色由主题资源提供，避免浅色主题沿用暗色填充。 -->
    <Style Selector="ToggleButton.filter-expander">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource FilterExpanderBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.filter-expander:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FilterExpanderBackgroundHover}" />
    </Style>
    <Style Selector="ToggleButton.filter-expander:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FilterExpanderBackgroundPressed}" />
    </Style>
    <Style Selector="ToggleButton.filter-expander:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FilterExpanderBackground}" />
    </Style>
    <Style Selector="ToggleButton.filter-expander:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FilterExpanderBackgroundHover}" />
    </Style>
    <Style Selector="ToggleButton.filter-expander:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FilterExpanderBackgroundPressed}" />
    </Style>
    <!-- FluentTheme 会在 ToggleButton:checked 时把 ContentPresenter 前景切成强调色按钮用的白色；
         箭头直接使用应用主题正文色，避免浅色中性背景上的白色低对比。 -->
    <Style Selector="ToggleButton.filter-expander TextBlock.filter-chevron">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.filter-expander:checked TextBlock.filter-chevron">
        <Setter Property="RenderTransform">
            <RotateTransform Angle="180" />
        </Setter>
    </Style>

    <!-- 全局“播放全部”主操作：所有页面复用同一语义色和 Fluent 交互状态。 -->
    <Style Selector="Button.play-all">
        <Setter Property="Background" Value="{DynamicResource PlayAllButtonBackground}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play-all:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PlayAllButtonBackgroundHover}" />
    </Style>
    <Style Selector="Button.play-all:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PlayAllButtonBackgroundPressed}" />
    </Style>

    <!-- 通用"更多/展开"圆按钮(歌手页/专辑页/播放条等处复用):悬停 SystemBaseLow、按下 SystemBaseMediumLow。
         圆角用 1000 而非 18:按钮实例可能本地改尺寸(播放条为 40×40),写死 18 在非 36px 尺寸上不是正圆 -->
    <Style Selector="Button.more-button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="1000" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.more-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>
    <Style Selector="Button.more-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemBaseMediumLow}" />
    </Style>

    <!-- Fluent 2 关注/已关注双态按钮(歌手页头部)。未关注 = Accent 填充(与播放全部同色阶),
         已关注 = Subtle 填充 + 1px 控件描边;明暗主题全部走 Colors.axaml 的语义资源。
         hover/pressed 必须经 /template/ ContentPresenter 才压得过主题模板内的背景赋值。
         宽度完全跟随内容(= Fluent 2 Button 的自然行为):图标 16 + 6 + 文案 + 左右各 12 内边距。
         不设 MinWidth、也不给文案固定盒子:那两者都会让短文案态右侧凭空多出空白
         ("关注"塞进 50px 盒 + MinWidth 100 ⇒ 右空 22px)。现在右留白与左留白严格对称,
         两态切换只有按钮整体变宽;右对齐时只左边缘伸缩,"更多"按钮间距不受影响。 -->
    <Style Selector="Button.follow-button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource PlayAllButtonBackground}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.follow-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PlayAllButtonBackgroundHover}" />
    </Style>
    <Style Selector="Button.follow-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PlayAllButtonBackgroundPressed}" />
    </Style>
    <Style Selector="Button.follow-button.followed">
        <Setter Property="Background" Value="{DynamicResource AppControlFill}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppControlStroke}" />
    </Style>
    <Style Selector="Button.follow-button.followed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppControlFillHover}" />
    </Style>
    <Style Selector="Button.follow-button.followed:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppControlFillPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppControlStrokePressed}" />
    </Style>
    <!-- 图标 = 原版 FluentUISystemIcons 的 Add(E92B) / Check(E92C) 字形,必须配 LyricEaseIconsOriginal。
         该字体行盒恰为 1em、图标墨迹在 em 盒内居中(水平偏差 <0.3px、垂直 <0.35px @16px),
         所以 16px 字号 + 16x16 容器即可稳稳居中;文字圆点/自画 Path 都没这个保证。 -->
    <Style Selector="Button.follow-button TextBlock.follow-glyph">
        <Setter Property="FontFamily" Value="{DynamicResource LyricEaseIconsOriginal}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.follow-button.followed TextBlock.follow-glyph">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- 写请求在飞:不加进度环,只靠 :disabled 降透明度 + 禁点,图标保持显示乐观更新后的状态。 -->
    <Style Selector="Button.follow-button:disabled">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- 每日行歌手/专辑菜单项:在 Flyout 弹层里,必须全局样式才能命中(弹层不在行的视觉树)。
         高 32、圆角 8、左内边距 12、图标16+间距8+文本;横向撑满菜单宽度,悬停整项高亮 -->
    <Style Selector="Button.track-menu-item">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.track-menu-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>
    <!-- 多歌手"表演者"子菜单打开态:弹层盖住按钮时 :pointerover 会消失,用此类保持高亮 -->
    <Style Selector="Button.track-menu-item.track-menu-open">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>

    <!-- MenuFlyout 菜单项默认观感(全项目统一;原以 track-menu-item 类挂在曲目行歌手/专辑菜单上,
         现升为类型默认:侧栏右键/播放模式菜单等所有 MenuItem 自动同款)。
         高 32、圆角 8、左内边距 12、字号 13,悬停 SystemBaseLow 整项高亮;
         纵向 margin 2 让相邻项之间有间距。ItemsSource 生成的子菜单项同样命中(选择器不带类) -->
    <Style Selector="MenuItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
    </Style>
    <!-- 只缩略标题，保留图标、快捷键和子菜单箭头的布局空间。 -->
    <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 行内圆形操作按钮(歌曲行 TrackRow / 用户页歌单行共用):32px 圆。
         必须配合 RowButtonTheme(TrackRow.axaml 定义、应用级可见)使用 —— 它是无状态自定义模板,
         控件级 Background 才能可靠生效(默认 Fluent 模板的伪类状态色会盖掉控件级 setter)。
         默认 RowButton(浅色半透明叠行背景/深色实色 #404040),悬停 RowButtonHover 变浅,按下 RowButtonPressed 更深 -->
    <Style Selector="Button.row-action">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource RowButton}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.row-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource RowButtonHover}" />
    </Style>
    <Style Selector="Button.row-action:pressed">
        <Setter Property="Background" Value="{DynamicResource RowButtonPressed}" />
    </Style>
</Styles>
