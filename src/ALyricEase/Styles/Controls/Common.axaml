<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:ALyricEase.Controls">
    <Styles.Resources>
        <!-- 播放详情页进度条(仿原版 TimelineSlider):2px 轨道(灰)+ 已播放段(teal,由 DecreaseButton 充当)
             + 12px teal 圆形滑块。默认 Fluent 模板在 30px 高度下滑块下半被模板裁剪且用系统强调色,故自定义。
             Track 会把子元素沿轨道方向排布:DecreaseButton 宽度=已播放比例,Thumb 居中其右缘。 -->
        <ControlTheme x:Key="PlayerProgressSliderTheme" TargetType="Slider">
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="2" VerticalAlignment="Center" Background="#7F8A8A8A" />
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="Horizontal"
                               VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Track.DecreaseButton>
                                <RepeatButton x:Name="PART_DecreaseButton">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="2" VerticalAlignment="Center" Background="#FF5EA9A2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Width="12" Height="12">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="#FF5EA9A2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton x:Name="PART_IncreaseButton">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Slider.player-progress">
        <Setter Property="Theme" Value="{StaticResource PlayerProgressSliderTheme}" />
    </Style>

    <Style Selector="ListBoxItem.lyric-nav-item">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem.lyric-nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="ListBoxItem.lyric-nav-item:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavigationSelected}" />
    </Style>

    <!-- 所有 Flyout 表面内边距收窄为 4(默认 8 太大);仅覆盖 Padding,保留默认模板的阴影/圆角表面 -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- 普通 Flyout 投影(菜单表面走下面全局 MenuFlyoutPresenter 样式) -->
    <Style Selector="FlyoutPresenter /template/ Border">
        <Setter Property="BoxShadow" Value="0 4 10 0 #66000000" />
        <Setter Property="Margin" Value="4 0 4 4" />
    </Style>

    <!-- 所有 MenuFlyoutPresenter(一级+子菜单都自动创建 MenuFlyoutPresenter,子菜单不继承父级 FlyoutPresenterClasses):
         统一圆角;阴影/内边距放模板根 Border(MenuFlyoutPresenter 模板不绑 {TemplateBinding Padding})。
         打开动画(仿 WinUI3 淡入+滑入,方向按锚点自动判断)走 ctrl:FlyoutOpenAnimation 合成动画 -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ctrl:FlyoutOpenAnimation.IsEnabled" Value="True" />
    </Style>
    <Style Selector="MenuFlyoutPresenter /template/ Border">
        <Setter Property="BoxShadow" Value="0 4 10 0 #66000000" />
        <Setter Property="Margin" Value="4 0 4 14" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- 子菜单容器:MenuItem 模板里 Popup#PART_Popup 的 Border(子菜单不是 MenuFlyoutPresenter,是这里承载;
         给它阴影/圆角/内边距,一级二级外观统一)。打开动画同样走 ctrl:FlyoutOpenAnimation -->
    <Style Selector="MenuItem /template/ Popup#PART_Popup Border">
        <Setter Property="BoxShadow" Value="0 4 10 0 #66000000" />
        <Setter Property="Margin" Value="4 0 4 14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ctrl:FlyoutOpenAnimation.IsEnabled" Value="True" />
    </Style>
    <!-- 子菜单内边距均衡:清掉模板里 ItemsPresenter 的 MenuFlyoutScrollerMargin(左右不对称),只留 Border 的 Padding=4 -->
    <Style Selector="MenuItem /template/ Popup#PART_Popup ScrollViewer ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>
</Styles>
