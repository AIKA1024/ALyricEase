<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackground" Color="#F3F3F3" />
            <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceElevated" Color="#F7F7F7" />
            <SolidColorBrush x:Key="AppSurfaceHover" Color="#0D000000" />
            <SolidColorBrush x:Key="AppSurfacePressed" Color="#18000000" />
            <SolidColorBrush x:Key="AppSurfaceSelected" Color="#15000000" />
            <!-- 对齐 UWP SystemBaseLow/SystemBaseMediumLow(曲目行悬停/按下,20%/40%) -->
            <SolidColorBrush x:Key="SystemBaseLow" Color="#33000000" />
            <SolidColorBrush x:Key="SystemBaseMediumLow" Color="#66000000" />
            <!-- 行内播放/更多按钮:浅色态半透明(叠行背景),悬停变浅,按下更深 -->
            <SolidColorBrush x:Key="RowButton" Color="#33000000" />
            <SolidColorBrush x:Key="RowButtonHover" Color="#1A000000" />
            <SolidColorBrush x:Key="RowButtonPressed" Color="#66000000" />
            <!-- 歌单行悬停背景:浅色半透明 / 深色实色 #343434(原版) -->
            <SolidColorBrush x:Key="RowHoverBackground" Color="#33000000" />
            <SolidColorBrush x:Key="AppListBackground" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
            <SolidColorBrush x:Key="TextSecondary" Color="#5D5D5D" />
            <SolidColorBrush x:Key="TextTertiary" Color="#808080" />
            <SolidColorBrush x:Key="TextDisabled" Color="#707070" />
            <!-- 低强调危险操作：透明默认态，hover/pressed 使用浅色语义背景。 -->
            <SolidColorBrush x:Key="DangerActionForeground" Color="#C42B1C" />
            <SolidColorBrush x:Key="DangerActionForegroundHover" Color="#A4262C" />
            <SolidColorBrush x:Key="DangerActionBackgroundHover" Color="#0FC42B1C" />
            <SolidColorBrush x:Key="DangerActionBackgroundPressed" Color="#1FC42B1C" />
            <SolidColorBrush x:Key="AppBorder" Color="#12000000" />
            <SolidColorBrush x:Key="AppBorderStrong" Color="#24000000" />
            <!-- 控件填充/描边:对齐 WinUI Fluent2 Button 默认(ControlFillColorDefault/Secondary/Tertiary,
                 描边取 ControlElevationBorderBrush 1px 可见段=ControlStrokeColorSecondary) -->
            <SolidColorBrush x:Key="AppControlFill" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="AppControlFillHover" Color="#80F9F9F9" />
            <SolidColorBrush x:Key="AppControlFillPressed" Color="#4DF9F9F9" />
            <SolidColorBrush x:Key="AppControlStroke" Color="#29000000" />
            <SolidColorBrush x:Key="AppControlStrokePressed" Color="#0F000000" />
            <!-- 卡片描边:对齐 UWP CardStrokeColorDefault(亮 #0F000000 / 暗 #1AFFFFFF) -->
            <SolidColorBrush x:Key="ListCardBorder" Color="#0F000000" />
            <SolidColorBrush x:Key="ArtFallback" Color="#E5E5E5" />
            <SolidColorBrush x:Key="NavigationPaneBackground" Color="#C8F3F3F3" />
            <SolidColorBrush x:Key="NavigationSelected" Color="#10000000" />
            <SolidColorBrush x:Key="PlayerBarBackground" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="StickyHeaderBackground" Color="#F5F3F3F3" />
            <ExperimentalAcrylicMaterial x:Key="AppAcrylicMaterial"
                                         BackgroundSource="Digger"
                                         TintColor="#FFFFFF"
                                         TintOpacity="1"
                                         MaterialOpacity=".2"
                                         FallbackColor="#F3F3F3" />
            <ExperimentalAcrylicMaterial x:Key="PlayerAcrylicMaterial"
                                         BackgroundSource="None"
                                         TintColor="#E8E8E8"
                                         TintOpacity="0.8"
                                         MaterialOpacity="0.9"
                                         FallbackColor="#E8E8E8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackground" Color="#141516" />
            <SolidColorBrush x:Key="AppSurface" Color="#242424" />
            <SolidColorBrush x:Key="AppSurfaceElevated" Color="#2B2B2B" />
            <SolidColorBrush x:Key="AppSurfaceHover" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="AppSurfacePressed" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceSelected" Color="#18FFFFFF" />
            <!-- 对齐 UWP SystemBaseLow/SystemBaseMediumLow(曲目行悬停/按下,20%/40%) -->
            <SolidColorBrush x:Key="SystemBaseLow" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SystemBaseMediumLow" Color="#66FFFFFF" />
            <!-- 行内播放/更多按钮:深色态实色(原版 #404040/#454545/#3A3A3A) -->
            <SolidColorBrush x:Key="RowButton" Color="#FF404040" />
            <SolidColorBrush x:Key="RowButtonHover" Color="#FF454545" />
            <SolidColorBrush x:Key="RowButtonPressed" Color="#FF3A3A3A" />
            <!-- 歌单行悬停背景:深色实色 #343434(原版) -->
            <SolidColorBrush x:Key="RowHoverBackground" Color="#FF343434" />
            <SolidColorBrush x:Key="AppListBackground" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#C2C2C2" />
            <SolidColorBrush x:Key="TextTertiary" Color="#858585" />
            <SolidColorBrush x:Key="TextDisabled" Color="#777777" />
            <SolidColorBrush x:Key="DangerActionForeground" Color="#FF99A4" />
            <SolidColorBrush x:Key="DangerActionForegroundHover" Color="#FFB3BA" />
            <SolidColorBrush x:Key="DangerActionBackgroundHover" Color="#18FF99A4" />
            <SolidColorBrush x:Key="DangerActionBackgroundPressed" Color="#28FF99A4" />
            <SolidColorBrush x:Key="AppBorder" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AppBorderStrong" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="AppControlFill" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppControlFillHover" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="AppControlFillPressed" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="AppControlStroke" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="AppControlStrokePressed" Color="#12FFFFFF" />
            <!-- 卡片描边:对齐 UWP CardStrokeColorDefault(亮 #0F000000 / 暗 #1AFFFFFF) -->
            <SolidColorBrush x:Key="ListCardBorder" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ArtFallback" Color="#3A3A3A" />
            <SolidColorBrush x:Key="NavigationPaneBackground" Color="#D0181818" />
            <SolidColorBrush x:Key="NavigationSelected" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="PlayerBarBackground" Color="#EB333333" />
            <SolidColorBrush x:Key="StickyHeaderBackground" Color="#F5202020" />
            <ExperimentalAcrylicMaterial x:Key="AppAcrylicMaterial"
                                         BackgroundSource="Digger"
                                         TintColor="#000000"
                                         TintOpacity="1"
                                         MaterialOpacity=".2"
                                         FallbackColor="#141516" />
            <ExperimentalAcrylicMaterial x:Key="PlayerAcrylicMaterial"
                                         BackgroundSource="None"
                                         TintColor="#000000"
                                         TintOpacity="1"
                                         MaterialOpacity="0.9"
                                         FallbackColor="#282828" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="LyricEaseRedColor">#EC4141</Color>
    <Color x:Key="LyricEaseRedHoverColor">#CF3131</Color>
    <Color x:Key="LyricEaseRedPressedColor">#B22222</Color>
    <Color x:Key="LyricEaseTealColor">#64A8A1</Color>
    <Color x:Key="PlayAllButtonColor">#5EA9A2</Color>
    <Color x:Key="PlayAllButtonHoverColor">#6BB8B1</Color>
    <Color x:Key="PlayAllButtonPressedColor">#4E8B85</Color>
    <SolidColorBrush x:Key="LyricEaseRed" Color="{StaticResource LyricEaseRedColor}" />
    <SolidColorBrush x:Key="LyricEaseRedHover" Color="{StaticResource LyricEaseRedHoverColor}" />
    <SolidColorBrush x:Key="LyricEaseRedPressed" Color="{StaticResource LyricEaseRedPressedColor}" />
    <SolidColorBrush x:Key="LyricEaseTeal" Color="{StaticResource LyricEaseTealColor}" />
    <SolidColorBrush x:Key="LyricEaseTealDim" Color="#8064A8A1" />
    <SolidColorBrush x:Key="PlayAllButtonBackground" Color="{StaticResource PlayAllButtonColor}" />
    <SolidColorBrush x:Key="PlayAllButtonBackgroundHover" Color="{StaticResource PlayAllButtonHoverColor}" />
    <SolidColorBrush x:Key="PlayAllButtonBackgroundPressed" Color="{StaticResource PlayAllButtonPressedColor}" />
    <SolidColorBrush x:Key="PlaybackOverlay" Color="#CC000000" />
</ResourceDictionary>
