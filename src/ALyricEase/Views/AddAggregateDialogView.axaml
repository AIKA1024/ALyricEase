<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             x:Class="ALyricEase.Views.AddAggregateDialogView">
    <!-- 添加聚合歌单对话框(WinUI3 ContentDialog 式窗口内弹层,与 LoginDialogView 同款):
         烟雾层(#99000000)盖住整窗拦截输入 + 居中卡片(圆角 8、内边距 24、标题 20 SemiBold、
         按钮右下:取消 + 强调色主按钮)。Esc=取消(取消按钮 HotKey,弹层隐藏时自动失效);
         Enter=确认(卡片 KeyBinding,焦点在弹层内时触发)。不支持点击空白关闭。 -->
    <Grid x:Name="Root">
        <Grid.Styles>
            <!-- 分区标题:小号加粗次级色 -->
            <Style Selector="TextBlock.agg-section-header">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Style>
        </Grid.Styles>
        <!-- 烟雾层(WinUI ContentDialog smoke fill,不支持点击空白关闭) -->
        <Panel Background="#99000000" />
        <Grid DataContext="{Binding AddAggregateDialog}" x:DataType="vm:AddAggregateDialogViewModel"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
            </Grid.KeyBindings>
            <Border MaxWidth="480" MinWidth="340" MaxHeight="540" Margin="24" Padding="24" CornerRadius="8"
                    Background="{DynamicResource AppSurface}"
                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderStrong}"
                    BoxShadow="0 32 64 #66000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding TitleText}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="勾选要合并的网易云/QQ 音乐歌单,打开聚合歌单时合并展示全部曲目。"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBox x:Name="NameBox" PlaceholderText="{Binding NamePlaceholder}"
                             Text="{Binding Name}" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- 右侧 12 间距:滚动条浮在内容上,曲目数不被盖住 -->
                        <Border Padding="0,0,12,0">
                            <StackPanel Spacing="10">
                            <StackPanel Spacing="4" IsVisible="{Binding HasNetEase}">
                                <TextBlock Text="网易云音乐" Classes="agg-section-header" />
                                <ItemsControl ItemsSource="{Binding NetEaseItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AggregatePickerItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" MinHeight="28">
                                                <!-- 文本放进 CheckBox 内容区:点击文字同样切换勾选 -->
                                                <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <CheckBox.Content>
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </CheckBox.Content>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1" Text="{Binding TrackCountText}" FontSize="12"
                                                           Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding HasQq}">
                                <TextBlock Text="QQ音乐" Classes="agg-section-header" />
                                <ItemsControl ItemsSource="{Binding QqItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AggregatePickerItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" MinHeight="28">
                                                <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <CheckBox.Content>
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </CheckBox.Content>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1" Text="{Binding TrackCountText}" FontSize="12"
                                                           Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding HasLocal}">
                                <TextBlock Text="本地音乐" Classes="agg-section-header" />
                                <ItemsControl ItemsSource="{Binding LocalItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AggregatePickerItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" MinHeight="28">
                                                <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <CheckBox.Content>
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </CheckBox.Content>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1" Text="{Binding TrackCountText}" FontSize="12"
                                                           Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="暂无可用歌单:登录音源刷新,或在「本地音乐」分组创建歌单。"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding HasNothing}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                   Text="可跨音源混合勾选" />
                        <Button Grid.Column="1" Content="取消"
                                Command="{Binding $parent[views:AddAggregateDialogView].((vm:MainViewModel)DataContext).CloseAggregateDialogCommand}"
                                HotKeyManager.HotKey="Escape"
                                MinWidth="96" Height="32" />
                        <Button Grid.Column="2" Classes="accent" Content="{Binding ConfirmText}"
                                Command="{Binding ConfirmCommand}"
                                MinWidth="96" Height="32" IsEnabled="{Binding CanConfirm}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
