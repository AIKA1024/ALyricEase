<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             x:Class="ALyricEase.Views.AggregateSettingsDialogView">
    <!-- 聚合歌单设置对话框(WinUI3 ContentDialog 式窗口内弹层,与 AddAggregateDialogView 同款):
         烟雾层 + 居中卡片;Esc=取消,Enter=保存;不支持点击空白关闭。 -->
    <Grid x:Name="Root">
        <Grid.Styles>
            <!-- 打开时 0→1 淡入由 code-behind 触发(IsVisible 翻转不跑过渡,先置 0 下一帧再置 1) -->
            <Style Selector="Grid#Root">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Setter>
            </Style>
            <!-- ContentDialog 主按钮(WinUI3 AccentButton 样式):宿主不在 AppShell 子树内,自带一份 -->
            <Style Selector="Button.dialog-primary">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style Selector="Button.dialog-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
            </Style>
            <Style Selector="Button.dialog-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
            </Style>
        </Grid.Styles>
        <!-- 烟雾层(WinUI ContentDialog smoke fill,不支持点击空白关闭) -->
        <Panel Background="#99000000" />
        <Grid DataContext="{Binding AggregateSettingsDialog}" x:DataType="vm:AggregateSettingsDialogViewModel"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
            </Grid.KeyBindings>
            <Border MaxWidth="420" MinWidth="320" Margin="24" Padding="24" CornerRadius="8"
                    Background="{DynamicResource AppSurface}"
                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderStrong}"
                    BoxShadow="0 32 64 #66000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="聚合歌单设置" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AggregateName, StringFormat='设置「{0}」中歌曲的排列顺序'}"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <RadioButton Content="先网易云,再 QQ" IsChecked="{Binding NetEaseFirst}" FontSize="14" />
                        <RadioButton Content="先 QQ,再网易云" IsChecked="{Binding QqFirst}" FontSize="14" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                   Text="同源内保持歌单原有顺序" />
                        <Button Grid.Column="1" Content="取消"
                                Command="{Binding $parent[views:AggregateSettingsDialogView].((vm:MainViewModel)DataContext).CloseAggregateSettingsDialogCommand}"
                                HotKeyManager.HotKey="Escape"
                                MinWidth="96" Height="32" />
                        <Button Grid.Column="2" Classes="dialog-primary" Content="保存"
                                Command="{Binding SaveCommand}"
                                MinWidth="96" Height="32" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
