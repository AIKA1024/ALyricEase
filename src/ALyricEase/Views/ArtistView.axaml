<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:infra="using:ALyricEase.Infrastructure"
              xmlns:b="using:ALyricEase.Infrastructure.Behaviors"
              xmlns:i="using:Avalonia.Xaml.Interactivity"
              xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:controls="using:ALyricEase.Controls"
             x:DataType="vm:ArtistViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ALyricEase.Views.ArtistView">
  <UserControl.Styles>
    <!-- 专辑/单曲卡片:200 宽,封面黑遮罩悬停(同推荐卡片),点击跳专辑页 -->
    <Style Selector="Button.album-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.album-card-mask">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.album-card:pointerover Border.album-card-mask">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
    <!-- 横向虚拟化面板(VirtualizingStackPanel)无 Spacing:卡片间距改由容器右边距提供(SongGridView 同款做法) -->
    <Style Selector="ItemsControl.hcards > ContentPresenter">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <!-- 区块头"查看更多":Fluent 2 次级文本按钮,透明底,悬停浮起微底色 + teal 前景 -->
    <Style Selector="Button.see-all-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.see-all-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
    </Style>
    <Style Selector="Button.see-all-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="PageScroller"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="48,20,32,116" Spacing="28">
      <!-- 头部(仿原版 ArtistDetailView):圆形头像水平居中在顶,名字在其下方靠左;右侧 teal 关注 + 更多 -->
      <Grid RowDefinitions="240,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <Border Grid.ColumnSpan="2" Width="200" Height="200" CornerRadius="100" ClipToBounds="True"
                Background="{DynamicResource ArtFallback}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image infra:ManagedCoverImage.DecodeSize="240"
                 infra:ManagedCoverImage.Source="{Binding AvatarUrl}"
                 Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
          <Button Classes="follow-button" Content="+关注" ToolTip.Tip="关注歌手(后续接入)">
            <!-- 关注 API 后续接入,暂为无操作 -->
          </Button>
          <Button Classes="more-button" ToolTip.Tip="更多操作(后续接入)">
            <TextBlock Text="•••" LetterSpacing="1" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- 热门歌曲:横向滚动换行网格(6 行),仿原版 HotSongsGridView;
           容器与个性推荐"每日歌曲推荐"共用 Controls/SongGridView -->
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" Margin="10">
          <TextBlock Text="热门歌曲" FontSize="28" FontWeight="Bold" />
          <Button Grid.Column="1" Classes="see-all-button" Command="{Binding OpenAllSongsCommand}"
                  VerticalAlignment="Center" AutomationProperties.Name="查看歌手全部歌曲">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="查看更多" />
              <TextBlock Text="›" FontSize="16" Margin="0,-2,0,0" />
            </StackPanel>
          </Button>
        </Grid>
        <controls:SongGridView ItemsSource="{Binding Songs}" />
      </StackPanel>

      <!-- 专辑:横向卡片网格 -->
      <StackPanel Spacing="12" IsVisible="{Binding HasAlbums}">
        <Grid ColumnDefinitions="*,Auto" Margin="10">
          <TextBlock Text="专辑" FontSize="28" FontWeight="Bold" />
          <Button Grid.Column="1" Classes="see-all-button" Command="{Binding OpenAllAlbumsCommand}"
                  VerticalAlignment="Center" AutomationProperties.Name="查看歌手全部专辑">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="查看更多" />
              <TextBlock Text="›" FontSize="16" Margin="0,-2,0,0" />
            </StackPanel>
          </Button>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,14">
          <i:Interaction.Behaviors>
            <b:CtrlHorizontalWheelBehavior />
          </i:Interaction.Behaviors>
          <ItemsControl Classes="hcards" ItemsSource="{Binding Albums}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- 横向虚拟化:只实化视口及 CacheLength 缓冲内的卡片,封面经 ContainerPrepared 按需加载 -->
                <VirtualizingStackPanel Orientation="Horizontal" CacheLength="0.5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumCardViewModel">
                <Button Theme="{StaticResource RowButtonTheme}" Classes="album-card" Command="{Binding OpenCommand}">
                  <!-- 两行(封面/标题):封面固定 200 高且顶对齐,标题间隔 6(与个性推荐/全部专辑页一致)。
                       不要改回"单格 + 标题 Margin 220"的写法:Stretch + 固定 Height 会把封面垂直居中,
                       卡片顶部空出 20 且标题贴住封面底边(实测间距 0)。 -->
                  <Grid Width="200" RowDefinitions="200,Auto">
                    <Border Grid.Row="0" Width="200" Height="200" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ArtFallback}">
                      <Grid>
                        <Image infra:ManagedCoverImage.DecodeSize="300"
                               infra:ManagedCoverImage.Source="{Binding CoverUrl}"
                               Stretch="UniformToFill" />
                        <Border Classes="album-card-mask" CornerRadius="8" Background="#FF000000" IsHitTestVisible="False" />
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               MaxLines="1" Margin="4,6,4,0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- 单曲与EP:横向卡片网格 -->
      <StackPanel Spacing="12" IsVisible="{Binding HasSingles}">
        <TextBlock Text="单曲与EP" FontSize="28" FontWeight="Bold" Margin="10" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,14">
          <i:Interaction.Behaviors>
            <b:CtrlHorizontalWheelBehavior />
          </i:Interaction.Behaviors>
          <ItemsControl Classes="hcards" ItemsSource="{Binding Singles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- 横向虚拟化:只实化视口及 CacheLength 缓冲内的卡片,封面经 ContainerPrepared 按需加载 -->
                <VirtualizingStackPanel Orientation="Horizontal" CacheLength="0.5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumCardViewModel">
                <Button Theme="{StaticResource RowButtonTheme}" Classes="album-card" Command="{Binding OpenCommand}">
                  <!-- 两行(封面/标题):封面固定 200 高且顶对齐,标题间隔 6(与个性推荐/全部专辑页一致)。
                       不要改回"单格 + 标题 Margin 220"的写法:Stretch + 固定 Height 会把封面垂直居中,
                       卡片顶部空出 20 且标题贴住封面底边(实测间距 0)。 -->
                  <Grid Width="200" RowDefinitions="200,Auto">
                    <Border Grid.Row="0" Width="200" Height="200" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ArtFallback}">
                      <Grid>
                        <Image infra:ManagedCoverImage.DecodeSize="300"
                               infra:ManagedCoverImage.Source="{Binding CoverUrl}"
                               Stretch="UniformToFill" />
                        <Border Classes="album-card-mask" CornerRadius="8" Background="#FF000000" IsHitTestVisible="False" />
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               MaxLines="1" Margin="4,6,4,0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
