<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:ArtistViewModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ALyricEase.Views.ArtistView">
  <UserControl.Styles>
    <!-- 热门歌曲横向网格容器(仿原版 HorizontalScrollableGridView,圆角8+1px边框+列表背景) -->
    <Style Selector="Border.hot-songs-container">
      <Setter Property="Background" Value="{DynamicResource AppListBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6 6 6 12" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ItemsControl.hot-songs-items > ContentPresenter">
      <Setter Property="Margin" Value="2" />
    </Style>
    <!-- 专辑/单曲卡片:200 宽,封面黑遮罩悬停(同推荐卡片),点击跳专辑页 -->
    <Style Selector="Button.album-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.album-card-mask">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.album-card:pointerover Border.album-card-mask">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="48,20,32,116" Spacing="28">
      <!-- 头部(仿原版 ArtistDetailView):圆形头像水平居中在顶,名字在其下方靠左;右侧 teal 关注 + 更多 -->
      <Grid RowDefinitions="240,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <Border Grid.ColumnSpan="2" Width="200" Height="200" CornerRadius="100" ClipToBounds="True"
                Background="{DynamicResource ArtFallback}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" FontSize="20" Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
          <Button Classes="follow-button" Content="+关注" ToolTip.Tip="关注歌手(后续接入)">
            <!-- 关注 API 后续接入,暂为无操作 -->
          </Button>
          <Button Classes="more-button" ToolTip.Tip="更多操作(后续接入)">
            <TextBlock Text="•••" LetterSpacing="1" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- 热门歌曲:横向滚动换行网格(5 行),仿原版 HotSongsGridView -->
      <StackPanel Spacing="12">
        <TextBlock Text="热门歌曲" FontSize="28" FontWeight="Bold" Margin="10" />
        <ScrollViewer Height="340" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Border Classes="hot-songs-container">
            <!-- 显式 320 = 5 行 × (60 行高 + 2×2 边距):WrapPanel 测量高度不再依赖外层 340 的减法,
                 避免平台滚动条/舍入差挤掉第 5 行 -->
            <ItemsControl Classes="hot-songs-items" Height="320" ItemsSource="{Binding Songs}"
                          ContainerPrepared="OnTrackContainerPreparing">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SongItemViewModel">
                  <views:TrackRow Theme="{StaticResource TrackRowSearchTheme}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </ScrollViewer>
      </StackPanel>

      <!-- 专辑:横向卡片网格 -->
      <StackPanel Spacing="12" IsVisible="{Binding HasAlbums}">
        <TextBlock Text="专辑" FontSize="28" FontWeight="Bold" Margin="10" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,14">
          <ItemsControl ItemsSource="{Binding Albums}" ContainerPrepared="OnAlbumContainerPreparing">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumCardViewModel">
                <Button Theme="{StaticResource RowButtonTheme}" Classes="album-card" Command="{Binding OpenCommand}">
                  <Grid Width="200">
                    <Border Width="200" Height="200" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ArtFallback}">
                      <Grid>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        <Border Classes="album-card-mask" CornerRadius="8" Background="#FF000000" IsHitTestVisible="False" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               MaxLines="1" Margin="4,220,4,0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- 单曲与EP:横向卡片网格 -->
      <StackPanel Spacing="12" IsVisible="{Binding HasSingles}">
        <TextBlock Text="单曲与EP" FontSize="28" FontWeight="Bold" Margin="10" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,14">
          <ItemsControl ItemsSource="{Binding Singles}" ContainerPrepared="OnAlbumContainerPreparing">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumCardViewModel">
                <Button Theme="{StaticResource RowButtonTheme}" Classes="album-card" Command="{Binding OpenCommand}">
                  <Grid Width="200">
                    <Border Width="200" Height="200" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ArtFallback}">
                      <Grid>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        <Border Classes="album-card-mask" CornerRadius="8" Background="#FF000000" IsHitTestVisible="False" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               MaxLines="1" Margin="4,220,4,0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
