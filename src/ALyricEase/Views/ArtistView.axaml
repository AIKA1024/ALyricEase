<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:infra="using:ALyricEase.Infrastructure"
              xmlns:b="using:ALyricEase.Infrastructure.Behaviors"
              xmlns:i="using:Avalonia.Xaml.Interactivity"
              xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:controls="using:ALyricEase.Controls"
             x:DataType="vm:ArtistViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ALyricEase.Views.ArtistView">
  <UserControl.Styles>
    <!-- 专辑/单曲卡片外观(含悬停遮罩与 ▶/••• 浮现)全在 Controls/AlbumCard.axaml 里,
         这里只剩横滑卡片间距 -->
    <!-- 横向虚拟化面板(VirtualizingStackPanel)无 Spacing:卡片间距改由容器右边距提供(SongGridView 同款做法) -->
    <Style Selector="ItemsControl.hcards > ContentPresenter">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <!-- 区块头"查看更多":Fluent 2 次级文本按钮,透明底,悬停浮起微底色 + teal 前景 -->
    <Style Selector="Button.see-all-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.see-all-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
    </Style>
    <Style Selector="Button.see-all-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
    </Style>
    <!-- 热门歌曲拉取中:网格容器撑到 6 行满列高度(6×(60 行高+2×2 边距)+4 滚动条留白+6/8 内边距+1×2 边框 = 404),
         避免空集合时塌成一圈边框、数据到位后整页跳高 -->
    <Style Selector="controls|SongGridView.loading">
      <Setter Property="MinHeight" Value="404" />
    </Style>
    <!-- 加载指示:转圈样式已升为全局 Ellipse.spinner(Styles/Controls/Common.axaml),
         旋转由 infra:SpinnerRotation 在合成线程驱动(可见才转),本页不再重复定义。 -->
  </UserControl.Styles>

  <ScrollViewer x:Name="PageScroller" Classes="page-scroll"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="48,20,32,120" Spacing="28">
      <!-- 头部(仿原版 ArtistDetailView):圆形头像水平居中在顶,名字在其下方靠左;右侧关注 + 更多 -->
      <Grid RowDefinitions="240,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <Border Grid.ColumnSpan="2" Width="200" Height="200" CornerRadius="100" ClipToBounds="True"
                Background="{DynamicResource ArtFallback}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image infra:ManagedCoverImage.DecodeSize="300"
                 infra:ManagedCoverImage.Source="{Binding AvatarUrl}"
                 Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
          <!-- Fluent 2 关注按钮:两态(Accent / Subtle)由 Classes.followed 切换,样式在 Styles/Controls/Buttons.axaml。
               图标用原版 FluentUISystemIcons 字体的 Add / Check 字形;写请求在飞时不加进度环,
               只靠按钮禁用 + 0.6 透明度反馈,免得图标位多出一个圈。 -->
          <Button Classes="follow-button" Classes.followed="{Binding IsFollowed}"
                  Command="{Binding ToggleFollowCommand}"
                  IsVisible="{Binding HasArtist}" IsEnabled="{Binding CanFollow}"
                  ToolTip.Tip="{Binding FollowToolTip}"
                  AutomationProperties.Name="{Binding FollowLabel}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <!-- 图标位恒定 16x16,两态只切字形;文案盒宽 = 文本宽,按钮宽度随内容伸缩 ⇒
                   左右留白都恰为 12px 内边距,不会像固定等宽盒那样在短文案态右侧空出一截。
                   Spacing=6 与项目其它图标文字按钮(播放全部/心动模式)一致,落在 Fluent 2 sNudge 档。 -->
              <Grid Width="16" Height="16">
                <TextBlock Classes="follow-glyph" Text="{DynamicResource IconAdd}"
                           IsVisible="{Binding !IsFollowed}" />
                <TextBlock Classes="follow-glyph" Text="{DynamicResource IconCheck}"
                           IsVisible="{Binding IsFollowed}" />
              </Grid>
              <TextBlock Classes="follow-label" Text="{Binding FollowLabel}" />
            </StackPanel>
          </Button>
          <Button Classes="more-button" ToolTip.Tip="更多操作" AutomationProperties.Name="更多歌手操作">
            <TextBlock Text="{DynamicResource IconMore}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" ShowMode="Transient">
                <MenuItem Header="分享" Click="OnShareArtistClick">
                  <MenuItem.Icon>
                    <TextBlock Text="{DynamicResource IconShare}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="在浏览器中打开" Click="OnOpenArtistInBrowserClick">
                  <MenuItem.Icon>
                    <TextBlock Text="{DynamicResource IconOpenInBrowser}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="复制链接" Click="OnCopyArtistLinkClick">
                  <MenuItem.Icon>
                    <TextBlock Text="{DynamicResource IconCopyLink}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 热门歌曲:横向滚动换行网格(6 行),仿原版 HotSongsGridView;
           容器与个性推荐"每日歌曲推荐"共用 Controls/SongGridView -->
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" Margin="10">
          <TextBlock Text="热门歌曲" FontSize="28" FontWeight="Bold" />
          <Button Grid.Column="1" Classes="see-all-button" Command="{Binding OpenAllSongsCommand}"
                  VerticalAlignment="Center" AutomationProperties.Name="查看歌手全部歌曲">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="查看更多" />
              <TextBlock Text="›" FontSize="16" Margin="0,-2,0,0" />
            </StackPanel>
          </Button>
        </Grid>
        <!-- loading 类保留满列高度,容器中央叠旋转指示;数据到位后动画随 IsLoadingSongs 一并消失 -->
        <Grid>
          <controls:SongGridView Classes.loading="{Binding IsLoadingSongs}" ItemsSource="{Binding Songs}" />
          <StackPanel IsVisible="{Binding IsLoadingSongs}" Orientation="Horizontal" Spacing="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      AutomationProperties.Name="正在加载热门歌曲">
            <Ellipse Classes="spinner" Width="20" Height="20" StrokeThickness="3"
                     infra:SpinnerRotation.IsActive="{Binding IsLoadingSongs}"
                     Stroke="{DynamicResource LyricEaseTeal}"
                     StrokeDashArray="8,14" />
            <TextBlock Text="加载中…" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- 专辑:横向卡片网格 -->
      <StackPanel Spacing="12" IsVisible="{Binding HasAlbums}">
        <Grid ColumnDefinitions="*,Auto" Margin="10">
          <TextBlock Text="专辑" FontSize="28" FontWeight="Bold" />
          <Button Grid.Column="1" Classes="see-all-button" Command="{Binding OpenAllAlbumsCommand}"
                  VerticalAlignment="Center" AutomationProperties.Name="查看歌手全部专辑">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="查看更多" />
              <TextBlock Text="›" FontSize="16" Margin="0,-2,0,0" />
            </StackPanel>
          </Button>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,14">
          <i:Interaction.Behaviors>
            <b:CtrlHorizontalWheelBehavior />
          </i:Interaction.Behaviors>
          <ItemsControl Classes="hcards" ItemsSource="{Binding Albums}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- 横向虚拟化:只实化视口及 CacheLength 缓冲内的卡片,封面经 ContainerPrepared 按需加载 -->
                <VirtualizingStackPanel Orientation="Horizontal" CacheLength="0.5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumCardViewModel">
                <controls:AlbumCard />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- 单曲与EP:横向卡片网格 -->
      <StackPanel Spacing="12" IsVisible="{Binding HasSingles}">
        <TextBlock Text="单曲与EP" FontSize="28" FontWeight="Bold" Margin="10" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,14">
          <i:Interaction.Behaviors>
            <b:CtrlHorizontalWheelBehavior />
          </i:Interaction.Behaviors>
          <ItemsControl Classes="hcards" ItemsSource="{Binding Singles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- 横向虚拟化:只实化视口及 CacheLength 缓冲内的卡片,封面经 ContainerPrepared 按需加载 -->
                <VirtualizingStackPanel Orientation="Horizontal" CacheLength="0.5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumCardViewModel">
                <controls:AlbumCard />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
