<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:infra="using:ALyricEase.Infrastructure"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             x:Class="ALyricEase.Views.ClearCacheDialogView">
    <!-- 清除缓存确认弹窗(WinUI3 ContentDialog 式窗口内弹层,与 AudioDeviceDialogView 同款):
         确认态 = 说明 + 取消/确认清除;确认后切等待态 = 门控的不确定进度条动画,期间
         CloseClearCacheDialog 拒绝关闭,由 ConfirmClearCacheAsync 完成后自行收尾。 -->
    <Grid x:Name="Root">
        <Grid.Styles>
            <!-- 确认态 ⇄ 等待态切换淡入(两块面板互斥显示,切换时有 0.15s 淡入) -->
            <Style Selector="StackPanel.dialog-state">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Setter>
            </Style>
        </Grid.Styles>
        <!-- 烟雾层(WinUI ContentDialog smoke fill,不支持点击空白关闭) -->
        <Panel Background="#99000000" />
        <Grid DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border MaxWidth="420" MinWidth="360" Margin="24" Padding="24" CornerRadius="8"
                    Background="{DynamicResource AppSurface}"
                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderStrong}"
                    BoxShadow="0 32 64 #66000000">
                <Panel>
                    <!-- 确认态 -->
                    <StackPanel Classes="dialog-state" Spacing="12" IsVisible="{Binding !IsClearingCache}">
                        <TextBlock Text="清除缓存" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="将清除已缓存的音乐、封面、歌词和离线歌单索引,不会删除云端歌单与登录信息。"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <!-- 用量进度条:已用/上限(上限就是设置"存储区"里的那个值) -->
                        <StackPanel Spacing="6" Margin="0,2,0,0">
                            <ProgressBar Height="4" Minimum="0"
                                         Maximum="{Binding CacheLimitMb}"
                                         Value="{Binding CacheUsedMb}"
                                         Foreground="{DynamicResource SystemAccentColor}" />
                            <TextBlock Text="{Binding CacheUsageText}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Button Content="取消" MinWidth="96" Height="32"
                                    HorizontalAlignment="Left"
                                    HotKeyManager.HotKey="Escape"
                                    Command="{Binding $parent[views:ClearCacheDialogView].((vm:MainViewModel)DataContext).CloseClearCacheDialogCommand}" />
                            <Button Grid.Column="1" Classes="accent" Content="确认清除"
                                    MinWidth="96" Height="32"
                                    Command="{Binding ConfirmClearCacheCommand}" />
                        </Grid>
                    </StackPanel>
                    <!-- 等待态:清理进行中;不确定进度条挂 IndeterminateAnimationGate
                         (弹窗隐藏后动画会跟着停,见 perf-notes 探针结论);无按钮、Esc 无落点 -->
                    <StackPanel Classes="dialog-state" Spacing="16" IsVisible="{Binding IsClearingCache}"
                                HorizontalAlignment="Center">
                        <ProgressBar Width="200" Height="4" IsIndeterminate="True"
                                     infra:IndeterminateAnimationGate.IsActive="True"
                                     Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="正在清除缓存…" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
