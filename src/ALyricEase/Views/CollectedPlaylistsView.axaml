<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:CollectedPlaylistsViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ALyricEase.Views.CollectedPlaylistsView">
  <UserControl.Styles>
    <!-- 底部播放条预留:内容根 margin bottom = PlayerBarReserve(120,计入滚动范围,滚到底才空出);
         page-scroll 不再设 Padding(padding 会压缩视口,内容永远进不了播放条后面,亚克力失效) -->
    <Style Selector="StackPanel.page-root">
      <Setter Property="Margin" Value="48,20,32,120" />
    </Style>
    <Style Selector=".narrow StackPanel.page-root">
      <Setter Property="Margin" Value="16,12,16,120" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.page-sub">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.row-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.row-sub">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <!-- 歌单行:48px 瓦片 + 标题/曲数,悬停高亮浮现操作(与用户页窄屏行同款) -->
    <Style Selector="Button.user-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- 悬停/按下高亮画在内容 Grid 之下的独立 Border(TrackRow row-hover-bg 同构,与内容解耦):
         挂在模板 CP 上的画刷过渡会让整个行子树跟着失效重绘,实测明显卡顿。
         默认背景=页面底色实色(视觉等同透明),插值全程不透明,无半透明中间帧。
         Padding 移入内容 Grid 的 Margin,让高亮 Border 铺满整行 -->
    <Style Selector="Border.user-row-hover">
      <Setter Property="Background" Value="{DynamicResource UserSectionRowHover}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.user-row:pointerover Border.user-row-hover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- 按住期间锁显:over 链清空时 :pointerover 失配会让高亮层消失 -->
    <Style Selector="Button.user-row:pressed Border.user-row-hover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.user-row-pressed">
      <Setter Property="Background" Value="{DynamicResource UserSectionRowPressed}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.user-row:pressed Border.user-row-pressed">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="StackPanel.row-actions">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.user-row:pointerover StackPanel.row-actions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- 按住期间锁存显示:断"over 链清空 → 按钮显隐 → 布局变化 → over 重算"的反馈循环
         (Avalonia 12 PointerOverPreProcessor 捕获期间 hit≠捕获元素即清空 over 链,与用户页同款) -->
    <Style Selector="Button.user-row:pressed StackPanel.row-actions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.user-row:focus-within StackPanel.row-actions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=".narrow StackPanel.row-actions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=".narrow Button.row-play">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- ▶/••• 圆钮复用全局 row-action + RowButtonTheme(与歌曲行同一套) -->
  </UserControl.Styles>

  <ScrollViewer Classes="page-scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="page-root" Spacing="24">
      <StackPanel Orientation="Vertical" Spacing="4">
        <TextBlock Classes="page-title" Text="我的收藏" />
        <TextBlock Classes="page-sub" Text="收藏的好音乐，都在这里。" />
      </StackPanel>

      <StackPanel Spacing="12">
        <ListBox x:Name="PlatformFilter" Classes="platform-filter"
                 SelectedIndex="{Binding SourceIndex, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 SelectionMode="AlwaysSelected" AutomationProperties.Name="筛选收藏歌单的平台">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem Content="全部" />
          <ListBoxItem Content="网易云音乐" />
          <ListBoxItem Content="QQ 音乐" />
        </ListBox>
        <TextBlock Classes="page-sub" Text="{Binding CountSummary}" />
      </StackPanel>
      <TextBlock Classes="page-sub" Text="{Binding LibraryStatus}" IsVisible="{Binding HasError}" />

      <Border IsVisible="{Binding IsEmpty}" x:Name="EmptyState" Padding="24,32" CornerRadius="8"
              Background="{DynamicResource UserSectionCardBackground}"
              BorderBrush="{DynamicResource ListCardBorder}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="page-sub" Text="{Binding EmptyDescription}" />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding !IsEmpty}" CornerRadius="8" Padding="4"
              Background="{DynamicResource UserSectionCardBackground}"
              BorderBrush="{DynamicResource ListCardBorder}" BorderThickness="1">
      <ItemsControl x:Name="Rows" ItemsSource="{Binding Playlists}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlaylistItemViewModel">
            <Button Classes="user-row" Tapped="OnPlaylistRowTapped" KeyDown="OnPlaylistKeyDown"
                    ContextRequested="OnPlaylistContextRequested"
                    AutomationProperties.Name="{Binding Name, StringFormat='打开歌单 {0}'}" ToolTip.Tip="{Binding Name}">
              <Panel>
                  <Border Classes="user-row-hover" />
                  <Border Classes="user-row-pressed" />
                  <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12" Margin="8">
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" ClipToBounds="True"
                        IsHitTestVisible="False" Background="{DynamicResource ArtFallback}">
                  <Image Stretch="UniformToFill"
                         infra:ManagedCoverImage.DecodeSize="96"
                         infra:ManagedCoverImage.Source="{Binding CoverUrl}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
                  <TextBlock Classes="row-title" Text="{Binding Name}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="row-sub" Text="{Binding SourceLabel}" />
                    <TextBlock Classes="row-sub" Text="·" />
                    <TextBlock Classes="row-sub" Text="{Binding TrackCountText}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Classes="row-actions">
                  <Button Classes="row-action row-play" Theme="{StaticResource RowButtonTheme}"
                          Click="OnRowPlayClick" ToolTip.Tip="播放歌单"
                          AutomationProperties.Name="{Binding Name, StringFormat='播放 {0}'}">
                    <TextBlock Text="{DynamicResource IconPlayFilled}" FontSize="14"
                               FontFamily="{DynamicResource LyricEaseIconsFilled}" />
                  </Button>
                  <Button Classes="row-action" Theme="{StaticResource RowButtonTheme}"
                          Click="OnRowMoreClick" ToolTip.Tip="更多操作"
                          AutomationProperties.Name="{Binding Name, StringFormat='{}{0}的更多操作'}">
                    <TextBlock Text="{DynamicResource IconMore}" FontSize="14"
                               FontFamily="{DynamicResource LyricEaseIcons}" />
                  </Button>
                </StackPanel>
              </Grid>
              </Panel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
