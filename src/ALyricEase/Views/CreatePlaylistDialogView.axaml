<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             x:Class="ALyricEase.Views.CreatePlaylistDialogView">
    <!-- 创建歌单对话框(WinUI3 ContentDialog 式窗口内弹层,与 AddAggregateDialogView 同款):
         烟雾层(#99000000)盖住整窗拦截输入 + 居中卡片(圆角 8、内边距 24、标题 20 SemiBold、
         按钮右下:取消 + 强调色主按钮)。Esc=取消(取消按钮 HotKey,弹层隐藏时自动失效);
         Enter=确认(卡片 KeyBinding,焦点在弹层内时触发)。不支持点击空白关闭。 -->
    <Grid x:Name="Root">
        <Grid.Styles>
            <!-- 打开时 0→1 淡入由 code-behind 触发(IsVisible 翻转不跑过渡,先置 0 下一帧再置 1) -->
            <Style Selector="Grid#Root">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Setter>
            </Style>
            <!-- ContentDialog 主按钮(WinUI3 AccentButton 样式):
                 宿主不在 AppShell 子树内,AppShell 里的 dialog-primary 样式够不到,这里自带一份 -->
            <Style Selector="Button.dialog-primary">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style Selector="Button.dialog-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
            </Style>
            <Style Selector="Button.dialog-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
            </Style>
        </Grid.Styles>
        <!-- 烟雾层(WinUI ContentDialog smoke fill,不支持点击空白关闭) -->
        <Panel Background="#99000000" />
        <Grid DataContext="{Binding CreatePlaylistDialog}" x:DataType="vm:CreatePlaylistDialogViewModel"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
            </Grid.KeyBindings>
            <Border MaxWidth="440" MinWidth="340" Margin="24" Padding="24" CornerRadius="8"
                    Background="{DynamicResource AppSurface}"
                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderStrong}"
                    BoxShadow="0 32 64 #66000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding SourceLabel, StringFormat='创建{0}歌单'}"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBox x:Name="NameBox" PlaceholderText="歌单名称"
                             Text="{Binding Name}" MaxLength="40" />
                    <CheckBox IsChecked="{Binding IsPrivate}" Content="设为隐私歌单(仅自己可见)"
                              IsVisible="{Binding IsNetEase}" />
                    <!-- 失败文案:留在框内,红字显示服务端/网络错误 -->
                    <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap"
                               Foreground="#FFE74C3C"
                               IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Text="创建后出现在侧栏歌单分组中" />
                        <Button Grid.Column="1" Content="取消"
                                Command="{Binding $parent[views:CreatePlaylistDialogView].((vm:MainViewModel)DataContext).CloseCreatePlaylistDialogCommand}"
                                HotKeyManager.HotKey="Escape"
                                MinWidth="96" Height="32" />
                        <Button Grid.Column="2" Classes="dialog-primary" Content="创建"
                                Command="{Binding ConfirmCommand}"
                                MinWidth="96" Height="32" IsEnabled="{Binding CanConfirm}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
