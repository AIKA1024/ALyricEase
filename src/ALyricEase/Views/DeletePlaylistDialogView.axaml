<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             x:Class="ALyricEase.Views.DeletePlaylistDialogView">
    <!-- 删除歌单确认对话框(与 RenamePlaylistDialogView 同款骨架,确认按钮为危险红):
         烟雾层盖住整窗拦截输入 + 居中卡片。Esc=取消;Enter=确认删除。
         打开时淡入由 code-behind 触发(无输入框,不抢焦点)。 -->
    <Grid x:Name="Root">
        <Grid.Styles>
            <Style Selector="Grid#Root">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="Button.dialog-danger">
                <Setter Property="Background" Value="#FFE74C3C" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style Selector="Button.dialog-danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#FFF25B4E" />
            </Style>
            <Style Selector="Button.dialog-danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#FFD64535" />
            </Style>
        </Grid.Styles>
        <Panel Background="#99000000" />
        <Grid DataContext="{Binding DeletePlaylistDialog}" x:DataType="vm:DeletePlaylistDialogViewModel"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
            </Grid.KeyBindings>
            <Border MaxWidth="440" MinWidth="340" Margin="24" Padding="24" CornerRadius="8"
                    Background="{DynamicResource AppSurface}"
                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderStrong}"
                    BoxShadow="0 32 64 #66000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding SourceLabel, StringFormat='删除{0}歌单'}"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ConfirmText}" FontSize="14" TextWrapping="Wrap"
                               LineHeight="22" />
                    <!-- 失败文案:留在框内,红字显示服务端/网络错误 -->
                    <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap"
                               Foreground="#FFE74C3C"
                               IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Text="{Binding FooterHint}" />
                        <Button Grid.Column="1" Content="取消"
                                Command="{Binding $parent[views:DeletePlaylistDialogView].((vm:MainViewModel)DataContext).CloseDeletePlaylistDialogCommand}"
                                HotKeyManager.HotKey="Escape"
                                MinWidth="96" Height="32" />
                        <Button Grid.Column="2" Classes="dialog-danger" Content="删除"
                                Command="{Binding ConfirmCommand}"
                                MinWidth="96" Height="32" IsEnabled="{Binding CanConfirm}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
