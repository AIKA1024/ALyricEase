<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ALyricEase.ViewModels"
        xmlns:controls="using:ALyricEase.Controls"
        x:Class="ALyricEase.Views.DesktopLyricWindow" x:DataType="vm:DesktopLyricViewModel"
        Title="ALyricEase 桌面歌词" Width="720" SizeToContent="Height" CanResize="False"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent" RequestedThemeVariant="Dark">
  <!-- 只有歌词本体:顶部那行按钮(A−/A+/译/背景/穿透/×)已去掉,和 Android 悬浮窗一致。
       每一项在设置页的歌词设置弹窗里都有:字号/背景/颜色/描边/阴影,总开关、翻译、穿透还各有一个
       快捷键(HotkeyCatalog 的桌面歌词组)。拖动直接按在歌词上即可。 -->
  <Grid PointerPressed="OnDragPressed" ToolTip.Tip="拖动调整歌词位置">
    <Border x:Name="LyricSurface" Background="{CompiledBinding BackgroundBrush}" CornerRadius="12" />
    <StackPanel x:Name="LyricContent" Margin="18,12" Spacing="4"
                Effect="{CompiledBinding LyricShadow}">
      <!-- 投影挂在容器上(一行一个 Effect 太贵);描边/颜色/字体在每行自己的控件里 -->
      <controls:DesktopLyricText Text="{CompiledBinding Original}"
                                 FontSize="{CompiledBinding FontSize}"
                                 TextFontFamily="{CompiledBinding LyricFontFamily}"
                                 FontWeight="SemiBold"
                                 TextBrush="{CompiledBinding TextBrush}"
                                 OutlineBrush="{CompiledBinding OutlineBrush}"
                                 OutlineThickness="{CompiledBinding EffectiveOutlineThickness}"
                                 MaxTextHeight="200" />
      <controls:DesktopLyricText Text="{CompiledBinding Translation}" IsVisible="{CompiledBinding HasTranslation}"
                                 FontSize="{CompiledBinding TranslationFontSize}"
                                 TextFontFamily="{CompiledBinding LyricFontFamily}"
                                 TextBrush="{CompiledBinding TranslationBrush}"
                                 OutlineBrush="{CompiledBinding OutlineBrush}"
                                 OutlineThickness="{CompiledBinding EffectiveOutlineThickness}"
                                 MaxTextHeight="100" />
    </StackPanel>
  </Grid>
</Window>
