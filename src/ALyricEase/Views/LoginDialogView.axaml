<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:infra="using:ALyricEase.Infrastructure"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             x:Class="ALyricEase.Views.LoginDialogView"
             infra:ModalVisibilityTransition.PreserveEnabledDuringClose="True">
    <Grid x:Name="Root" Container.Name="loginRoot" Container.Sizing="Width">
        <Grid.Styles>
            <Style Selector="Button.source-tab">
                <Setter Property="MinWidth" Value="116" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style Selector="Button.source-tab.active">
                <Setter Property="Background" Value="{DynamicResource AppSurface}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="Button.login-method">
                <Setter Property="Height" Value="58" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="Button.login-method.active">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            </Style>
            <Style Selector="Border.field-card">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style Selector="TextBlock.section-label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="TextBlock.supporting">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- 两栏 = DockPanel:宽屏方法列表 Dock=Left 固定 178,内容填充其余;Cookie 面板同理。
                 注意:Avalonia 12 里 Grid.ColumnDefinitions/RowDefinitions 已不是 AvaloniaProperty,
                 不能进 Style setter(反射实测),所以换 DockPanel + Dock/Width 这类可样式化属性切换。 -->
            <Style Selector="ScrollViewer#QqMethodHost">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="Width" Value="178" />
                <Setter Property="Margin" Value="0,0,24,0" />
            </Style>
            <Style Selector="ScrollViewer#NetEaseMethodHost">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="Width" Value="178" />
                <Setter Property="Margin" Value="0,0,24,0" />
            </Style>
            <Style Selector="StackPanel#MusicUField">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="Width" Value="300" />
                <Setter Property="Margin" Value="0,0,18,0" />
            </Style>
            <!-- 小屏:登录弹窗视口 < 760 时两栏放不下,方法列表横排置顶(Dock=Top 全宽),
                 内容被排到下方;Cookie 面板的输入区同样折为全宽,帮助卡(填充 child)落到下方 -->
            <ContainerQuery Name="loginRoot" Query="max-width:760">
                <Style Selector="ScrollViewer#QqMethodHost">
                    <Setter Property="DockPanel.Dock" Value="Top" />
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Margin" Value="0,0,0,16" />
                </Style>
                <Style Selector="StackPanel#MethodList">
                    <Setter Property="Orientation" Value="Horizontal" />
                </Style>
                <Style Selector="TextBlock#MethodLabel">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="Button.login-method">
                    <Setter Property="Width" Value="150" />
                    <Setter Property="Height" Value="54" />
                </Style>
                <Style Selector="ScrollViewer#NetEaseMethodHost">
                    <Setter Property="DockPanel.Dock" Value="Top" />
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Margin" Value="0,0,0,16" />
                </Style>
                <Style Selector="StackPanel#NetEaseMethodList">
                    <Setter Property="Orientation" Value="Horizontal" />
                </Style>
                <Style Selector="TextBlock#NetEaseMethodLabel">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="StackPanel#MusicUField">
                    <Setter Property="DockPanel.Dock" Value="Top" />
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Style>
            </ContainerQuery>
        </Grid.Styles>

        <Panel Background="#66000000" />

        <Grid DataContext="{Binding Playlist}" x:DataType="vm:PlaylistViewModel"
              Margin="16">
            <!-- 尺寸交给 XAML:拉伸填满边距内空间,上限即 ContentDialog 常规的 760x680 -->
            <Border x:Name="DialogCard" MaxWidth="760" MaxHeight="680" CornerRadius="16"
                    Background="{DynamicResource AppSurface}"
                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderStrong}"
                    BoxShadow="0 12 40 #52000000" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,24,20,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="连接音乐账号" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="同步歌单，并使用账号可用的会员音质"
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="36" Height="36" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding $parent[views:LoginDialogView].((vm:MainViewModel)DataContext).CloseLoginDialogCommand}"
                                HotKeyManager.HotKey="Escape"
                                AutomationProperties.Name="关闭登录窗口" />
                    </Grid>

                    <Border Grid.Row="1" Margin="28,0,28,20" Padding="3" CornerRadius="9"
                            Background="{DynamicResource AppSurfaceElevated}"
                            BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button Classes="source-tab" Classes.active="{Binding IsNetEaseLoginTab}"
                                    Command="{Binding SelectNetEaseLoginTabCommand}"
                                    AutomationProperties.Name="选择网易云音乐登录">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource LyricEaseRed}" />
                                    <TextBlock Text="网易云音乐" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="source-tab" Classes.active="{Binding IsQQLoginTab}"
                                    Command="{Binding SelectQQLoginTabCommand}"
                                    AutomationProperties.Name="选择 QQ 音乐登录">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#31C27C" />
                                    <TextBlock Text="QQ 音乐" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28,0" MinHeight="370">
                        <DockPanel x:Name="NetEaseLayout" IsVisible="{Binding IsNetEaseLoginTab}" LastChildFill="True">
                            <ScrollViewer x:Name="NetEaseMethodHost" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NetEaseMethodList" Spacing="6">                                <TextBlock x:Name="NetEaseMethodLabel" Text="登录方式" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,4" />
                                <Button Classes="login-method" Classes.active="{Binding IsNetEaseProxyMethod}"
                                        IsVisible="{Binding CanUseNetEaseProxyLogin}"
                                        Command="{Binding SelectNetEaseProxyMethodCommand}"
                                        AutomationProperties.Name="使用官方客户端代理登录">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="官方客户端登录" FontWeight="SemiBold" />
                                        <TextBlock Text="推荐，自动获取凭证" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="login-method" Classes.active="{Binding IsNetEaseCookieMethod}"
                                        Command="{Binding SelectNetEaseCookieMethodCommand}"
                                        AutomationProperties.Name="使用 MUSIC_U Cookie 登录">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="MUSIC_U Cookie" FontWeight="SemiBold" />
                                        <TextBlock Text="手动粘贴凭证" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            </ScrollViewer>

                            <Grid x:Name="NetEaseMethodContent" MinHeight="370">
                                <StackPanel IsVisible="{Binding IsNetEaseProxyMethod}" Spacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="使用官方客户端登录" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Classes="supporting"
                                                   Text="本地代理会捕获网易云音乐客户端登录时的凭证并自动完成登录，无需手动复制 Cookie。" />
                                    </StackPanel>
                                    <Border Classes="field-card">
                                        <StackPanel Spacing="7">
                                            <TextBlock Classes="section-label" Text="操作步骤" />
                                            <TextBlock Classes="supporting" Text="1  点击下方按钮，启动本地代理" />
                                            <TextBlock Classes="supporting" Text="2  打开网易云音乐客户端 → 设置 → 工具 → HTTP 代理" />
                                            <TextBlock Classes="supporting" Text="3  选择自定义代理，填入下方地址并保存" />
                                            <TextBlock Classes="supporting" Text="4  在客户端中重新登录；完成后记得关闭客户端里的代理设置" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="section-label" Text="代理服务器" />
                                        <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                                            <TextBox Text="127.0.0.1" IsReadOnly="True"
                                                     AutomationProperties.Name="代理服务器地址" />
                                            <TextBox Grid.Column="1" Text="{Binding NetEaseProxyAddress}" IsReadOnly="True"
                                                     AutomationProperties.Name="代理服务器端口" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding NetEaseProxyStatus}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsNetEaseProxyLoginActive}"
                                                     infra:IndeterminateAnimationGate.IsActive="True"
                                                     Width="214" HorizontalAlignment="Left" Height="3" />
                                    </StackPanel>
                                    <!-- 代理监听中按钮隐藏(已自动启动);失败或端口被占时可手动重试 -->
                                    <Button x:Name="NetEaseStartProxyButton" Classes="accent" Content="重新启动代理"
                                            Command="{Binding StartNetEaseProxyLoginCommand}" HorizontalAlignment="Left"
                                            MinWidth="168" Height="38" IsEnabled="{Binding !IsBusy}"
                                            IsVisible="{Binding !IsNetEaseProxyLoginActive}"
                                            AutomationProperties.Name="启动本地代理开始监听网易云客户端登录" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsNetEaseCookieMethod}" Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="使用 MUSIC_U 登录" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Classes="supporting"
                                                   Text="网易云音乐暂不提供适合桌面客户端的扫码接口，请粘贴浏览器登录凭证。" />
                                    </StackPanel>
                                    <DockPanel x:Name="NetEaseFields" LastChildFill="True">
                                        <StackPanel x:Name="MusicUField" Spacing="7">
                                            <TextBlock Classes="section-label" Text="MUSIC_U Cookie" />
                                            <TextBox x:Name="MusicUBox" Text="{Binding MusicUInput}"
                                                     PlaceholderText="粘贴 MUSIC_U 的值" Height="84"
                                                     TextWrapping="Wrap" AcceptsReturn="False"
                                                     PastingFromClipboard="OnPastingFromClipboard"
                                                     AutomationProperties.Name="网易云 MUSIC_U Cookie"
                                                     AutomationProperties.HelpText="仅保存在当前设备" />
                                        </StackPanel>
                                        <Border x:Name="NetEaseHelp" Classes="field-card">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-label" Text="从浏览器获取" />
                                                <TextBlock Classes="supporting" Text="1  登录 music.163.com" />
                                                <TextBlock Classes="supporting" Text="2  打开开发者工具的 Application → Cookies" />
                                                <TextBlock Classes="supporting" Text="3  复制 MUSIC_U 的值" />
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                    <Button Classes="accent" Content="登录网易云音乐"
                                            Command="{Binding LoginCommand}" HorizontalAlignment="Left"
                                            MinWidth="152" Height="38" IsEnabled="{Binding !IsBusy}"
                                            AutomationProperties.Name="登录网易云音乐" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>

                        <DockPanel x:Name="QqLayout" IsVisible="{Binding IsQQLoginTab}" LastChildFill="True">
                            <ScrollViewer x:Name="QqMethodHost" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MethodList" Spacing="6">
                                <TextBlock x:Name="MethodLabel" Text="登录方式" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,4" />
                                <Button Classes="login-method" Classes.active="{Binding IsQqQrLoginMethod}"
                                        Command="{Binding SelectQqQrLoginMethodCommand}"
                                        AutomationProperties.Name="选择手机客户端扫码登录">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="手机客户端扫码" FontWeight="SemiBold" />
                                        <TextBlock Text="推荐，完整原生凭证" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="login-method" Classes.active="{Binding IsQqPhoneLoginMethod}"
                                        Command="{Binding SelectQqPhoneLoginMethodCommand}"
                                        AutomationProperties.Name="选择手机号验证码登录">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="手机号验证码" FontWeight="SemiBold" />
                                        <TextBlock Text="无需打开客户端" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="login-method" Classes.active="{Binding IsQqCookieLoginMethod}"
                                        Command="{Binding SelectQqCookieLoginMethodCommand}"
                                        AutomationProperties.Name="选择浏览器 Cookie 登录">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="浏览器 Cookie" FontWeight="SemiBold" />
                                        <TextBlock Text="兼容方式" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            </ScrollViewer>

                            <Grid x:Name="QqMethodContent" MinHeight="370">
                                <StackPanel IsVisible="{Binding IsQqQrLoginMethod}" Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="使用 QQ 音乐扫码" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Classes="supporting" Text="打开手机 QQ 音乐，扫描二维码并确认登录。" />
                                    </StackPanel>
                                    <Border Width="214" Height="214" Background="White" CornerRadius="10" Padding="10"
                                            HorizontalAlignment="Left" BorderThickness="1" BorderBrush="#18000000">
                                        <Grid>
                                            <Image Source="{Binding QqQrImage}" Stretch="Uniform"
                                                   IsVisible="{Binding HasQqQrImage}"
                                                   AutomationProperties.Name="QQ 音乐登录二维码" />
                                            <StackPanel IsVisible="{Binding !HasQqQrImage}" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Spacing="6">
                                                <TextBlock Text="扫码登录" Foreground="#3A3A3A" FontSize="16"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="点击下方按钮生成二维码" Foreground="#6B6B6B" FontSize="11.5" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding QqQrStatus}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsQqQrLoginActive}"
                                                     infra:IndeterminateAnimationGate.IsActive="True"
                                                     Width="214" HorizontalAlignment="Left" Height="3" />
                                    </StackPanel>
                                    <Button x:Name="QqQrButton" Classes="accent" Content="获取或刷新二维码"
                                            Command="{Binding StartQqQrLoginCommand}" HorizontalAlignment="Left"
                                            MinWidth="160" Height="38" IsEnabled="{Binding !IsBusy}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsQqPhoneLoginMethod}" Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="使用手机号登录" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Classes="supporting" Text="验证码由 QQ 音乐发送，ALyricEase 不会保存手机号或短信验证码。" />
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="section-label" Text="手机号" />
                                        <Grid ColumnDefinitions="86,*" ColumnSpacing="8">
                                            <TextBox Text="{Binding QqPhoneCountryCode}" PlaceholderText="86" MaxLength="4"
                                                     HorizontalContentAlignment="Center"
                                                     AutomationProperties.Name="国家或地区代码" />
                                            <TextBox x:Name="QqPhoneBox" Grid.Column="1" Text="{Binding QqPhoneNumber}"
                                                     PlaceholderText="请输入手机号" MaxLength="20"
                                                     AutomationProperties.Name="QQ 音乐登录手机号" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="section-label" Text="短信验证码" />
                                        <Grid ColumnDefinitions="*,132" ColumnSpacing="8">
                                            <TextBox Text="{Binding QqPhoneCode}" PlaceholderText="6 位验证码" MaxLength="6"
                                                     AutomationProperties.Name="短信验证码" />
                                            <Button Grid.Column="1" Content="{Binding QqPhoneSendButtonText}"
                                                    Command="{Binding SendQqPhoneCodeCommand}"
                                                    IsEnabled="{Binding CanSendQqPhoneCode}"
                                                    AutomationProperties.Name="发送短信验证码" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Text="{Binding QqPhoneStatus}" Classes="supporting" />
                                    <Button Classes="accent" Content="使用验证码登录"
                                            Command="{Binding LoginQqPhoneCommand}" HorizontalAlignment="Left"
                                            MinWidth="152" Height="38" IsEnabled="{Binding !IsBusy}"
                                            AutomationProperties.Name="使用手机号验证码登录 QQ 音乐" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsQqCookieLoginMethod}" Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="使用浏览器 Cookie" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Classes="supporting"
                                                   Text="适用于已在 y.qq.com 登录，并能取得完整请求 Cookie 的情况。" />
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="section-label" Text="完整 Cookie" />
                                        <TextBox x:Name="QQBox" Text="{Binding QqCookieInput}"
                                                 PlaceholderText="粘贴 y.qq.com 请求中的整段 Cookie"
                                                 TextWrapping="Wrap" Height="112"
                                                 PastingFromClipboard="OnPastingFromClipboard"
                                                 AutomationProperties.Name="QQ 音乐浏览器 Cookie"
                                                 AutomationProperties.HelpText="需包含 uin 与 qqmusic_key" />
                                    </StackPanel>
                                    <Border Classes="field-card">
                                        <TextBlock Classes="supporting"
                                                   Text="浏览器凭证可能缺少客户端会员播放能力；优先使用扫码或手机号登录。" />
                                    </Border>
                                    <Button Classes="accent" Content="使用 Cookie 登录"
                                            Command="{Binding LoginCommand}" HorizontalAlignment="Left"
                                            MinWidth="152" Height="38" IsEnabled="{Binding !IsBusy}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="28,18,28,24" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource LyricEaseRed}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="登录凭证仅保存在此设备，可随时在设置中退出登录。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="关闭" MinWidth="88" Height="36"
                                Command="{Binding $parent[views:LoginDialogView].((vm:MainViewModel)DataContext).CloseLoginDialogCommand}" />
                    </Grid>

                    <!-- 安卓等无窗口平台的安全验证覆盖层:代码按需放入 QqCaptchaOverlay,盖在卡片内容之上 -->
                    <Panel x:Name="CaptchaHost" Grid.Row="0" Grid.RowSpan="4" IsVisible="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
