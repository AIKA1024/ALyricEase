<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:models="using:ALyricEase.Models"
             xmlns:views="using:ALyricEase.Views"
             x:DataType="vm:LyricViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="320"
             x:Class="ALyricEase.Views.LyricView">
    <UserControl.Resources>
        <!-- 默认(手机/紧凑)模板:字号继承 ListBoxItem 样式(16,选中 22 放大动画) -->
        <DataTemplate x:Key="DefaultLyricItemTemplate" x:DataType="models:LyricLine">
            <StackPanel MaxWidth="380">
                <TextBlock Text="{Binding Original}" TextAlignment="Left" TextWrapping="Wrap" Foreground="#F5F5F7" />
                <TextBlock Text="{Binding Translation}" TextAlignment="Left" TextWrapping="Wrap"
                           FontSize="14" Opacity="0.55" Foreground="#C7C7CC"
                           IsVisible="{Binding HasTranslation}" />
            </StackPanel>
        </DataTemplate>
        <!-- 详情页歌词面板模板(仿原版 PlaybackDetailView 歌词区):32 Bold 原文 + 22 翻译,
             字号随 FontScale 档位缩放;翻译行受"显示翻译"开关控制 -->
        <DataTemplate x:Key="DetailLyricItemTemplate" x:DataType="models:LyricLine">
            <StackPanel>
                <TextBlock Text="{Binding Original}" TextAlignment="Left" TextWrapping="Wrap"
                           FontWeight="Bold" Foreground="#FFFFFFFF"
                           FontSize="{Binding $parent[views:LyricView].FontScale, Converter={x:Static infra:FontScaleConverter.Instance}, ConverterParameter=32}" />
                <TextBlock Text="{Binding Translation}" TextAlignment="Left" TextWrapping="Wrap"
                           Foreground="#BFFFFFFF"
                           FontSize="{Binding $parent[views:LyricView].FontScale, Converter={x:Static infra:FontScaleConverter.Instance}, ConverterParameter=22}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasTranslation" />
                            <Binding Path="$parent[views:LyricView].((vm:LyricViewModel)DataContext).ShowTranslation" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox#LyricList">
            <Setter Property="ItemTemplate" Value="{StaticResource DefaultLyricItemTemplate}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1,1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                    <DoubleTransition Property="FontSize" Duration="0:0:0.5" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" />
                </Transitions>
            </Setter>
        </Style>
        <!-- hover 高亮:背景必须经 /template/ ContentPresenter 才生效;Opacity 是控件属性不被主题覆盖,留在控件上 -->
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1.05,1.05)" />
        </Style>

        <!-- ── detail 模式(播放详情页歌词面板)────────────────────────────── -->
        <!-- 字号固定由模板控制(不随选中跳变);当前句:不透明 + 从左缘放大 1.05(仿原版 Present 状态) -->
        <Style Selector="views|LyricView.detail ListBox#LyricList">
            <Setter Property="ItemTemplate" Value="{StaticResource DetailLyricItemTemplate}" />
            <!-- 视口上下淡出(原版歌词区边缘渐隐) -->
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.12" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.85" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="RenderTransformOrigin" Value="0%,0%" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <!-- InteractiveLyricControl2.Default:未来较远歌词 40% + 5px 模糊 -->
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Effect">
                <BlurEffect Radius="5" />
            </Setter>
        </Style>
        <!-- 原版状态是有方向的，不是当前句上下对称：
             已唱歌词 AbovePresent=0.7/1.5px；下一句 BelowPresent1=0.8/1px；
             下二句 BelowPresent2=0.6/2.5px；其余未来歌词沿用 Default。 -->
        <Style Selector="views|LyricView.detail ListBoxItem.above">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Effect">
                <BlurEffect Radius="1.5" />
            </Setter>
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem.below1">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Effect">
                <BlurEffect Radius="1" />
            </Setter>
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem.below2">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Effect">
                <BlurEffect Radius="2.5" />
            </Setter>
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem:selected">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1.05,1.05)" />
            <Setter Property="Effect">
                <BlurEffect Radius="0" />
            </Setter>
        </Style>
        <!-- 原版 Present 状态没有持久选中底色；压掉 Fluent ListBoxItem 的强调色背景，
             仅在真实 pointerover/pressed 时显示交互底色。 -->
        <Style Selector="views|LyricView.detail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <ListBox x:Name="LyricList" ItemsSource="{Binding Lines}"
                 SelectedIndex="{Binding CurrentIndex, Mode=OneWay}"
                 IsVisible="{Binding HasLyric}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 SelectionChanged="OnSelectionChanged">
        </ListBox>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#9A9AA0" IsVisible="{Binding ShowEmpty}" />
    </Grid>
</UserControl>
