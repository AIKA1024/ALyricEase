<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:models="using:ALyricEase.Models"
             xmlns:views="using:ALyricEase.Views"
             x:DataType="vm:LyricViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="320"
             x:Class="ALyricEase.Views.LyricView">
    <UserControl.Resources>
        <!-- 默认(手机/紧凑)模板:字号继承 ListBoxItem 样式(16,选中 22 放大动画) -->
        <DataTemplate x:Key="DefaultLyricItemTemplate" x:DataType="models:LyricLine">
            <StackPanel MaxWidth="380">
                <TextBlock Text="{Binding Original}" TextAlignment="Left" TextWrapping="Wrap" Foreground="#F5F5F7" />
                <TextBlock Text="{Binding Translation}" TextAlignment="Left" TextWrapping="Wrap"
                           FontSize="14" Opacity="0.55" Foreground="#C7C7CC"
                           IsVisible="{Binding HasTranslation}" />
            </StackPanel>
        </DataTemplate>
        <!-- 详情页按选中态最大字号 33.6/23.1 参与测量，普通态再缩至 1/1.05，
             因而视觉字号仍为 32/22，但换行提前为选中放大预留空间。 -->
        <DataTemplate x:Key="DetailLyricItemTemplate" x:DataType="models:LyricLine">
            <StackPanel>
                <TextBlock Text="{Binding Original}" TextAlignment="Left" TextWrapping="Wrap"
                           FontWeight="Bold" Foreground="#FFFFFFFF"
                           FontSize="{Binding $parent[views:LyricView].FontScale, Converter={x:Static infra:FontScaleConverter.Instance}, ConverterParameter=33.6}" />
                <TextBlock Text="{Binding Translation}" TextAlignment="Left" TextWrapping="Wrap"
                           Foreground="#BFFFFFFF"
                           FontSize="{Binding $parent[views:LyricView].FontScale, Converter={x:Static infra:FontScaleConverter.Instance}, ConverterParameter=23.1}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasTranslation" />
                            <Binding Path="$parent[views:LyricView].((vm:LyricViewModel)DataContext).ShowTranslation" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    <!-- ── 手动滚动期的模糊渐变(2026-09-30)────────────────────────────
         四个模糊档位的**共享** BlurEffect 实例:detail 各样式 Setter 引用的都是这几个对象,
         LyricView.axaml.cs 在手动滚动暂停期只改它们的 Radius,所有挂着的行一起渐变
         (Effect 自身实现 IAffectsRender ⇒ Radius 变化会 InvalidateVisual,回归探针 lyrblur)。
         Transitions 负责渐变本身:滚下时 5→0 慢慢取消,4 秒过期后 0→档位值慢慢模糊回去。 -->
    <BlurEffect x:Key="LyricBlurFar" Radius="5">
        <BlurEffect.Transitions>
            <Transitions>
                <DoubleTransition Property="Radius" Duration="0:0:0.35" Easing="SineEaseInOut" />
            </Transitions>
        </BlurEffect.Transitions>
    </BlurEffect>
    <BlurEffect x:Key="LyricBlurAbove" Radius="1.5">
        <BlurEffect.Transitions>
            <Transitions>
                <DoubleTransition Property="Radius" Duration="0:0:0.35" Easing="SineEaseInOut" />
            </Transitions>
        </BlurEffect.Transitions>
    </BlurEffect>
    <BlurEffect x:Key="LyricBlurBelow1" Radius="1">
        <BlurEffect.Transitions>
            <Transitions>
                <DoubleTransition Property="Radius" Duration="0:0:0.35" Easing="SineEaseInOut" />
            </Transitions>
        </BlurEffect.Transitions>
    </BlurEffect>
    <BlurEffect x:Key="LyricBlurBelow2" Radius="2.5">
        <BlurEffect.Transitions>
            <Transitions>
                <DoubleTransition Property="Radius" Duration="0:0:0.35" Easing="SineEaseInOut" />
            </Transitions>
        </BlurEffect.Transitions>
    </BlurEffect>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox#LyricList">
            <Setter Property="ItemTemplate" Value="{StaticResource DefaultLyricItemTemplate}" />
            <!-- 这里曾有 `ItemsPanel` = `VirtualizingStackPanel CacheLength="1"`,用来压住
                 "边缘行卡在要不要实化的边界 ⇒ 面板反复 Measure/Arrange、进页面只实化一两行"的抖动
                 (用户实测:进详情页那一刻实化数 8→2、`Extent.Height` 在 3268↔4049 之间乱跳)。
                 **已删除**(2026-09-23):那属于 `VirtualizingStackPanel` 的自适应尺寸/变高项路径,
                 上游 12.1.2 已修(#22081 Fix auto-sized VirtualizingStackPanel not rendering),
                 面板回到默认配置;同时那批"游离容器/模型塌陷"的自愈绕法也一并清掉了。
                 ⚠ 若哪天真又看到"只实化一个视口 + `Extent` 乱跳",先确认框架版本没被降回去,
                 别急着重新加 `CacheLength` —— 它治的是症状,而且按行付 GPU。 -->
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1,1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                    <DoubleTransition Property="FontSize" Duration="0:0:0.5" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" />
                </Transitions>
            </Setter>
        </Style>
        <!-- hover 高亮:背景必须经 /template/ ContentPresenter 才生效;Opacity 是控件属性不被主题覆盖,留在控件上 -->
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1.05,1.05)" />
        </Style>

        <!-- ── detail 模式(播放详情页歌词面板)────────────────────────────── -->
        <!-- 字号固定由模板控制(不随选中跳变);当前句:不透明 + 从左缘放大 1.05(仿原版 Present 状态) -->
        <Style Selector="views|LyricView.detail ListBox#LyricList">
            <Setter Property="ItemTemplate" Value="{StaticResource DetailLyricItemTemplate}" />
            <!-- 视口上下淡出(原版歌词区边缘渐隐) -->
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.12" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.85" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem">
            <Setter Property="MinWidth" Value="100" />
            <!-- RenderTransform 不参与列表测量。上下各留 12px，并让选中缩放围绕
                 行中心展开，避免长歌词/翻译/150% 字号向下盖住后一行。 -->
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="Margin" Value="0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="RenderTransformOrigin" Value="0%,50%" />
            <!-- 0.952381 = 1 / 1.05。布局按最大选中态测量，普通态缩小；
                 选中时恢复 1.0，视觉相对放大仍与原版一致。 -->
            <Setter Property="RenderTransform" Value="scale(0.952381,0.952381)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <!-- InteractiveLyricControl2.Default:未来较远歌词 40% + 5px 模糊
                 (共享实例,手动滚动暂停期由代码渐变 Radius,见资源区注释) -->
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Effect" Value="{StaticResource LyricBlurFar}" />
            <!-- ⚠ 这里试过 CacheMode="BitmapCache"(把每行栅格化进中间位图复用),已撤回。
                 收益是真的:同轮 A/B 省 2.97~4.46% GPU(1920x1080,摘掉缓存那一档
                 16.55% vs 带上 13.43%)。但**副作用更大**:挂上缓存后,后续改 Effect
                 不再反映到画面 —— 实测"把每行 Effect 置空"后抓屏像素差 0.00%
                 (没挂缓存时同一操作是 5.68%)。而歌词行的模糊正是靠 class 切换
                 (above/below1/below2)驱动的,缓存会把模糊状态冻在第一次栅格化那一刻。
                 ⇒ 要再试的话,必须先证明"样式路径改 Effect 能触发缓存重建"。 -->
        </Style>
        <!-- 原版状态是有方向的，不是当前句上下对称：
             已唱歌词 AbovePresent=0.7/1.5px；下一句 BelowPresent1=0.8/1px；
             下二句 BelowPresent2=0.6/2.5px；其余未来歌词沿用 Default。 -->
        <Style Selector="views|LyricView.detail ListBoxItem.above">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Effect" Value="{StaticResource LyricBlurAbove}" />
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem.below1">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Effect" Value="{StaticResource LyricBlurBelow1}" />
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem.below2">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Effect" Value="{StaticResource LyricBlurBelow2}" />
        </Style>
        <!-- 性能档「最佳性能」:整个歌词面板不挂模糊(设置里「性能与体验」选「最佳质量」才开)。
             为什么值得给这个开关:挂 Effect 的行都走"离屏层 + 图像过滤",而整窗每帧都在重画
             (色团漂移 + 进度循环),这些离屏层就得跟着每帧重做一次 —— 实测整档关掉省 ≈0.95% GPU
             (1200×720 拉丁方同轮:质量档 6.38% vs 性能档 5.43%,4 条带模糊行 ⇒ ≈0.24%/行)。
             ⚠ 这一条**必须声明在 above/below1/below2 之后**:同一优先级下后声明者生效,
             否则那三条会把模糊又加回来(ListBoxItem 无 CSS 特异性)。
             开关来自 LyricView.BlurEnabled —— 它往自身挂/摘 no-blur 类,见 LyricView.axaml.cs。 -->
        <Style Selector="views|LyricView.detail.no-blur ListBoxItem">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
        <!-- 手动滚动暂停期(第二阶段):半径已渐变到 0 后由代码挂上 blur-suspended 整档摘掉 Effect。
             为什么不就停在半径 0:半径 0 仍让行走「离屏层 + 图像过滤」管线(见上面 selected 的注释),
             暂停期最长 4 秒,必须真正置 null 才不白烧 GPU。
             ⚠ 必须声明在上面四条 Effect 规则之后(同一优先级下后声明者生效)。 -->
        <Style Selector="views|LyricView.detail.blur-suspended ListBoxItem">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem:selected">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1,1)" />
            <!-- 当前句不需要模糊。这里原是 <BlurEffect Radius="0"/> : 半径 0 在视觉上
                 等于没有模糊,却仍让该行走「离屏层 + 图像过滤」那条管线,而且它是全场唯一
                 每帧都在变的那一行(字号最大、被滚动定位),于是每帧都要重做一次离屏。
                 实测(1200x720,用 GPU 归因探针):这一行的代价 +5.91% GPU,
                 而旁边 4 行**真模糊**(半径 1~2.5)加起来才 1.79%。
                 显式置 null 才能压掉基样式那条 Radius="5";只写空 Setter 不行。 -->
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
        <!-- 原版 Present 状态没有持久选中底色；压掉 Fluent ListBoxItem 的强调色背景，
             仅在真实 pointerover/pressed 时显示交互底色。 -->
        <Style Selector="views|LyricView.detail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="views|LyricView.detail ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <!-- ⚠ 这里**故意不用** `IsVisible="{Binding HasLyric}"`:那正是上游缺陷的触发条件。
             每次切歌 `LyricViewModel.LoadAsync` 都先 `Reset()` ⇒ `HasLyric=false` ⇒ 列表隐藏;
             紧接着新集合灌入、`SelectedIndex` 又跟着 `CurrentIndex` 变 —— 这一串全落在"列表隐藏"的窗口里。
             而 Avalonia 的虚拟化面板在隐藏期间出的错,显形后收不回来
             (上游 #15194:列表隐藏期间滚动/改内容 ⇒ 显示时出现重复/幽灵容器,至今 open、12 上仍复现):
             实测留下一个 `IndexFromContainer == -1`、带 `:selected` 高亮的容器 —— 不在面板模型里却参与渲染,
             压在真实那句上,就是用户报的"同一句歌词重复、重叠";模型塌成单个元素时则表现为"只剩当前句"。
             ⚠ 去掉 IsVisible 不会让空态变脏:没有歌词时列表本就是空的(自身 Background=Transparent、
             无边框 ⇒ 一个像素都不画),空态文字由下面那个 Message 覆盖层负责。
             输入行为保持不变:`IsHitTestVisible` 跟随 `HasLyric`,与原来 `IsVisible=false` 时不可点等价。
             ⚠ `AutoScrollToSelectedItem="False"` 是手动滚动暂停跟随(4 秒)的**前置条件**:
             默认 true 时,选中项变化会由 **ListBox 自己** ScrollIntoView,完全绕过 LyricView 的
             抑制逻辑(探针实测:滚轮打标生效、补间已掐,列表仍被框架拽回新句)。
             居中滚动只允许由 OnSelectionChanged → Recenter 一条路径驱动。 -->
        <ListBox x:Name="LyricList" ItemsSource="{Binding Lines}"
                 SelectedIndex="{Binding CurrentIndex, Mode=OneWay}"
                 AutoScrollToSelectedItem="False"
                 IsHitTestVisible="{Binding HasLyric}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 SelectionChanged="OnSelectionChanged">
        </ListBox>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#9A9AA0" IsVisible="{Binding ShowEmpty}" />
    </Grid>
</UserControl>
