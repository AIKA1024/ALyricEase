<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:views="using:ALyricEase.Views"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="ALyricEase.Views.NavigationPaneView">
    <UserControl.Styles>
        <!-- 分组头折叠箭头:默认收起朝右(-90°),展开时回到朝下 -->
        <Style Selector="TextBlock.nav-chevron">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <RotateTransform Angle="-90" />
            </Setter>
        </Style>
        <!-- 展开态:箭头回到朝下(带 .expanded 类,选择器更具体,覆盖默认 -90°) -->
        <Style Selector="TextBlock.nav-chevron.expanded">
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0" />
            </Setter>
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorder}"
                Padding="0,8,0,0">
            <StackPanel Margin="4,0,8,8" Spacing="4" HorizontalAlignment="Stretch">
                <Button Classes="navigation-button" Click="OnAccountClick"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="24,Auto" ColumnSpacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE910;" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="账号" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Classes="navigation-button" Command="{Binding GoSettingsCommand}"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="24,Auto" ColumnSpacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE917;" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="设置" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <!-- Debug 入口:仅 DEBUG 构建可见(IsDebug 由条件编译决定,Release 无入口) -->
                <Button Classes="navigation-button" Command="{Binding GoDebugCommand}"
                        HorizontalAlignment="Stretch" IsVisible="{Binding IsDebug}">
                    <Grid ColumnDefinitions="24,Auto" ColumnSpacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource IconCode}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Debug" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
        <!-- 侧栏列表:分组头行保持禁用态(无 hover/选中背景,旧行为),点按开合在代码后置按坐标命中;
             歌单子项按所属分组开合显示/隐藏(ShowAsChild) -->
        <ListBox x:Name="NavList" Classes="shell-navigation" ItemsSource="{Binding ShellNavItems}"
                 SelectedItem="{Binding SelectedNav}"
                 Background="Transparent" BorderThickness="0" Margin="0,4,0,4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" x:DataType="vm:NavItemViewModel">
                    <!-- 纯标题行(发现/我的音乐)保持禁用(无 hover/选中/焦点,旧行为);
                         折叠分组头(网易云/QQ 音乐)启用以获得 hover 反馈。子项按 ShowAsChild 隐藏 -->
                    <Setter Property="IsEnabled" Value="{Binding IsInteractive}" />
                    <Setter Property="Focusable" Value="{Binding IsItem}" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="IsVisible" Value="{Binding ShowAsChild, Mode=OneWay}" />
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                    <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding IconGlyph}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16"
                                   VerticalAlignment="Center" IsVisible="{Binding IsItem}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"
                                   IsVisible="{Binding IsItem}" />
                        <TextBlock Classes="nav-header" Text="{Binding Label}" Grid.ColumnSpan="2" Margin="0,4,0,-2"
                                   IsVisible="{Binding IsHeader}" />
                        <!-- 折叠指示箭头:仅可折叠分组头(网易云/QQ 音乐)显示;E901(↓) 展开朝下,收起转 -90° 朝右 -->
                        <TextBlock Grid.Column="2" Classes="nav-chevron"
                                   Text="{DynamicResource IconChevronDown}"
                                   FontFamily="{DynamicResource LyricEaseIcons}" FontSize="10"
                                   Margin="0,3,2,0" VerticalAlignment="Center"
                                   IsVisible="{Binding IsToggleGroup}"
                                   Classes.expanded="{Binding IsExpanded}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
