<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:views="using:ALyricEase.Views"
             xmlns:behaviors="clr-namespace:ALyricEase.Infrastructure.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="ALyricEase.Views.NavigationPaneView">
    <UserControl.Styles>
        <!-- 分组头折叠箭头:默认收起朝右(-90°),展开时回到朝下 -->
        <Style Selector="TextBlock.nav-chevron">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <RotateTransform Angle="-90" />
            </Setter>
        </Style>
        <!-- 展开态:箭头回到朝下(带 .expanded 类,选择器更具体,覆盖默认 -90°) -->
        <Style Selector="TextBlock.nav-chevron.expanded">
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0" />
            </Setter>
        </Style>
        <!-- 分组头"+"按钮(聚合歌单/网易云音乐/QQ 音乐):对齐原版我的歌单新增按钮
             (FluentButton 30x30、Padding=0、图标 E92B 字号 20、透明底圆角 4、悬停浅底) -->
        <Style Selector="Button.nav-add-button">
            <Setter Property="Background" Value="{DynamicResource AppControlFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- 悬停/按下需显式重设 BorderBrush:内置 Button 主题的 :pointerover 会以
             ButtonBorderBrushPointerOver(未定义,解析为透明)覆盖模板边框,导致描边消失 -->
        <Style Selector="Button.nav-add-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlFillHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlStroke}" />
        </Style>
        <Style Selector="Button.nav-add-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlFillPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlStrokePressed}" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorder}"
                Padding="0,8,0,0">
            <StackPanel Margin="4,0,8,8" Spacing="4" HorizontalAlignment="Stretch">
                <Button Classes="navigation-button" Click="OnAccountClick"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="24,Auto" ColumnSpacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource IconPerson}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="账号" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Classes="navigation-button" Command="{Binding GoSettingsCommand}"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="24,Auto" ColumnSpacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource IconSettings}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="设置" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <!-- Debug 入口:仅 DEBUG 构建可见(IsDebug 由条件编译决定,Release 无入口) -->
                <Button Classes="navigation-button" Command="{Binding GoDebugCommand}"
                        HorizontalAlignment="Stretch" IsVisible="{Binding IsDebug}">
                    <Grid ColumnDefinitions="24,Auto" ColumnSpacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource IconCode}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Debug" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
        <!-- 侧栏列表:所有行"按下不动作、点击(Tapped)才动作"——分组头开合、普通行选中导航,
             逻辑在 NavListTapBehavior(替代被关闭的 IsHoldWithMouseEnabled 方案);
             歌单子项按所属分组开合显示/隐藏(ShowAsChild) -->
        <ListBox x:Name="NavList" Classes="shell-navigation" ItemsSource="{Binding ShellNavItems}"
                 SelectedItem="{Binding SelectedNav}"
                 Background="Transparent" BorderThickness="0" Margin="0,4,0,4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <i:Interaction.Behaviors>
                <behaviors:NavListTapBehavior />
            </i:Interaction.Behaviors>
            <ListBox.Styles>
                <!-- 平滑滚轮:ListBox 模板是 ListBox > Border > ScrollViewer(PART_ScrollViewer),
                     SmoothWheelScrollBehavior 是 Behavior&lt;ScrollViewer&gt;,不能直接挂到 ListBox 上;
                     用后代选择器命中内部滚动容器,行为经 BehaviorCollectionTemplate 定义在样式里
                     (模板语义:每个命中目标各自实例化集合,与显式 ScrollViewer 页面同效) -->
                <Style Selector="ListBox ScrollViewer">
                    <Setter Property="(i:Interaction.Behaviors)">
                        <BehaviorCollectionTemplate>
                            <BehaviorCollection>
                                <behaviors:SmoothWheelScrollBehavior />
                            </BehaviorCollection>
                        </BehaviorCollectionTemplate>
                    </Setter>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" x:DataType="vm:NavItemViewModel">
                    <!-- 纯标题行(发现/我的音乐)保持禁用(无 hover/选中/焦点,旧行为);
                         折叠分组头(网易云/QQ 音乐)启用以获得 hover 反馈。子项按 ShowAsChild 隐藏 -->
                    <Setter Property="IsEnabled" Value="{Binding IsInteractive}" />
                    <Setter Property="Focusable" Value="{Binding IsItem}" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="IsVisible" Value="{Binding ShowAsChild, Mode=OneWay}" />
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                    <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding IconGlyph}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="16"
                                   VerticalAlignment="Center" IsVisible="{Binding IsItem}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"
                                   IsVisible="{Binding IsItem}" />
                        <TextBlock Classes="nav-header" Text="{Binding Label}" Grid.ColumnSpan="2"
                                   VerticalAlignment="Center" IsVisible="{Binding IsHeader}" />
                        <!-- 右侧:分组头"+"添加入口(位于箭头左边)+ 折叠箭头。
                             右边距 -8 对齐原版(抵消行内边距贴边,原版 HeaderPlaylists 同款);
                             箭头仅可折叠分组头显示;E901(↓) 展开朝下,收起转 -90° 朝右 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"
                                    Margin="0,0,-8,0">
                            <Button Classes="nav-add-button" IsVisible="{Binding HasAddButton}"
                                    Command="{Binding $parent[views:NavigationPaneView].((vm:MainViewModel)DataContext).NavHeaderAddCommand}"
                                    CommandParameter="{Binding Key}"
                                    ToolTip.Tip="{Binding AddToolTip}">
                                <TextBlock Text="{DynamicResource IconAdd}" FontFamily="{DynamicResource LyricEaseIconsOriginal}"
                                           FontSize="20" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock Classes="nav-chevron"
                                       Text="{DynamicResource IconChevronDown}"
                                       FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="10"
                                       Margin="0,3,2,0" VerticalAlignment="Center"
                                       IsVisible="{Binding IsToggleGroup}"
                                       Classes.expanded="{Binding IsExpanded}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
