<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ALyricEase.ViewModels"
             xmlns:infra="using:ALyricEase.Infrastructure"
             x:Class="ALyricEase.Views.PersonalHomeView"
             x:DataType="vm:PersonalHomeViewModel" x:CompileBindings="True">
  <UserControl.Resources>
    <DataTemplate x:Key="AccountCard" x:DataType="vm:AccountPlatformViewModel">
      <Border Classes="identity-card">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="platform-mark" Width="4" Height="16" CornerRadius="2" />
              <TextBlock Text="{Binding PlatformName}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="已连接" Classes="secondary" IsVisible="{Binding IsLoggedIn}" />
            <TextBlock Grid.Column="1" Text="未登录" Classes="secondary" IsVisible="{Binding !IsLoggedIn}" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="64,*" ColumnSpacing="16">
            <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True"
                    Background="{DynamicResource AppSurfaceElevated}">
              <Grid>
                <TextBlock Text="{Binding AvatarLetter}" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image infra:ManagedCoverImage.Source="{Binding AvatarUrl}"
                       infra:ManagedCoverImage.DecodeSize="128" Stretch="UniformToFill" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
              <TextBlock Text="{Binding Username}" FontSize="22" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding IsLoggedIn}" />
              <TextBlock Text="连接你的音乐" FontSize="22" FontWeight="SemiBold" IsVisible="{Binding !IsLoggedIn}" />
              <TextBlock Text="{Binding MembershipName}" Classes="secondary" IsVisible="{Binding IsLoggedIn}" />
              <TextBlock Text="同步喜欢与收藏的歌单" Classes="secondary" IsVisible="{Binding !IsLoggedIn}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="2" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding AccountLevelText, StringFormat='账号等级  {0}'}" Classes="secondary"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding IsLoggedIn}" />
              <TextBlock Text="随时在这里找到你的音乐" Classes="secondary" TextWrapping="Wrap"
                         VerticalAlignment="Center" IsVisible="{Binding !IsLoggedIn}" />
              <Button Grid.Column="1" Classes="home-action" Content="查看主页" Click="OnProfileClick" MinHeight="32"
                      IsVisible="{Binding IsLoggedIn}" IsEnabled="{Binding HasUserId}"
                      AutomationProperties.Name="{Binding PlatformName, StringFormat='查看{0}个人主页'}" />
              <Button Grid.Column="1" Classes="home-action" Content="登录" Click="OnLoginClick" MinHeight="32"
                      IsVisible="{Binding !IsLoggedIn}" AutomationProperties.Name="{Binding PlatformName, StringFormat='登录{0}'}" />
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                       Classes="secondary" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="PlaylistCard" x:DataType="vm:PlaylistItemViewModel">
      <!-- 用户页(宽/中屏)同款卡:整卡一个按钮可点进歌单,▶/••• 悬停浮现在封面上。
           不设独立的"平台 + 操作"底行 —— 那行不可点却像可点,移动端用户会点空(2026-10-08 反馈) -->
      <Button Classes="playlist-card"
              Tapped="OnPlaylistTapped" KeyDown="OnPlaylistKeyDown" ContextRequested="OnPlaylistContextRequested"
              AutomationProperties.Name="{Binding Name, StringFormat='打开歌单 {0}'}" ToolTip.Tip="{Binding Name}">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="12">
          <Border Classes="playlist-art" CornerRadius="8"
                  ClipToBounds="True" Background="{DynamicResource ArtFallback}">
            <Grid>
              <TextBlock Classes="art-glyph" FontFamily="{DynamicResource LyricEaseIcons}"
                         FontSize="36" Foreground="{DynamicResource TextTertiary}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image infra:ManagedCoverImage.Source="{Binding CoverUrl}"
                     Stretch="UniformToFill" />
              <!-- 音源角标("全部平台"筛选):左上常显,避开悬停浮现的 ▶(左下) -->
              <!-- DecodeSize=0:角标不走 ManagedCoverImage 管线,显式置 0 免得被
                   "playlist-art 内 Image"的解码尺寸样式/注册默认值污染(探针按它统计) -->
              <Panel Classes="source-badge" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="6" Width="16" Height="16" IsHitTestVisible="False"
                     IsVisible="{Binding $parent[ItemsControl].((vm:PersonalHomeViewModel)DataContext).ShowSourceBadges}">
                <Image infra:ManagedCoverImage.DecodeSize="0" Source="{Binding SourceBadge}" Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
              </Panel>
              <Border Classes="card-mask" CornerRadius="8" Background="#FF000000" IsHitTestVisible="False" />
              <Button Classes="card-op" Theme="{StaticResource RowButtonTheme}" Click="OnPlayClick"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" ToolTip.Tip="播放歌单"
                      AutomationProperties.Name="{Binding Name, StringFormat='播放 {0}'}">
                <TextBlock Text="{DynamicResource IconPlayFilled}" FontSize="14"
                           FontFamily="{DynamicResource LyricEaseIconsFilled}" />
              </Button>
              <Button Classes="card-op" Theme="{StaticResource RowButtonTheme}" Click="OnMoreClick"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" ToolTip.Tip="更多操作"
                      AutomationProperties.Name="{Binding Name, StringFormat='{}{0}的更多操作'}">
                <TextBlock Text="{DynamicResource IconMore}" FontSize="14"
                           FontFamily="{DynamicResource LyricEaseIcons}" />
              </Button>
            </Grid>
          </Border>
          <StackPanel Classes="playlist-caption" Spacing="4">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding TrackCountText}" Classes="secondary" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
    <!-- 列表行(仿我的收藏页 user-row):48px 瓦片 + 标题/曲数,悬停浮现播放/更多 -->
    <DataTemplate x:Key="PlaylistRow" x:DataType="vm:PlaylistItemViewModel">
      <Button Classes="home-playlist-row" Tapped="OnPlaylistTapped" ContextRequested="OnPlaylistContextRequested">
        <Panel>
          <Border Classes="row-hover" />
          <Border Classes="row-pressed" />
          <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12" Margin="8">
            <Border Width="48" Height="48" CornerRadius="6" ClipToBounds="True" IsHitTestVisible="False"
                    Background="{DynamicResource ArtFallback}">
              <Image Stretch="UniformToFill"
                     infra:ManagedCoverImage.DecodeSize="96"
                     infra:ManagedCoverImage.Source="{Binding CoverUrl}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
              <TextBlock Classes="home-row-title" Text="{Binding Name}" />
              <TextBlock Classes="home-row-sub" Text="{Binding TrackCountText}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Classes="row-actions">
              <Button Classes="row-action" Theme="{StaticResource RowButtonTheme}" Click="OnPlayClick" ToolTip.Tip="播放歌单"
                      AutomationProperties.Name="{Binding Name, StringFormat='播放 {0}'}">
                <TextBlock Text="{DynamicResource IconPlayFilled}" FontSize="14"
                           FontFamily="{DynamicResource LyricEaseIconsFilled}" />
              </Button>
              <Button Classes="row-action" Theme="{StaticResource RowButtonTheme}" Click="OnMoreClick" ToolTip.Tip="更多操作"
                      AutomationProperties.Name="{Binding Name, StringFormat='{}{0}的更多操作'}">
                <TextBlock Text="{DynamicResource IconMore}" FontSize="14"
                           FontFamily="{DynamicResource LyricEaseIcons}" />
              </Button>
            </StackPanel>
          </Grid>
          <!-- 音源角标("全部平台"筛选下显示):钉在行左下角(个性推荐歌曲行同款,悬出封面圆角、
               不受封面裁剪);单一平台筛选整区同源,角标隐藏。DecodeSize=0:不走封面管线,
               免得被注册默认值/样式污染探针的解码尺寸统计 -->
          <Panel Classes="source-badge" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="2,0,0,2" Width="16" Height="16" IsHitTestVisible="False"
                 IsVisible="{Binding $parent[ItemsControl].((vm:PersonalHomeViewModel)DataContext).ShowSourceBadges}">
            <Image infra:ManagedCoverImage.DecodeSize="0" Source="{Binding SourceBadge}" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
          </Panel>
        </Panel>
      </Button>
    </DataTemplate>
    <!-- 喜欢区小卡:保留"72px 封面 + 标题/曲数 + 平台/操作底行"的原版样式,
         但整卡一个按钮可点、hover 整卡变色(旧版底行不可点、hover 只亮封面,2026-10-08 反馈) -->
    <DataTemplate x:Key="TastePlaylistCard" x:DataType="vm:PlaylistItemViewModel">
      <Button Classes="taste-card" Margin="0,0,12,12"
              Tapped="OnPlaylistTapped" KeyDown="OnPlaylistKeyDown" ContextRequested="OnPlaylistContextRequested"
              AutomationProperties.Name="{Binding Name, StringFormat='打开歌单 {0}'}" ToolTip.Tip="{Binding Name}">
        <Panel>
          <Border Classes="taste-card-bg" />
          <Grid RowDefinitions="Auto,Auto" RowSpacing="12" Margin="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Border Width="72" Height="72" CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource ArtFallback}">
              <Panel>
                <TextBlock Classes="art-glyph" FontFamily="{DynamicResource LyricEaseIcons}"
                           FontSize="36" Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- DecodeSize=144:72px 显示的 2×;taste 卡不走 playlist-art 的 360 样式 -->
                <Image infra:ManagedCoverImage.Source="{Binding CoverUrl}"
                       infra:ManagedCoverImage.DecodeSize="144" Stretch="UniformToFill" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TrackCountText}" Classes="secondary" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
            <TextBlock Text="{Binding SourceLabel}" Classes="secondary" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="card-action" Click="OnPlayClick" ToolTip.Tip="播放歌单"
                    AutomationProperties.Name="{Binding Name, StringFormat='播放 {0}'}">
              <TextBlock Text="{DynamicResource IconPlayFilled}" FontSize="14"
                         FontFamily="{DynamicResource LyricEaseIconsFilled}" />
            </Button>
            <Button Grid.Column="2" Classes="card-action" Click="OnMoreClick" ToolTip.Tip="更多操作"
                    AutomationProperties.Name="{Binding Name, StringFormat='{}{0}的更多操作'}">
              <TextBlock Text="{DynamicResource IconMore}" FontSize="14"
                         FontFamily="{DynamicResource LyricEaseIcons}" />
            </Button>
          </Grid>
        </Grid>
        </Panel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.home-action">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" /><Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem">
      <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBox.platform-filter > ListBoxItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.identity-card">
      <Setter Property="Padding" Value="24" /><Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ListCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.playlist-card">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ListCardBorder}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- 卡片容器(用户页同款):整卡透明按钮,封面 8 圆角自裁 -->
    <Style Selector="Button.playlist-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- 悬停浮现的封面操作按钮(左下 ▶ / 右下 •••,用户页同款):scrim 色系白图标。
         不复用 row-action —— 那套三态是"叠在行背景上的半透明叠层",直接盖封面观感反直觉。
         ⚠ 72px taste 小卡与窄屏 64px 单列上 32px 按钮会糊满封面且触屏无 hover,
         隐形却可命中 ⇒ 这两处整体隐藏(长按菜单里仍有播放/更多) -->
    <Style Selector="Button.card-op">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource CardOverlayButton}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.card-op:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardOverlayButtonHover}" />
    </Style>
    <Style Selector="Button.card-op:pressed">
      <Setter Property="Background" Value="{DynamicResource CardOverlayButtonPressed}" />
    </Style>
    <Style Selector="Button.playlist-card:pointerover Button.card-op">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.card-mask">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.playlist-card:pointerover Border.card-mask">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
    <Style Selector="Button.playlist-card:pressed Border.card-mask">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- 封面方图(用户页同款 200×200);窄屏容器查询压成 64 小瓦片 -->
    <Style Selector="Border.playlist-art">
      <Setter Property="Width" Value="200" /><Setter Property="Height" Value="200" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="StackPanel.playlist-caption">
      <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="TextBlock.art-glyph"><Setter Property="Text" Value="{DynamicResource IconMusicNote}" /></Style>
    <!-- 解码尺寸由样式供给而非局部值：taste 小卡（72px）与窄屏单列（64px）用小得多的图。
         360² 解码 0.5MB/张（QQ 图床向上取档 500² 是 1MB），144² 只有 84KB。
         ⚠ 同优先级"后声明者生效"：taste 覆盖必须写在基础规则之后，容器查询块在其后才会赢。 -->
    <Style Selector="Border.playlist-art Image">
      <Setter Property="infra:ManagedCoverImage.DecodeSize" Value="360" />
    </Style>
    <!-- 喜欢区小卡:整卡按钮。hover/pressed 不挂主题模板件(实测 :pointerover 只动了边框、
         背景没变),而是在内容底下垫自绘 Border(列表行 row-hover 同款模式),三态直接换它的背景,
         边框/圆角/背景完全自控。⚠ 三态必须齐全且 pressed 声明在 pointerover 之后 -->
    <Style Selector="Button.taste-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.taste-card-bg">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ListCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.taste-card:pointerover Border.taste-card-bg">
      <Setter Property="Background" Value="{DynamicResource UserSectionRowHover}" />
    </Style>
    <Style Selector="Button.taste-card:pressed Border.taste-card-bg">
      <Setter Property="Background" Value="{DynamicResource UserSectionRowPressed}" />
    </Style>
    <!-- 喜欢区底行的素色操作按钮(原版样式:透明底,Fluent 默认 hover):不用 row-action ——
         那套自带 RowButton 圆底,是给"叠在行背景上"的场景用的 -->
    <Style Selector="Button.card-action">
      <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- 列表行(我的收藏页 user-row 同构):悬停/按下高亮画在内容之下的独立 Border(与内容解耦,
         避免模板 CP 画刷过渡牵连整行重绘);row-actions 按住期间锁存显示,断 Avalonia 12
         捕获期 over 链清空 → 显隐 → 布局变化 → over 重算的反馈循环。三态必须齐全。 -->
    <Style Selector="Button.home-playlist-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.row-hover">
      <Setter Property="Background" Value="{DynamicResource UserSectionRowHover}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.home-playlist-row:pointerover Border.row-hover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.home-playlist-row:pressed Border.row-hover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.row-pressed">
      <Setter Property="Background" Value="{DynamicResource UserSectionRowPressed}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.home-playlist-row:pressed Border.row-pressed">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="StackPanel.row-actions">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.home-playlist-row:pointerover StackPanel.row-actions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.home-playlist-row:pressed StackPanel.row-actions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TextBlock.home-row-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.home-row-sub">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="UniformGrid.taste-grid"><Setter Property="Columns" Value="2" /></Style>
    <Style Selector="ContentControl.ne-account Border.platform-mark">
      <Setter Property="Background" Value="{DynamicResource LyricEaseRed}" />
    </Style>
    <Style Selector="ContentControl.qq-account Border.platform-mark">
      <Setter Property="Background" Value="#31C27C" />
    </Style>
    <Style Selector="UniformGrid.taste-grid"><Setter Property="Columns" Value="2" /></Style>
    <!-- 大图卡流式排列(WrapPanel,用户页 hcards 同款):固定 200 方图,间距由容器边距提供 -->
    <Style Selector="ItemsControl.pgrid > ContentPresenter">
      <Setter Property="Margin" Value="0,0,12,12" />
    </Style>
    <Style Selector="StackPanel.home-content"><Setter Property="Margin" Value="32,28,32,120" /></Style>
    <Style Selector="ContentControl.qq-account"><Setter Property="Grid.Column" Value="1" /></Style>
    <ContainerQuery Name="homeHost" Query="max-width:760">
      <Style Selector="ContentControl.ne-account"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
      <Style Selector="ContentControl.qq-account">
        <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
    </ContainerQuery>
    <ContainerQuery Name="homeHost" Query="max-width:500">
      <Style Selector="StackPanel.home-content"><Setter Property="Margin" Value="16,20,16,120" /></Style>
      <Style Selector="UniformGrid.taste-grid"><Setter Property="Columns" Value="1" /></Style>
      <Style Selector="Border.identity-card"><Setter Property="Padding" Value="16" /></Style>
      <Style Selector="Border.playlist-art">
        <Setter Property="Height" Value="64" /><Setter Property="Width" Value="64" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
      </Style>
      <Style Selector="Border.playlist-art Image">
        <Setter Property="infra:ManagedCoverImage.DecodeSize" Value="128" />
      </Style>
      <Style Selector="Button.card-op">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="StackPanel.playlist-caption">
        <Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroller" Classes="page-scroll" HorizontalScrollBarVisibility="Disabled"
                Container.Name="homeHost" Container.Sizing="Width">
    <StackPanel Classes="home-content" Spacing="24" MaxWidth="1240">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="6">
          <TextBlock Text="我的音乐" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ConnectionSummary}" Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="home-action" Content="管理帐号" Command="{Binding ManageAccountsCommand}" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
        <ContentControl Classes="ne-account" Content="{Binding Account.NetEase}" ContentTemplate="{StaticResource AccountCard}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <ContentControl Classes="qq-account" Content="{Binding Account.Qq}" ContentTemplate="{StaticResource AccountCard}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <ListBox Classes="platform-filter" SelectedIndex="{Binding SourceIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                 Padding="0" AutomationProperties.Name="筛选音乐平台">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBoxItem Content="全部" /><ListBoxItem Content="网易云" /><ListBoxItem Content="QQ 音乐" />
        </ListBox>
        <Button Grid.Column="1" Classes="home-action" Content="刷新" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsRefreshing}"
                AutomationProperties.Name="刷新两个平台的帐号与歌单" />
      </Grid>
      <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsRefreshing}"
                   infra:IndeterminateAnimationGate.IsActive="True" />
      <TextBlock Text="{Binding LibraryStatus}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Classes="secondary" />
      <StackPanel IsVisible="{Binding HasTaste}" Spacing="12">
        <TextBlock Text="我喜欢的音乐" Classes="section-title" />
        <ItemsControl Classes="taste" ItemsSource="{Binding TastePlaylists}" ItemTemplate="{StaticResource TastePlaylistCard}" Margin="0,0,-12,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Classes="taste-grid" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <StackPanel IsVisible="{Binding HasCreated}" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="创建的歌单" Classes="section-title" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ToggleButton Classes="filter-expander" IsChecked="{Binding CreatedIsListMode, Mode=TwoWay}"
                          ToolTip.Tip="切换列表 / 大图显示" AutomationProperties.Name="切换创建歌单的显示方式">
              <Grid>
                <TextBlock Text="{DynamicResource IconViewList}" FontSize="18"
                           FontFamily="{DynamicResource LyricEaseIconsOriginal}"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !CreatedIsListMode}" />
                <TextBlock Text="{DynamicResource IconViewGallery}" FontSize="18"
                           FontFamily="{DynamicResource LyricEaseIconsOriginal}"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding CreatedIsListMode}" />
              </Grid>
            </ToggleButton>
            <TextBlock Text="{Binding CreatedPlaylists.Count, StringFormat='{}{0} 个歌单'}" Classes="secondary" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Panel>
          <ItemsControl Classes="pgrid" ItemsSource="{Binding CreatedPlaylists}" ItemTemplate="{StaticResource PlaylistCard}"
                        IsVisible="{Binding !CreatedIsListMode}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding CreatedPlaylists}" ItemTemplate="{StaticResource PlaylistRow}"
                        IsVisible="{Binding CreatedIsListMode}" />
        </Panel>
      </StackPanel>
      <StackPanel IsVisible="{Binding HasCollected}" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="收藏的歌单" Classes="section-title" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ToggleButton Classes="filter-expander" IsChecked="{Binding CollectedIsListMode, Mode=TwoWay}"
                          ToolTip.Tip="切换列表 / 大图显示" AutomationProperties.Name="切换收藏歌单的显示方式">
              <Grid>
                <TextBlock Text="{DynamicResource IconViewList}" FontSize="18"
                           FontFamily="{DynamicResource LyricEaseIconsOriginal}"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !CollectedIsListMode}" />
                <TextBlock Text="{DynamicResource IconViewGallery}" FontSize="18"
                           FontFamily="{DynamicResource LyricEaseIconsOriginal}"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding CollectedIsListMode}" />
              </Grid>
            </ToggleButton>
            <TextBlock Text="{Binding CollectedPlaylists.Count, StringFormat='{}{0} 个歌单'}" Classes="secondary" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Panel>
          <ItemsControl Classes="pgrid" ItemsSource="{Binding CollectedPlaylists}" ItemTemplate="{StaticResource PlaylistCard}"
                        IsVisible="{Binding !CollectedIsListMode}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding CollectedPlaylists}" ItemTemplate="{StaticResource PlaylistRow}"
                        IsVisible="{Binding CollectedIsListMode}" />
        </Panel>
      </StackPanel>
      <Border Classes="identity-card" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="10" Margin="0,12">
          <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding EmptyDescription}" Classes="secondary" TextWrapping="Wrap" />
          <Button Classes="home-action" Content="管理帐号" Command="{Binding ManageAccountsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
