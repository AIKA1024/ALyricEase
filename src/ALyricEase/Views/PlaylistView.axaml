<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:b="using:ALyricEase.Infrastructure.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:PlaylistViewModel"
             mc:Ignorable="d" d:DesignWidth="930" d:DesignHeight="600"
             x:Class="ALyricEase.Views.PlaylistView">
  <UserControl.Styles>
    <Style Selector="Grid.hero-horizontal">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="StackPanel.hero-vertical">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".narrow Grid.hero-horizontal">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".narrow StackPanel.hero-vertical">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.login-card">
      <Setter Property="MaxWidth" Value="600" /><Setter Property="MinWidth" Value="400" />
    </Style>
    <Style Selector=".narrow Border.login-card">
      <Setter Property="MinWidth" Value="0" /><Setter Property="Width" Value="320" />
    </Style>
    <Style Selector="Grid.detail-shell">
      <Setter Property="Margin" Value="10,16,16,110" />
    </Style>
    <Style Selector="Border.playlist-hero">
      <Setter Property="Height" Value="300" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
      <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="20" />
    </Style>
    <!-- 小屏:上下堆叠内容比水平排更高,卡片高度随内容自增,最低 480;背景透明只留内容 -->
    <Style Selector=".narrow Border.playlist-hero">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinHeight" Value="480" />
      <Setter Property="Padding" Value="0,14" />
    </Style>
    <!-- 小屏:曲目行切换为个性推荐/每日歌曲同款紧凑行(封面+歌名+歌手·专辑按钮+播放/更多);
         主题自带定宽 400(每日列表两列布局用),此处重置为 NaN 让行撑满列表卡片 -->
    <Style Selector=".narrow ItemsControl.tracks views|TrackRow">
      <Setter Property="Theme" Value="{StaticResource TrackRowSearchTheme}" />
      <Setter Property="Width" Value="NaN" />
    </Style>
    <!-- 曲目列表:ItemsControl 无选中逻辑(不可选中);悬停高亮交给行内样式(共享 TrackRow),容器只留行间距 -->
    <Style Selector="ItemsControl.tracks">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ItemsControl.tracks > ContentPresenter">
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <!-- 滚动条底部留白:离底部 100(播放条高度),仿 UWP ScrollViewer 模板内 ScrollBar Margin -->
    <Style Selector="ScrollViewer.tracks-scroller ScrollBar">
      <Setter Property="Margin" Value="0,0,0,100" />
    </Style>
    <!-- 聚合歌单右上角齿轮设置按钮:32px 透明底,悬停浅底+teal 字形 -->
    <Style Selector="Button.hero-settings">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.hero-settings:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.hero-settings:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <ScrollViewer x:Name="PageScroller" Classes="tracks-scroller" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <i:Interaction.Behaviors>
        <b:SmoothWheelScrollBehavior />
      </i:Interaction.Behaviors>
      <Grid Classes="detail-shell" RowDefinitions="Auto,*" IsVisible="{Binding HasAnyLogin}">
        <!-- 未选中歌单(QQ 单独登录首次进入)时整卡隐藏,只留居中提示文案 -->
        <Border x:Name="HeroCard" Classes="playlist-hero" Grid.Row="0"
                IsVisible="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid>
            <!-- 宽/中屏：左右布局 -->
            <Grid x:Name="HeroLayout" Classes="hero-horizontal" ColumnDefinitions="260,*">
              <Border x:Name="HeroArt" Grid.Column="0" Width="260" Height="260" CornerRadius="8" ClipToBounds="True"
                      Background="{DynamicResource ArtFallback}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image Source="{Binding SelectedPlaylist.LargeCover}" Stretch="UniformToFill" />
              </Border>
              <StackPanel x:Name="HeroCopy" Grid.Column="1" Margin="20,0,10,0" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Name="HeroTitle" Text="{Binding SelectedPlaylist.Name}" FontSize="28" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" MaxLines="2" />
                <Button x:Name="HeroCreator" Content="{Binding CreatorName}" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        Foreground="{DynamicResource LyricEaseTeal}" FontSize="18" ToolTip.Tip="打开用户页（后续接入）" />
                <TextBlock Text="{Binding SelectedPlaylist.TrackCountText}" FontSize="16"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="{Binding SelectedPlaylist.Description}" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxLines="3"
                           IsVisible="{Binding SelectedPlaylist.HasDescription}" />
                <StackPanel x:Name="HeroActions" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Classes="primary" Content="▶ 播放全部" Command="{Binding PlayAllCommand}" Height="40"
                          Padding="18,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                  <Button Background="{DynamicResource LyricEaseRed}" Foreground="White" BorderThickness="0"
                          CornerRadius="4" Height="40" Padding="14,0" IsEnabled="False" ToolTip.Tip="心动模式将在播放队列阶段接入"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="♥" FontSize="17" /><TextBlock Text="心动模式" />
                    </StackPanel>
                  </Button>
                  <Button Width="40" Height="40" Padding="0" Background="{DynamicResource AppSurface}"
                          BorderThickness="1" BorderBrush="{DynamicResource AppBorder}" CornerRadius="4"
                          IsEnabled="False" ToolTip.Tip="更多操作将在后续阶段接入"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="•••" LetterSpacing="2" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- 小屏：上下布局 -->
            <!-- 小屏：上下布局(默认隐藏,由 .narrow 样式显示;不能写本地 IsVisible,本地值优先级高于样式) -->
            <StackPanel x:Name="HeroVertical" Classes="hero-vertical"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="8">
              <Border Width="220" Height="220" CornerRadius="8" ClipToBounds="True"
                      Background="{DynamicResource ArtFallback}" HorizontalAlignment="Center">
                <Image Source="{Binding SelectedPlaylist.LargeCover}" Stretch="UniformToFill" />
              </Border>
              <TextBlock Text="{Binding SelectedPlaylist.Name}" FontSize="24" FontWeight="Bold"
                         TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" />
              <Button Content="{Binding UserName}" HorizontalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Padding="0"
                      Foreground="{DynamicResource LyricEaseTeal}" FontSize="16" ToolTip.Tip="打开用户页（后续接入）" />
              <TextBlock Text="{Binding SelectedPlaylist.TrackCountText}" FontSize="14"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding SelectedPlaylist.Description}" FontSize="13"
                         Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxLines="3"
                         HorizontalAlignment="Center" TextAlignment="Center"
                         IsVisible="{Binding SelectedPlaylist.HasDescription}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Button Classes="primary" Content="▶ 播放全部" Command="{Binding PlayAllCommand}" Height="40"
                        Padding="18,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Button Background="{DynamicResource LyricEaseRed}" Foreground="White" BorderThickness="0"
                        CornerRadius="4" Height="40" Padding="14,0" IsEnabled="False" ToolTip.Tip="心动模式将在播放队列阶段接入"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="♥" FontSize="17" /><TextBlock Text="心动模式" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
            <!-- 聚合歌单右上角齿轮设置按钮:仅聚合页显示,悬浮于卡片右上角 -->
            <Button Classes="hero-settings" Command="{Binding OpenAggregateSettingsCommand}"
                    IsVisible="{Binding IsAggregate}" ToolTip.Tip="聚合歌单设置"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0">
              <TextBlock Text="&#xE917;" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16" />
            </Button>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <!-- 卡片本体(列表在其中) -->
          <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource ListCardBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="8,6">
            <!-- 外层 ScrollViewer(仿 UWP ListView 模板)直接包裹 ItemsControl + VirtualizingStackPanel -->

            <!-- 底部留白由 detail-shell 的底部 margin 提供(仿 UWP ScrollViewer 内容末尾留白) -->
            <ItemsControl x:Name="TracksList" Classes="tracks" ItemsSource="{Binding Tracks}"
                          ContainerPrepared="OnTrackContainerPreparing">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SongItemViewModel">
                  <views:TrackRow />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <!-- 卡片顶部内阴影:覆盖卡片内侧顶边(圆角贴合,Margin 1px 避开边框),不拦截点击 -->
          <Border IsHitTestVisible="False" Height="12" VerticalAlignment="Top" CornerRadius="8,8,0,0"
                  Margin="1,1,1,0" ZIndex="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#2E000000" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <!-- 卡片底部内阴影:与顶部对称,覆盖卡片内侧底边 -->
          <Border IsHitTestVisible="False" Height="12" VerticalAlignment="Bottom" CornerRadius="0,0,8,8"
                  Margin="1,0,1,1" ZIndex="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#2E000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>
        <TextBlock Text="请选择左侧歌单查看曲目" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Grid.Row="0" Grid.RowSpan="2"
                   IsVisible="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNull}}"
                   Foreground="{DynamicResource TextTertiary}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>