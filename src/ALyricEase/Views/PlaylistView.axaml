<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:controls="using:ALyricEase.Controls"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:PlaylistViewModel"
             mc:Ignorable="d" d:DesignWidth="930" d:DesignHeight="600"
             x:Class="ALyricEase.Views.PlaylistView">
  <UserControl.Styles>
    <Style Selector="Grid.hero-horizontal">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="StackPanel.hero-vertical">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".narrow Grid.hero-horizontal">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".narrow StackPanel.hero-vertical">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.login-card">
      <Setter Property="MaxWidth" Value="600" /><Setter Property="MinWidth" Value="400" />
    </Style>
    <Style Selector=".narrow Border.login-card">
      <Setter Property="MinWidth" Value="0" /><Setter Property="Width" Value="320" />
    </Style>
    <Style Selector="Grid.detail-shell">
      <Setter Property="Margin" Value="10,16,16,120" />
    </Style>
    <Style Selector="Border.playlist-hero">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
      <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="20" />
    </Style>
    <!-- 小屏:背景透明只留内容；高度完全由实际内容决定，折叠时不为筛选区预留空间。 -->
    <Style Selector=".narrow Border.playlist-hero">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0,14" />
    </Style>
    <!-- 小屏:曲目行切换为个性推荐/每日歌曲同款紧凑行(封面+歌名+歌手·专辑按钮+播放/更多);
         主题自带定宽 400(每日列表两列布局用),此处重置为 NaN 让行撑满列表卡片 -->
    <Style Selector=".narrow ItemsControl.tracks views|TrackRow">
      <Setter Property="Theme" Value="{StaticResource TrackRowSearchTheme}" />
      <Setter Property="Width" Value="NaN" />
    </Style>
    <!-- 曲目列表:ItemsControl 无选中逻辑(不可选中);悬停高亮交给行内样式(共享 TrackRow),容器只留行间距 -->
    <Style Selector="ItemsControl.tracks">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ItemsControl.tracks > ContentPresenter">
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <!-- 聚合歌单右上角齿轮设置按钮:32px 透明底,悬停浅底+teal 字形 -->
    <Style Selector="Button.hero-settings">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.hero-settings:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.hero-settings:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
    </Style>
    <Style Selector="Button.hero-action-more">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.hero-action-more /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.hero-action-more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.hero-action-more:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- 创建者按钮(两个 hero 变体共用):Fluent 2 subtle 芯片 —— 透明底、teal 前景,
         悬停/按下浮起微底色;点击进用户页(CreatorId=0 时禁用,如 QQ 歌单) -->
    <Style Selector="Button.creator-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.creator-chip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.creator-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
    </Style>
    <Style Selector="Button.creator-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfacePressed}" />
    </Style>
    <Style Selector="Button.creator-chip:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <ScrollViewer x:Name="PageScroller" Classes="tracks-scroller page-scroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="DetailShell" Classes="detail-shell" RowDefinitions="Auto,*"
            IsVisible="{Binding ShowPlaylistContent}">
        <!-- 未选中歌单(QQ 单独登录首次进入)时整卡隐藏,只留居中提示文案 -->
        <Border x:Name="HeroCard" Classes="playlist-hero" Grid.Row="0"
                IsVisible="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid RowDefinitions="Auto,Auto">
            <!-- 宽/中屏：左右布局 -->
            <Grid x:Name="HeroLayout" Classes="hero-horizontal" ColumnDefinitions="260,*">
              <Border x:Name="HeroArt" Grid.Column="0" Width="260" Height="260" CornerRadius="8" ClipToBounds="True"
                      Background="{DynamicResource ArtFallback}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image infra:ManagedCoverImage.DecodeSize="400"
                       infra:ManagedCoverImage.Source="{Binding SelectedPlaylist.CoverUrl}"
                       Stretch="UniformToFill" />
              </Border>
              <StackPanel x:Name="HeroCopy" Grid.Column="1" Margin="20,0,10,0" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Name="HeroTitle" Text="{Binding SelectedPlaylist.Name}" FontSize="28" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" MaxLines="2" />
                <!-- 创建者芯片(Fluent 2 subtle):点击进用户页;QQ 歌单等无创建者 id 时禁用 -->
                <Button x:Name="HeroCreator" Classes="creator-chip" Content="{Binding CreatorName}"
                        HorizontalAlignment="Left" Margin="-8,0"
                        Command="{Binding OpenCreatorCommand}" IsEnabled="{Binding CanOpenCreator}"
                        ToolTip.Tip="打开用户页" />
                <TextBlock Text="{Binding SelectedPlaylist.TrackCountText}" FontSize="16"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="{Binding SelectedPlaylist.Description}" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxLines="3"
                           IsVisible="{Binding SelectedPlaylist.HasDescription}" />
                <Grid x:Name="HeroActions" Margin="0,8,0,0" ColumnDefinitions="*,Auto" Height="36">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                    <Button Classes="play-all" Content="▶ 播放全部" Command="{Binding PlayAllCommand}"
                            CornerRadius="4" Padding="18,0" />
                    <Button Background="{DynamicResource LyricEaseRed}" Foreground="White" BorderThickness="0"
                            CornerRadius="4" Height="36" Padding="14,0" IsEnabled="False" ToolTip.Tip="心动模式将在播放队列阶段接入"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="♥" FontSize="17" /><TextBlock Text="心动模式" />
                      </StackPanel>
                    </Button>
                    <Button Classes="hero-action-more" IsVisible="{Binding CanShareCurrentPlaylist}"
                            ToolTip.Tip="更多操作" AutomationProperties.Name="更多歌单操作">
                      <TextBlock Text="{DynamicResource IconMore}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" ShowMode="Transient">
                          <MenuItem Header="分享" Click="OnSharePlaylistClick">
                            <MenuItem.Icon>
                              <TextBlock Text="{DynamicResource IconShare}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="复制链接" Click="OnCopyPlaylistLinkClick">
                            <MenuItem.Icon>
                              <TextBlock Text="{DynamicResource IconCopyLink}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <ToggleButton Grid.Column="1" Classes="filter-expander"
                                IsChecked="{Binding Filters.IsExpanded, Mode=TwoWay}"
                                ToolTip.Tip="展开或收起排序和筛选"
                                AutomationProperties.Name="展开或收起歌曲排序和筛选">
                    <TextBlock Classes="filter-chevron" Text="{DynamicResource IconChevronDown}"
                               FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="11"
                               RenderTransformOrigin="50%,50%" />
                  </ToggleButton>
                </Grid>
              </StackPanel>
            </Grid>

            <!-- 小屏：上下布局 -->
            <!-- 小屏：上下布局(默认隐藏,由 .narrow 样式显示;不能写本地 IsVisible,本地值优先级高于样式) -->
            <StackPanel x:Name="HeroVertical" Classes="hero-vertical"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="8">
              <Border Width="220" Height="220" CornerRadius="8" ClipToBounds="True"
                      Background="{DynamicResource ArtFallback}" HorizontalAlignment="Center">
                <Image infra:ManagedCoverImage.DecodeSize="400"
                       infra:ManagedCoverImage.Source="{Binding SelectedPlaylist.CoverUrl}"
                       Stretch="UniformToFill" />
              </Border>
              <TextBlock Text="{Binding SelectedPlaylist.Name}" FontSize="24" FontWeight="Bold"
                         TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" />
              <!-- 创建者芯片(Fluent 2 subtle,小屏居中):点击进用户页;无创建者 id 时禁用 -->
              <Button Classes="creator-chip" Content="{Binding CreatorName}" HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center" Margin="-8,0"
                      Command="{Binding OpenCreatorCommand}" IsEnabled="{Binding CanOpenCreator}"
                      ToolTip.Tip="打开用户页" />
              <TextBlock Text="{Binding SelectedPlaylist.TrackCountText}" FontSize="14"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding SelectedPlaylist.Description}" FontSize="13"
                         Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxLines="3"
                         HorizontalAlignment="Center" TextAlignment="Center"
                         IsVisible="{Binding SelectedPlaylist.HasDescription}" />
              <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto" Height="36">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button Classes="play-all" Content="▶ 播放全部" Command="{Binding PlayAllCommand}"
                          CornerRadius="4" Padding="18,0" />
                  <Button Background="{DynamicResource LyricEaseRed}" Foreground="White" BorderThickness="0"
                          CornerRadius="4" Height="36" Padding="14,0" IsEnabled="False" ToolTip.Tip="心动模式将在播放队列阶段接入"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="♥" FontSize="17" /><TextBlock Text="心动模式" />
                    </StackPanel>
                  </Button>
                  <Button Classes="hero-action-more" IsVisible="{Binding CanShareCurrentPlaylist}"
                          ToolTip.Tip="更多操作" AutomationProperties.Name="更多歌单操作">
                    <TextBlock Text="{DynamicResource IconMore}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="16" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight" ShowMode="Transient">
                        <MenuItem Header="分享" Click="OnSharePlaylistClick">
                          <MenuItem.Icon>
                            <TextBlock Text="{DynamicResource IconShare}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制链接" Click="OnCopyPlaylistLinkClick">
                          <MenuItem.Icon>
                            <TextBlock Text="{DynamicResource IconCopyLink}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
                <ToggleButton Grid.Column="1" Classes="filter-expander"
                              IsChecked="{Binding Filters.IsExpanded, Mode=TwoWay}"
                              ToolTip.Tip="展开或收起排序和筛选"
                              AutomationProperties.Name="展开或收起歌曲排序和筛选">
                  <TextBlock Classes="filter-chevron" Text="{DynamicResource IconChevronDown}"
                             FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="11"
                             RenderTransformOrigin="50%,50%" />
                </ToggleButton>
              </Grid>
            </StackPanel>
            <!-- 聚合歌单右上角齿轮设置按钮:仅聚合页显示,悬浮于卡片右上角 -->
            <Button Classes="hero-settings" Command="{Binding OpenAggregateSettingsCommand}"
                    IsVisible="{Binding IsAggregate}" ToolTip.Tip="聚合歌单设置"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0">
              <TextBlock Text="{DynamicResource IconSettings}" FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="16" />
            </Button>

            <controls:TrackCollectionSortAndFilterControl Grid.Row="1" Margin="0,16,0,0"
                                                           DataContext="{Binding Filters}"
                                                           IsVisible="{Binding IsExpanded}" />
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <!-- 卡片本体(列表在其中) -->
          <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource ListCardBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="8,6">
            <!-- 外层 ScrollViewer(仿 UWP ListView 模板)直接包裹 ItemsControl + VirtualizingStackPanel -->
            <Grid RowDefinitions="Auto,Auto">
              <!-- 底部留白由 detail-shell 的底部 margin 提供(仿 UWP ScrollViewer 内容末尾留白) -->
              <ItemsControl x:Name="TracksList" Classes="tracks" ItemsSource="{Binding Tracks}"
                            ContainerPrepared="OnTrackContainerPreparing">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SongItemViewModel">
                    <views:TrackRow />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Grid.Row="1" Margin="12,10" Spacing="7" IsVisible="{Binding IsLoadingMore}">
                <!-- 最小化时停掉循环动画:框架不会替你看窗口状态,详 IndeterminateAnimationGate -->
                <ProgressBar Height="3" IsIndeterminate="True"
                             infra:IndeterminateAnimationGate.IsActive="True" />
                <TextBlock Text="{Binding LoadingMoreText}" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextTertiary}" />
              </StackPanel>
            </Grid>
          </Border>
          <!-- 卡片顶部内阴影:覆盖卡片内侧顶边(圆角贴合,Margin 1px 避开边框),不拦截点击 -->
          <Border IsHitTestVisible="False" Height="12" VerticalAlignment="Top" CornerRadius="8,8,0,0"
                  Margin="1,1,1,0" ZIndex="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#2E000000" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <!-- 卡片底部内阴影:与顶部对称,覆盖卡片内侧底边 -->
          <Border IsHitTestVisible="False" Height="12" VerticalAlignment="Bottom" CornerRadius="0,0,8,8"
                  Margin="1,0,1,1" ZIndex="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#2E000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>
        <TextBlock Text="请选择左侧歌单查看曲目" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Grid.Row="0" Grid.RowSpan="2"
                   IsVisible="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNull}}"
                   Foreground="{DynamicResource TextTertiary}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
