<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             x:Class="ALyricEase.Views.ProxySettingsDialogView">
    <!-- 应用网络代理弹窗(WinUI3 ContentDialog 式窗口内弹层,与 AudioDeviceDialogView 同款):
         模式下拉 + 手动端点;草稿态,点"保存"才落盘并切换全局出口,Esc/取消丢弃改动。
         几何对齐 Fluent 2 的 ContentDialog:MinWidth 320~360 / MaxWidth 548 / 内边距 24 /
         标题下间距 12 / 按钮间距 8;标题与按钮固定,中间内容可滚动(最小窗口 560 下按钮不被裁)。
         模式用 ComboBox 而非单选组:选项只有三个且名称自明,下拉最省高度;
         需要"每项带说明"时再回到单选组(取舍见 docs/network-proxy.md §六)。 -->
    <Grid x:Name="Root">
        <!-- 烟雾层(WinUI ContentDialog smoke fill,不支持点击空白关闭) -->
        <Panel Background="#99000000" />
        <!-- 外层 Grid 铺满内容区并留 24 边距:Margin 已在父级,子元素的可用高度就是它的 Bounds,
             于是弹窗高度上限能跟着窗口走,不用写死像素(小窗口下靠内部 ScrollViewer 滚动)。 -->
        <Grid x:Name="ModalHost" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" Margin="24">
            <!-- 背景与内容分层:切到"手动配置"时卡片高度变化,只让背景层做合成缩放伸展,
                 文字保持正常比例(与 DownloadSongDialogView 同一套做法,避免逐帧改 Height 触发布局)。
                 DialogCard 这个外壳同时还是 ModalVisibilityTransition 开合缩放(1.05)的目标。 -->
            <Border MaxWidth="520" MinWidth="360"
                    MaxHeight="{Binding #ModalHost.Bounds.Height, FallbackValue=520}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    x:Name="DialogCard">
                <Grid>
                    <Border x:Name="DialogSurface" CornerRadius="8"
                            Background="{DynamicResource AppSurface}"
                            BorderThickness="1" BorderBrush="{DynamicResource AppBorderStrong}"
                            BoxShadow="0 32 64 #66000000" IsHitTestVisible="False" />
                    <Border Padding="24" BorderThickness="1">
                        <Grid x:Name="DialogContent" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                            <StackPanel Grid.Row="0" Spacing="4">
                                <TextBlock Text="应用网络代理" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="只影响本应用的网络请求(接口、封面、更新检查);正在播放的音频不受影响。"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                <StackPanel Spacing="12">
                                    <!-- 模式:ComboBox 单选。Fluent 的下拉项固定 32px 单行,放不下每项说明,
                                         所以只列名称。标签在上、控件撑满 —— 与下方"代理服务器/端口"同一套读法
                                         (标签在左会让同一个弹窗里出现两种标签风格,中间还空一大段)。 -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="代理模式" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <ComboBox Height="32" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ProxyModeOptions}"
                                                  SelectedIndex="{Binding ProxyModeIndex, Mode=TwoWay}" />
                                    </StackPanel>

                                    <!-- 手动配置区:仅"手动配置"时展开。显隐变化会撑高/压矮卡片,
                                         code-behind 监听它的 IsVisibleProperty 触发卡片伸展动画。 -->
                                    <StackPanel x:Name="ManualSection" Spacing="12" IsVisible="{Binding IsManualProxy}">
                                        <Grid ColumnDefinitions="*,12,110">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="代理服务器" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBox Text="{Binding ProxyHost, Mode=TwoWay}" Watermark="127.0.0.1"
                                                         Height="32" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="端口" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBox Text="{Binding ProxyPortText, Mode=TwoWay}" Watermark="7890"
                                                         Height="32" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,12,*">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="用户名(可选)" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBox Text="{Binding ProxyUsername, Mode=TwoWay}" Height="32" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="密码(可选)" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBox Text="{Binding ProxyPassword, Mode=TwoWay}" PasswordChar="●"
                                                         Height="32" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ProxyStatusText}" FontSize="12" TextWrapping="Wrap"
                                               IsVisible="{Binding ProxyStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 命令区上边距比内容行距多一点(12 + 6),让"操作"和"表单"分开;Fluent 的
                                 ContentDialog 是 24,这里内容矮,取 18 更紧凑 -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                <Button Content="测试连接" MinWidth="96" Height="32"
                                        IsEnabled="{Binding !IsProxyTesting}"
                                        Command="{Binding TestProxyCommand}" />
                                <Button Grid.Column="2" Content="取消" MinWidth="96" Height="32"
                                        HotKeyManager.HotKey="Escape"
                                        Command="{Binding $parent[views:ProxySettingsDialogView].((vm:MainViewModel)DataContext).CloseProxySettingsDialogCommand}" />
                                <Button Grid.Column="3" Classes="accent" Content="保存" MinWidth="96" Height="32"
                                        Command="{Binding SaveProxySettingsCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
