<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ALyricEase.Views.QqCaptchaWindow"
        Title="QQ 音乐安全验证"
        Width="432" Height="640" MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurface}"
        AutomationProperties.Name="QQ 音乐安全验证窗口">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部说明:验证进度与自动重发逻辑 -->
        <Border Grid.Row="0" Padding="20,16,20,12"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="3">
                <TextBlock Text="完成滑块安全验证" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                           Text="完成验证后会自动重新发送短信验证码；若未自动发送，请点击下方按钮。" />
            </StackPanel>
        </Border>

        <!-- 腾讯防水墙 securityURL:原生 WebView2(Win)/系统 WebView(Android) -->
        <NativeWebView x:Name="WebView" Grid.Row="1" />

        <!-- 底部操作:主按钮手动补发;浏览器入口兜底(WebView 环境被风控拒绝时用) -->
        <Border Grid.Row="2" Padding="20,14"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="OpenBrowserButton" Content="在系统浏览器中打开"
                        Height="36" Click="OnOpenBrowserClick"
                        AutomationProperties.Name="在系统浏览器中打开安全验证页面" />
                <Button x:Name="ResendButton" Classes="accent" Content="完成验证，重新发送验证码"
                        MinWidth="200" Height="36" Click="OnResendClick"
                        AutomationProperties.Name="完成验证后重新发送短信验证码" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
