<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="using:ALyricEase.Infrastructure"
             xmlns:b="using:ALyricEase.Infrastructure.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
              xmlns:vm="using:ALyricEase.ViewModels"
              xmlns:views="using:ALyricEase.Views"
             xmlns:controls="using:ALyricEase.Controls"
             x:DataType="vm:RecommendViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ALyricEase.Views.RecommendView">
  <UserControl.DataTemplates>
    <!-- 歌单/歌曲卡片(200x250):封面 + 右上播放量角标 + 标题/副标题 + 悬停黑遮罩(原版 ShadowMaskBorder)。
         整卡为按钮(RowButtonTheme,同歌手页专辑卡):歌单卡点击进歌单页,歌曲卡点击播放 -->
    <DataTemplate x:DataType="vm:RecommendCardViewModel">
      <Button Classes="card" Theme="{StaticResource RowButtonTheme}" Command="{Binding OpenCommand}"
              CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,50">
          <Border Classes="card-art" Grid.Row="0" CornerRadius="8" Background="{DynamicResource ArtFallback}"
                  ClipToBounds="True">
            <Grid>
              <!-- 过渡结束才提交 URL；可见 Image 自己持有位图租约，离树即释放。 -->
              <Image infra:ManagedCoverImage.DecodeSize="240"
                     infra:ManagedCoverImage.Source="{Binding DisplayCoverUrl}"
                     Stretch="UniformToFill" />
              <Border Classes="play-count-badge" IsVisible="{Binding HasPlayCount}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5,1" CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIconsFilled}"
                             FontSize="12" Foreground="White" />
                  <TextBlock Text="{Binding PlayCountText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <StackPanel Grid.Row="1" Margin="4,6,4,0" Spacing="1">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
          <Border Classes="card-mask" Grid.RowSpan="2" CornerRadius="8" Background="#FF000000" IsHitTestVisible="False" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="StackPanel#PageContent">
      <Setter Property="Margin" Value="48,0,32,120" />
    </Style>
    <!-- 卡片:固定尺寸(断点缩放由 compact/narrow 覆盖),整卡为透明按钮,悬停/按下用黑遮罩反馈 -->
    <Style Selector="Button.card">
      <Setter Property="Width" Value="200" /><Setter Property="Height" Value="250" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.card-art">
      <Setter Property="Width" Value="200" /><Setter Property="Height" Value="200" />
    </Style>
    <!-- 悬停/按下遮罩:原版 ShadowMaskBorder,黑遮罩 opacity 0 → 0.2(悬停) → 0.4(按下),200ms -->
    <Style Selector="Border.card-mask">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.card:pointerover Border.card-mask">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
    <Style Selector="Button.card:pressed Border.card-mask">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- 播放量角标:原版 acrylic chip(右上,圆角4,深色半透明) -->
    <Style Selector="Border.play-count-badge">
      <Setter Property="Background" Value="#59000000" />
    </Style>
    <!-- 音源角标:仅本页(每日歌曲推荐混排网易云+QQ)悬停行时浮现;基础隐藏/过渡在 TrackRow.axaml -->
    <Style Selector="views|TrackRow:pointerover Panel.source-badge">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- 触控模式(TrackRow.touch 类)压制 hover 显现:音源角标恒隐 -->
    <Style Selector="views|TrackRow.touch Panel.source-badge">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- 每日歌曲行的悬停高亮/操作浮现/圆形按钮等样式已统一到共享 TrackRow 控件(Views/TrackRow.axaml) -->
    <Style Selector=".compact StackPanel#PageContent">
      <Setter Property="Margin" Value="28,0,24,120" />
    </Style>
    <Style Selector=".compact Button.card">
      <Setter Property="Width" Value="168" /><Setter Property="Height" Value="218" />
    </Style>
    <Style Selector=".compact Border.card-art">
      <Setter Property="Width" Value="168" /><Setter Property="Height" Value="168" />
    </Style>
    <!-- ⚠ 底边必须是 PlayerBarReserve(120),和其它断点一样 —— 内容根 margin 是页面唯一的
         底部留白来源,少一档小屏滚到底时最后一行就压在播放条下面(2026-10-03 用户报
         "个性推荐的自动留白失效了";这条曾是 16,0,12,0,宽/中屏 120 只有小屏漏了)。
         回归线:Headless 的 pagereserve 探针(三个页面 × 三个断点)。 -->
    <Style Selector=".narrow StackPanel#PageContent">
      <Setter Property="Margin" Value="16,0,12,120" />
    </Style>
    <Style Selector=".narrow Button.card">
      <Setter Property="Width" Value="156" /><Setter Property="Height" Value="206" />
    </Style>
    <Style Selector=".narrow Border.card-art">
      <Setter Property="Width" Value="156" /><Setter Property="Height" Value="156" />
    </Style>

    <!-- 横向虚拟化面板(VirtualizingStackPanel)无 Spacing:卡片间距改由容器右边距提供(SongGridView 同款做法) -->
    <Style Selector="ItemsControl.hcards > ContentPresenter">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="96,*">
    <Grid Grid.Row="0" Margin="48,0,32,0">
      <TextBlock Text="个性推荐" Classes="page-title" VerticalAlignment="Center" />
    </Grid>
    <ScrollViewer Grid.Row="1" Classes="recommend-scroller page-scroll"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="PageContent" Spacing="62">
        <!-- 区块间距用 ItemsPanel 的 StackPanel.Spacing(62,与各内容页 Spacing 统一值一致):
             所有区块在一个 ItemsControl 里,PageContent 的 Spacing 作用不到它们之间;
             用 Spacing 而非项模板 Margin 的原因:Margin 会在最后一个区块后再垫一份,
             与页面根的底部播放条预留(120)叠加成双份(实测猜你喜欢下方间距偏大) -->
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="62" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecommendSectionViewModel">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Title}" Classes="section-title" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="play-all" Command="{Binding PlayAllCommand}"
                          IsVisible="{Binding HasPlayAll}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIconsFilled}"
                                 FontSize="14" />
                      <TextBlock Text="播放全部" FontSize="14" />
                    </StackPanel>
                  </Button>
                </Grid>
                <!-- 区块内容:两种面板按 IsBordered 互斥显隐 —— 每日=SongGridView 圆角容器,其余=横向单行。
                     隐藏面板不参与布局(IsVisible=false 跳过测量)。 -->
                <Grid>
                  <!-- 每日歌曲推荐:共享容器控件(Controls/SongGridView),歌手页热门歌曲同款 -->
                  <controls:SongGridView IsVisible="{Binding IsBordered}" ItemsSource="{Binding Items}" />
                  <!-- 其余区块:单行横向滚动,无容器;滚动条底部 Padding 留 14px,避免压住卡片标题 -->
                  <ScrollViewer IsVisible="{Binding IsBordered, Converter={x:Static BoolConverters.Not}}"
                                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                Padding="0,0,0,14">
                    <i:Interaction.Behaviors>
                      <b:CtrlHorizontalWheelBehavior />
                    </i:Interaction.Behaviors>
                    <ItemsControl Classes="hcards" ItemsSource="{Binding Items}" ContainerPrepared="OnItemContainerPrepared">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <!-- 横向虚拟化:只实化视口及 CacheLength 缓冲内的卡片,封面经 ContainerPrepared 按需加载 -->
                          <VirtualizingStackPanel Orientation="Horizontal" CacheLength="0.5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
