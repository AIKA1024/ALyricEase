<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ALyricEase.Views"
             xmlns:vm="using:ALyricEase.ViewModels"
             x:DataType="vm:SettingsViewModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="1200"
             x:Class="ALyricEase.Views.SettingsView">
  <!-- 设置页(参考网易云 UWP 设置):分区标题 + 逐项卡片(图标/标题/副标题 + 右侧控件)。
       外观/交互/播放/网络/存储/关于;主题下拉即时切换全局 RequestedThemeVariant。 -->
  <UserControl.Styles>
    <!-- 设置卡片 -->
    <Style Selector="Border.setting-card">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <!-- 卡片行内左侧图标 -->
    <Style Selector="TextBlock.setting-icon">
      <Setter Property="FontFamily" Value="{DynamicResource LyricEaseIcons}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- 行标题 -->
    <Style Selector="TextBlock.setting-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- 缓存上限在窄屏分两行，避免标题和帮助按钮被数值输入框挤压。 -->
    <Style Selector="Grid.cache-limit-row > StackPanel.cache-limit-editor">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Grid.cache-limit-row.compact > StackPanel.cache-limit-editor">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <!-- "关于该选项"青色下划线链接(悬停提示说明) -->
    <Style Selector="TextBlock.about-link">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,8,0" />
    </Style>
    <!-- 分区标题 -->
    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Margin" Value="0,28,0,10" />
    </Style>
    <!-- 卡片内普通按钮(选择设备/代理设置等) -->
    <Style Selector="Border.setting-card Button.setting-action">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- 开源项目链接:对齐原版 LyricEase 的自定义 HyperlinkButton 主题,而不是 WinUI 默认样式。
         原版在其 Generic.xaml 合并的 Buttons.xaml 里给 HyperlinkButton 下了隐式 Style
         (shell_xaml/Buttons.xaml:1186):Padding="4"(四边)、不设 FontSize ⇒ 走默认 14、
         CornerRadius=4、Foreground=AccentTextFillColorPrimary、悬停/按下换
         AccentTextFillColorSecondary/Tertiary 并叠 SubtleFillColorSecondary/Tertiary 淡底。
         WinUI 默认的 ButtonPadding(11,5,11,6)+13 号字会做出一个更宽、字更小的浅底方块,
         和原版胶囊明显不同。另需压掉 Fluent 主题自带、原版没有的两处:① 常驻下划线;
         ② 按下 scale(0.98)。 -->
    <Style Selector="HyperlinkButton.link">
      <!-- TextDecorations 没有 "None" 字面量(只认 underline/strikethrough/overline/baseline),清空只能给 null -->
      <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource LyricEaseTeal}" />
    </Style>
    <!-- WinUI 的 AccentTextFillColorSecondary/Tertiary 是"悬停变一档、按下再变一档",
         取值沿用本项目播放全部按钮那套 teal 梯度(暗色更亮、亮色更暗) -->
    <Style Selector="HyperlinkButton.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource LinkForegroundPointerOver}" />
    </Style>
    <Style Selector="HyperlinkButton.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource LinkForegroundPressed}" />
    </Style>
    <!-- 设置卡片式 Expander:外观与 setting-card 一致,展开箭头/动画用内置实现 -->
    <Style Selector="Expander.setting-expander">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- 展开内容容器(#ExpanderContent)不带描边:主题默认画刷有可见描边,且 BorderThickness 被
         方向样式(:down 等,StyleTrigger 优先级)按 DynamicResource 改写 ⇒ 用同伪类把粗细压成 0 -->
    <Style Selector="Expander.setting-expander:down /template/ Border#ExpanderContent">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 行头整行是内置的展开切换钮:底色走主题键 SettingsExpanderHeader(暗=#242424 对齐原版)。
         底色写在 ToggleButton 上经模板 TemplateBinding 生效;主题在 :pointerover/:pressed
         以 StyleTrigger 优先级改写 Border#ToggleButtonBackground,必须用同级伪类样式压回 -->
    <Style Selector="Expander.setting-expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{DynamicResource SettingsExpanderHeader}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Expander.setting-expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource SettingsExpanderHeader}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Expander.setting-expander /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource SettingsExpanderHeader}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- 右侧箭头块:hover/pressed 底色只随行头状态变(主题键 HeaderHover/HeaderPressed),默认与行头同色;
         缩放挂在 Border 的 RenderTransform 上 —— 箭头 Path 的 RenderTransform 被展开旋转动画占用,不能碰 -->
    <Style Selector="Expander.setting-expander /template/ Border#ExpandCollapseChevronBorder">
      <Setter Property="Background" Value="{DynamicResource SettingsExpanderHeader}" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(0.7)" />
    </Style>
    <Style Selector="Expander.setting-expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ExpandCollapseChevronBorder">
      <Setter Property="Background" Value="{DynamicResource SettingsExpanderHeaderHover}" />
    </Style>
    <Style Selector="Expander.setting-expander /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ExpandCollapseChevronBorder">
      <Setter Property="Background" Value="{DynamicResource SettingsExpanderHeaderPressed}" />
    </Style>
    <!-- 展开指示 chevron:展开时旋转 180° 朝上(与侧栏分组箭头同款过渡) -->
    <Style Selector="TextBlock.setting-chevron">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.setting-chevron.expanded">
      <Setter Property="RenderTransform" Value="rotate(-180deg)" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="page-scroll">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="28,16,24,120">

      <TextBlock Text="设置" FontSize="26" FontWeight="Bold" Margin="0,0,0,4"
                 Foreground="{DynamicResource TextPrimary}" />

      <!-- ============ 外观 ============ -->
      <TextBlock Classes="section-header" Text="外观" />

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconPalette}" />
          <TextBlock Grid.Column="1" Classes="setting-title" Text="主题" />
          <ComboBox Grid.Column="2" MinWidth="190" Height="32" VerticalAlignment="Center"
                    ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}" />
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconLanguage}" />
          <TextBlock Grid.Column="1" Classes="setting-title" Text="语言" />
          <ComboBox Grid.Column="2" MinWidth="190" Height="32" VerticalAlignment="Center"
                    ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex}" />
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconPerformance}" />
          <TextBlock Grid.Column="1" Classes="setting-title" Text="性能与体验" />
          <ComboBox Grid.Column="2" MinWidth="190" Height="32" VerticalAlignment="Center"
                    ItemsSource="{Binding PerformanceOptions}" SelectedIndex="{Binding PerformanceIndex}" />
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconPalette}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Classes="setting-title" Text="动态背景" />
            <TextBlock Text="在播放详情界面显示动态背景效果" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" IsChecked="{Binding DynamicBackground, Mode=TwoWay}"
                        OnContent="" OffContent="" VerticalAlignment="Center"
                        AutomationProperties.Name="播放详情动态背景" />
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconDesktop}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Classes="setting-title" Text="兼容的视觉效果" />
            <TextBlock Classes="about-link" Text="关于该选项" ToolTip.Tip="在部分低端设备或驱动上,复杂动效可能导致卡顿;关闭后改用更保守的绘制方式。" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding CompatibilityVisualText}" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            <ToggleSwitch IsChecked="{Binding CompatibilityVisual}" OnContent="" OffContent="" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ 交互 ============ -->
      <TextBlock Classes="section-header" Text="交互" />

      <StackPanel IsVisible="{Binding DesktopSettingsSupported}" Spacing="8" Margin="0,0,0,8">
        <Border Classes="setting-card">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="setting-title" Text="开机自启" />
              <TextBlock Text="登录 Windows 后自动启动 ALyricEase" FontSize="12"
                         TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock IsVisible="{Binding HasStartupHint}" Text="{Binding StartupHint}"
                         FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartAtLogin, Mode=TwoWay}"
                          VerticalAlignment="Center" OnContent="" OffContent=""
                          AutomationProperties.Name="开机自启" />
          </Grid>
        </Border>
        <Border Classes="setting-card">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="setting-title" Text="关闭主窗口时" />
              <TextBlock Text="最小化到托盘后继续播放，可从托盘恢复窗口" FontSize="12"
                         TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
            <ComboBox Grid.Column="1" MinWidth="150" Height="32" VerticalAlignment="Center"
                      ItemsSource="{Binding CloseBehaviorOptions}"
                      SelectedIndex="{Binding CloseBehaviorIndex, Mode=TwoWay}"
                      AutomationProperties.Name="关闭主窗口时的行为" />
          </Grid>
        </Border>
      </StackPanel>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconHeart}" />
          <TextBlock Grid.Column="1" Classes="setting-title" Text="歌曲行的播放与喜欢按钮互换位置" />
          <ToggleSwitch Grid.Column="2" IsChecked="{Binding SwapPlayAndLikeOnRows}" OnContent="" OffContent="" />
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconKeyboard}" />
          <TextBlock Grid.Column="1" Classes="setting-title" Text="键盘快捷键" />
          <Button Grid.Column="2" Classes="setting-action" Content="编辑设置"
                  Command="{Binding EditHotkeysCommand}" />
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconTv}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="setting-title" Text="桌面歌词" />
            <TextBlock Text="桌面歌词功能开发中,将在后续版本提供。" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,12,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ 播放 ============ -->
      <TextBlock Classes="section-header" Text="播放" />

      <!-- 音频输出设备:原版交互 = 右侧"选择设备"按钮打开模态弹窗选择;
           提示行(不支持/设备回退/切换失败)只在该有话可说时出现 -->
      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconVolume}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Classes="setting-title" Text="音频输出设备" />
            <TextBlock IsVisible="{CompiledBinding HasAudioDeviceHint}"
                       Text="{CompiledBinding AudioDeviceHint}"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Classes="setting-action" Content="选择设备"
                  IsVisible="{CompiledBinding AudioDeviceSupported}"
                  Command="{Binding OpenAudioDeviceDialogCommand}" />
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconMusicNote}" />
          <TextBlock Grid.Column="1" Classes="setting-title" Text="音频质量" />
          <ComboBox Grid.Column="2" MinWidth="190" Height="32" VerticalAlignment="Center"
                    ToolTip.Tip="同一档位会按当前歌曲的音乐平台自动映射"
                    ItemsSource="{CompiledBinding AudioQualityOptions}"
                    SelectedIndex="{CompiledBinding AudioQualityIndex, Mode=TwoWay}" />
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconArrowSwap}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Classes="setting-title" Text="传统播放控制" />
            <TextBlock Classes="about-link" Text="关于该选项"
                       ToolTip.Tip="启用后单击列表行立即播放并清空队列,双击追加到队列(旧版播放器行为);关闭时保持当前行为。" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding LegacyPlaybackControlText}" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            <ToggleSwitch IsChecked="{Binding LegacyPlaybackControl}" OnContent="" OffContent="" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <!-- VerticalAlignment=Center 在这里而不是内层行上:StackPanel 给子元素的槽位就是
             其期望高度,子元素自己的对齐不生效。头部行 MinHeight=44 = 卡片内容区高
             (MinHeight 64 - 上下 padding 10):收起时它撑满内容区、内容居中(上下对称);
             展开时它仍是同样的 44px 区域 ⇒ 开合瞬间头部行纹丝不动,"淡化时长"在下方
             自己的区域里出现,不会随内容整体上移 -->
        <StackPanel VerticalAlignment="Center" Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="44">
            <TextBlock Classes="setting-icon" Text="{DynamicResource IconDeviceEq}" />
            <TextBlock Grid.Column="1" Classes="setting-title" Text="音频交叉淡化" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding CrossfadeText}" FontSize="13"
                         Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding Crossfade}" OnContent="" OffContent="" />
              <!-- 展开指示箭头:开启后展开时长滑杆,箭头随开合旋转 -->
              <TextBlock Classes="setting-chevron" Text="{DynamicResource IconChevronDown}"
                         FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="10"
                         Margin="2,0,0,0" Classes.expanded="{Binding Crossfade}" />
            </StackPanel>
          </Grid>
          <!-- 开启后展开"淡化时长"行(原版 = 同一卡片内的子行:图标 + 标题 + 时长 + 滑杆);
               行间距由上方 StackPanel 的 Spacing 提供,这里不再写 Margin -->
          <!-- 时长文本 MinWidth+右对齐(Fluent2 设置行惯例):值列宽恒定,拖动时数字
               "3s"→"3.5s"→"11.5s" 变宽只在本列内换字,不挤滑杆列、不触发任何 reflow
               —— 此前 Auto 列宽随数字伸缩,与 code-behind 的滑杆定宽快照错位,行内
               元素左右振荡。右对齐让数字变化时右缘(贴滑杆侧)不动 -->
          <!-- 滑杆宽度由 code-behind 按行宽动态设置(= min(280, 行宽-固定件)):
               写死 Width 窄屏溢出卡片;Stretch+MaxWidth 会在宽屏被居中(实测)都不行 -->
          <Grid x:Name="CrossfadeRow" IsVisible="{Binding Crossfade}" ColumnDefinitions="Auto,Auto,Auto,*"
                SizeChanged="OnCrossfadeRowSizeChanged">
            <TextBlock x:Name="CrossfadeIcon" Classes="setting-icon" Text="{DynamicResource IconRecents}" />
            <TextBlock x:Name="CrossfadeTitle" Grid.Column="1" Classes="setting-title" Text="淡化时长"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CrossfadeSecondsText" Grid.Column="2" Text="{Binding CrossfadeSecondsText}"
                       FontSize="13" Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" Margin="0,0,20,0"
                       MinWidth="36" TextAlignment="Right" />
            <Slider x:Name="CrossfadeSlider" Grid.Column="3" HorizontalAlignment="Right"
                    Minimum="0" Maximum="12" TickFrequency="0.5"
                    Value="{Binding CrossfadeSeconds}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ 网络 ============ -->
      <TextBlock Classes="section-header" Text="网络" />

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconGlobe}" />
          <TextBlock Grid.Column="1" Classes="setting-title" Text="应用网络代理" />
          <Button Grid.Column="2" Classes="setting-action" Content="代理设置"
                  Command="{Binding OpenProxySettingsCommand}" />
        </Grid>
      </Border>

      <!-- ============ 存储 ============ -->
      <TextBlock Classes="section-header" Text="存储" />

      <Border x:Name="CacheLimitCard" Classes="setting-card" Margin="0,0,0,8">
        <Grid Classes="cache-limit-row" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
              SizeChanged="OnCacheLimitRowSizeChanged">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconMusicNote}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Classes="setting-title" Text="缓存上限" />
            <!-- Fluent Info label：说明按需打开，触屏和键盘都可访问。 -->
            <Button x:Name="CacheLimitInfoButton" Classes="icon-button" Width="40" Height="40"
                    Padding="10" VerticalAlignment="Center"
                    AutomationProperties.Name="缓存上限的更多信息"
                    ToolTip.Tip="缓存上限说明">
              <TextBlock Text="{DynamicResource IconInfo}" FontFamily="{DynamicResource LyricEaseIconsOutline}"
                         FontSize="20" Foreground="{DynamicResource TextSecondary}" />
              <Button.Flyout>
                <Flyout Placement="Top">
                  <TextBlock MaxWidth="280" Margin="12" TextWrapping="Wrap" FontSize="14"
                             Foreground="{DynamicResource TextPrimary}"
                             Text="音乐、封面、歌词和离线歌单索引共用此容量，每首歌优先保留已缓存的最高音质。超出上限时，会自动清理最久未使用的内容。" />
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel Classes="cache-limit-editor" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <NumericUpDown Width="140" Height="32"
                           AutomationProperties.Name="缓存上限（MB）"
                           Minimum="128" Maximum="10240" Increment="128"
                           Value="{CompiledBinding MusicCacheMaximumSizeMb, Mode=TwoWay}" />
            <TextBlock Text="MB" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="setting-card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="setting-icon" Text="{DynamicResource IconDatabase}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="setting-title" Text="管理缓存" />
            <TextBlock Classes="about-link" Text="关于该选项"
                       ToolTip.Tip="清除音乐、封面、歌词和离线歌单索引,不会删除云端歌单与登录信息。" />
          </StackPanel>
          <Button Grid.Column="2" Classes="setting-action" Command="{CompiledBinding OpenClearCacheDialogCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{DynamicResource IconBroom}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="14" />
              <TextBlock Text="管理缓存" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <TextBlock IsVisible="{CompiledBinding HasStatus}" Text="{CompiledBinding Status}"
                 FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0" />

      <!-- ============ 关于 ============ -->
      <TextBlock Classes="section-header" Text="关于" />

      <!-- 开源项目引用:内置 Expander,整行点击开合;IsExpanded 双向绑定 VM(记忆展开态) -->
      <Expander Classes="setting-expander" IsExpanded="{Binding OpenSourceExpanded, Mode=TwoWay}">
        <Expander.Header>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="setting-icon" FontFamily="{DynamicResource LyricEaseIconsOriginal}"
                       Text="{DynamicResource IconCode}" />
            <TextBlock Grid.Column="1" Classes="setting-title" Text="开源项目引用" />
            <!-- 占位:标题过长时不顶到 chevron 下方 -->
            <TextBlock Grid.Column="2" MinWidth="24" />
          </Grid>
        </Expander.Header>
        <!-- 展开内容:开源仓库链接,点击在系统浏览器打开;左缩进与标题对齐(Padding 16 + 20) -->
        <ItemsControl Margin="20,0,0,6" ItemsSource="{Binding OpenSourceProjects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OpenSourceProject">
              <!-- 不用负 Margin 顶 Padding:HyperlinkButton 自带 ClipToBounds,负 Margin 会把按钮
                   推出父容器左缘,父容器把左侧那截(含左内边距与左圆角)裁掉 ⇒ 文字贴死左边。
                   让按钮左缘就落在 20px 缩进线上,文字自然内缩 4px(与原版一致)。 -->
              <HyperlinkButton Classes="link" Margin="0,2,0,0" Content="{Binding Name}"
                               Command="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).OpenProjectCommand}"
                               CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>

      <!-- 详细信息:应用名/版本(含"检查更新")/安装日期;参考原版"详细信息"卡片,无开发者行 -->
      <Expander Classes="setting-expander">
        <Expander.Header>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="setting-icon" FontFamily="{DynamicResource LyricEaseIconsOutline}"
                       Text="{DynamicResource IconInfo}" />
            <TextBlock Grid.Column="1" Classes="setting-title" Text="详细信息" />
            <!-- 占位:标题过长时不顶到 chevron 下方 -->
            <TextBlock Grid.Column="2" MinWidth="24" />
          </Grid>
        </Expander.Header>
        <Grid Margin="20,4,0,10" ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <Grid.Styles>
            <Style Selector="TextBlock.info-label">
              <Setter Property="FontSize" Value="13" />
              <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="TextBlock.info-value">
              <Setter Property="FontSize" Value="13" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </Grid.Styles>
          <!-- 应用名 + 一句话简介 -->
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,8,0,0"
                     Text="ALyricEase" FontWeight="SemiBold"/>
          <!-- 版本 + 检查更新 -->
          <TextBlock Grid.Row="1" Grid.Column="0" Classes="info-label" Text="版本" Margin="0,12,0,12" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                      VerticalAlignment="Center">
            <TextBlock Classes="info-value" Text="{Binding AppVersionText}" />
            <Button Classes="setting-action" MinWidth="96" Height="28" Content="检查更新"
                    IsVisible="{Binding UpdateSupported}"
                    Command="{Binding CheckForUpdatesCommand}" />
          </StackPanel>
          <!-- 安装日期 -->
          <TextBlock Grid.Row="2" Grid.Column="0" Classes="info-label" Text="安装日期" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="info-value" Text="{Binding InstallDateText}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Classes="info-label" Text="问题排查"
                     IsVisible="{Binding LogFolderSupported}" Margin="0,12,0,0" />
          <Button Grid.Row="3" Grid.Column="1" Classes="setting-action" Content="打开日志文件夹"
                  HorizontalAlignment="Left" Margin="0,12,0,0"
                  IsVisible="{Binding LogFolderSupported}" Command="{Binding OpenLogFolderCommand}" />
          <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Classes="info-label" TextWrapping="Wrap" Margin="0,8,0,0"
                     IsVisible="{Binding LogFolderUnavailable}" Text="日志目录不可写，本次运行未启用文件日志。" />
        </Grid>
      </Expander>

      <!-- APPEND -->
    </StackPanel>
  </ScrollViewer>
</UserControl>
