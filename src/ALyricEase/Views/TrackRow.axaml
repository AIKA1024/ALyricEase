<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="using:ALyricEase.Infrastructure"
        xmlns:vm="using:ALyricEase.ViewModels"
        xmlns:views="using:ALyricEase.Views"
        x:CompileBindings="True">
  <Styles.Resources>
    <!-- 行内按钮专用模板:纯 Border + 内容,无内置 PointerOver 视觉状态。
         红心(黑圆)无悬停;播放/更多(透明圆)与歌手/专辑(文本链接)的悬停/按下由各自样式控制,背景/圆角/内边距经 TemplateBinding 透传 -->
    <ControlTheme x:Key="RowButtonTheme" TargetType="Button">
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <!-- 仿默认 Fluent 按钮结构:Border 撑满(Background/Width/Height),ContentPresenter 也撑满并自带
               Padding + CornerRadius —— 状态色经 /template/ 设在 ContentPresenter 上时覆盖整个按钮(含 padding 区),
               圆角由它自己画(不用靠 Border 裁剪);ClipToBounds 兜底防子元素越界 -->
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" ClipToBounds="True">
            <!-- 命名 PART_ContentPresenter 与默认 Fluent 按钮模板一致:应用里所有按钮状态样式统一用
                 /template/ ContentPresenter#PART_ContentPresenter 命中 -->
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- 每日歌曲行:仿原版 SearchResultTrackListItemStyle(50/*/32/32 → 封面/歌名歌手/时长+播放·更多),播放按钮靠右 -->
    <ControlTheme x:Key="TrackRowSearchTheme" TargetType="views:TrackRow">
      <Setter Property="Width" Value="400" />
      <Setter Property="Height" Value="60" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Template">
        <ControlTemplate TargetType="views:TrackRow" x:DataType="vm:SongItemViewModel">
          <!-- 根 Grid 画控件的 Background(透明):否则行内空白不可命中,hover 只在内层控件上生效 -->
          <Grid Background="{TemplateBinding Background}" Classes="track-root" IsEnabled="{Binding IsPlayable}">
            <!-- 悬停高亮画在内容之后(背景色,仿原版 Grid.Background 动画),不遮罩封面/红心;圆角 4 仿原版 GridViewItemPresenter -->
            <Border Classes="row-hover-bg" CornerRadius="4" IsHitTestVisible="False" />
            <Border Classes="row-pressed-bg" />
            <!-- 仿原版 SearchResultTrackListItemStyle:50/*/32/32 + 内容左右留白 8(原版 Padding 8,0)+ ColumnSpacing 8 -->
            <Grid ColumnDefinitions="50,*,32,32" Margin="8,0" ColumnSpacing="8">
              <Border Width="50" Height="50" CornerRadius="4" ClipToBounds="True" Margin="0,5"
                      Background="{DynamicResource ArtFallback}">
                <Grid>
                  <Image infra:ManagedCoverImage.DecodeSize="50"
                         infra:ManagedCoverImage.Source="{Binding Song.CoverUrl}"
                         Stretch="UniformToFill" />
                  <!-- 封面红心按钮:黑圆底 + 实心爱心(仿原版 LikeToggleButtonStyle),悬停浮现;未喜欢白,喜欢红 E74C3C -->
                  <Button Theme="{StaticResource RowButtonTheme}" Classes="row-heart row-play-cover" Command="{Binding PlayCommand}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="播放">
                    <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIconsFilled}"
                               FontSize="20" Foreground="White" />
                  </Button>
                  <Button Theme="{StaticResource RowButtonTheme}" Classes="row-heart" Command="{Binding LikeCommand}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="喜欢">
                    <Grid>
                      <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}"
                                 FontSize="24"
                                 Foreground="White"
                                 IsVisible="{Binding IsInLikelist, Converter={x:Static BoolConverters.Not}}" />
                      <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}"
                                 FontSize="24"
                                 Foreground="#FFE74C3C" IsVisible="{Binding IsInLikelist}" />
                    </Grid>
                  </Button>
                </Grid>
              </Border>
              <StackPanel Classes="row-title" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <!-- 歌手/专辑链接按钮(仿原版 ArtistsAndAlbum),点击出菜单跳歌手/专辑页;两者皆无名时整个隐藏 -->
                <Button x:Name="ArtistAlbumButton" Classes="row-link" HorizontalAlignment="Left"
                        VerticalAlignment="Center" IsVisible="{Binding HasArtistOrAlbumName}"
                        IsEnabled="{Binding HasArtistOrAlbum}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding ArtistsAndAlbumText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button.Resources>
                    <!-- MenuFlyout:原生 hover 子菜单/延迟/定位(多歌手"表演者"子项),不再手写计时器;
                         菜单项/弹层观感走全局 MenuItem/MenuFlyoutPresenter 默认样式(同侧栏右键菜单) -->
                    <MenuFlyout x:Key="TrackMenuFlyout" ShowMode="Transient">
                      <!-- 单歌手:直接跳歌手页 -->
                      <MenuItem Header="{Binding Artist, StringFormat='表演者: {0}'}"
                                Command="{Binding OpenArtistCommand}"
                                IsEnabled="{Binding HasArtist}"
                                IsVisible="{Binding HasMultipleArtists, Converter={x:Static BoolConverters.Not}}">
                        <MenuItem.Icon>
                          <TextBlock Text="{DynamicResource IconSingleArtist}"
                                     FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <!-- 多歌手:子菜单逐项跳对应歌手页(ItemContainerTheme 直接绑生成的 MenuItem 容器,不用 DataTemplate 嵌套) -->
                      <MenuItem Header="表演者" IsVisible="{Binding HasMultipleArtists}"
                                ItemsSource="{Binding Artists}">
                        <MenuItem.Icon>
                          <TextBlock Text="{DynamicResource IconMultiArtists}"
                                     FontFamily="{DynamicResource LyricEaseIconsOriginal}" FontSize="14" />
                        </MenuItem.Icon>
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="vm:ArtistNavItem"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Id}" />
                            <Setter Property="IsEnabled" Value="{Binding HasTarget}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>
                      <!-- 专辑 -->
                      <MenuItem Header="{Binding Album, StringFormat='专辑: {0}'}"
                                Command="{Binding OpenAlbumCommand}"
                                IsEnabled="{Binding HasAlbum}">
                        <MenuItem.Icon>
                          <TextBlock Text="{DynamicResource IconAlbum}" FontFamily="{DynamicResource LyricEaseIconsOriginal}"
                                     FontSize="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Resources>
                </Button>
              </StackPanel>
              <!-- 播放按钮:悬停浮现,居中于标题与时长之间(仿原版 SearchResult 播放按钮独立列) -->
              <Button Grid.Column="2" Theme="{StaticResource RowButtonTheme}" Classes="row-ops row-action row-play-inline"
                      Command="{Binding PlayCommand}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="播放">
                <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIconsFilled}"
                           FontSize="15" />
              </Button>
              <Button Grid.Column="2" Theme="{StaticResource RowButtonTheme}" Classes="row-action row-like-inline"
                      Command="{Binding LikeCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="喜欢">
                <Grid>
                  <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="15"
                             Foreground="White" IsVisible="{Binding IsInLikelist, Converter={x:Static BoolConverters.Not}}" />
                  <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="15"
                             Foreground="#FFE74C3C" IsVisible="{Binding IsInLikelist}" />
                </Grid>
              </Button>
              <Grid Grid.Column="3" VerticalAlignment="Center">
                <!-- 时长与更多按钮同列居中:悬停时 32px 更多按钮原地盖住窄时长,无跳动(仿原版 Duration/MoreButton 同列) -->
                <TextBlock Classes="row-duration" Text="{Binding DurationText}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
                <Button x:Name="MoreButton" Theme="{StaticResource RowButtonTheme}" Classes="row-ops row-action"
                        HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="更多操作">
                  <TextBlock Text="{DynamicResource IconMore}" FontFamily="{DynamicResource LyricEaseIcons}"
                             FontSize="16" />
                </Button>
              </Grid>
            </Grid>
            <!-- 音源角标(网易云/QQ 标签页 favicon):钉在 item 左下角,悬停浮现,不可命中。
                 无垫片,图标 HighQuality 插值缩放抗锯齿 -->
            <Panel Classes="source-badge" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="2,0,0,2" Width="16" Height="16" IsHitTestVisible="False">
              <Image Source="{Binding SourceBadge}" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- 歌单宽行:仿原版 PlaylistTrackListItemWideStyle(30/50/3*/32/2*/3*/32 + Padding 8,0 + ColumnSpacing 8):
         序号 | 封面 | 歌名(跨列占播放列,悬停收起) | 播放(悬停) | 歌手 | 专辑 | 时长·更多(同列居中,更多盖住时长) -->
    <ControlTheme x:Key="TrackRowPlaylistWideTheme" TargetType="views:TrackRow">
      <Setter Property="Template">
        <ControlTemplate TargetType="views:TrackRow" x:DataType="vm:SongItemViewModel">
          <Grid Background="{TemplateBinding Background}" Classes="track-root" IsEnabled="{Binding IsPlayable}">
            <!-- 悬停高亮画在内容之后(背景色,仿原版 Grid.Background 动画),不遮罩封面/红心;圆角 4 仿原版 ListViewItemPresenter -->
            <Border Classes="row-hover-bg" CornerRadius="4" IsHitTestVisible="False" />
            <Border Classes="row-pressed-bg" />
            <!-- 仿原版 PlaylistTrackListItemWideStyle:30/50/3*/32/2*/3*/32 + 内容左右留白 8 + ColumnSpacing 8
                 (Grid 无 Padding,用 Margin 实现行内左右留白) -->
            <Grid ColumnDefinitions="30,50,3*,32,2*,3*,32" Margin="8,0" ColumnSpacing="8">
              <!-- 序号 -->
              <TextBlock Grid.Column="0" Text="{Binding DisplayIndex}" FontSize="12" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
              <!-- 封面(50,上下留白 5,圆角4)+ 红心 -->
              <Border Grid.Column="1" Width="50" Height="50" CornerRadius="4" ClipToBounds="True" Margin="0,5"
                      Background="{DynamicResource ArtFallback}">
                <Grid>
                  <Image infra:ManagedCoverImage.DecodeSize="50"
                         infra:ManagedCoverImage.Source="{Binding Song.CoverUrl}"
                         Stretch="UniformToFill" />
                  <Button Theme="{StaticResource RowButtonTheme}" Classes="row-heart row-play-cover" Command="{Binding PlayCommand}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="播放">
                    <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIconsFilled}"
                               FontSize="20" Foreground="White" />
                  </Button>
                  <Button Theme="{StaticResource RowButtonTheme}" Classes="row-heart" Command="{Binding LikeCommand}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="喜欢">
                    <Grid>
                      <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}"
                                 FontSize="24"
                                 Foreground="White"
                                 IsVisible="{Binding IsInLikelist, Converter={x:Static BoolConverters.Not}}" />
                      <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}"
                                 FontSize="24"
                                 Foreground="#FFE74C3C" IsVisible="{Binding IsInLikelist}" />
                    </Grid>
                  </Button>
                </Grid>
              </Border>
              <!-- 歌名:跨列占播放列,悬停收起(仿原版 TitlePanel ColumnSpan) -->
              <TextBlock Classes="row-title" Grid.Column="2" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <!-- 播放按钮:悬停浮现,居中于歌名与歌手之间 -->
              <Button Grid.Column="3" Theme="{StaticResource RowButtonTheme}" Classes="row-ops row-action row-play-inline"
                      Command="{Binding PlayCommand}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="播放">
                <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIconsFilled}"
                           FontSize="15" />
              </Button>
              <Button Grid.Column="3" Theme="{StaticResource RowButtonTheme}" Classes="row-action row-like-inline"
                      Command="{Binding LikeCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="喜欢">
                <Grid>
                  <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="15"
                             Foreground="White" IsVisible="{Binding IsInLikelist, Converter={x:Static BoolConverters.Not}}" />
                  <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="15"
                             Foreground="#FFE74C3C" IsVisible="{Binding IsInLikelist}" />
                </Grid>
              </Button>
              <!-- 歌手:可点击 → 歌手页(仿原版 ArtistsButton);多歌手时按下弹菜单选歌手。
                   有名即显示;无 id(如云盘无版权歌曲)时显示但禁用点击 -->
              <Button Grid.Column="4" x:Name="ArtistButton" Theme="{StaticResource RowButtonTheme}" Classes="row-link"
                      Command="{Binding OpenArtistCommand}" VerticalAlignment="Center" ToolTip.Tip="打开歌手页"
                      IsVisible="{Binding HasArtistName}" IsEnabled="{Binding HasArtist}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button.Resources>
                  <!-- 多歌手菜单:点击歌手按钮直接平铺歌手名(仅表演者,不设"表演者>"分级),逐项跳对应歌手页 -->
                  <MenuFlyout x:Key="ArtistMenuFlyout" ShowMode="Transient" FlyoutPresenterClasses="track-menu-presenter"
                              ItemsSource="{Binding Artists}">
                    <MenuFlyout.ItemContainerTheme>
                      <!-- 仅绑定每项的路由数据;观感走全局 MenuItem 默认样式(同 track-menu 项) -->
                      <ControlTheme TargetType="MenuItem" x:DataType="vm:ArtistNavItem"
                                    BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding OpenCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding Id}" />
                        <Setter Property="IsEnabled" Value="{Binding HasTarget}" />
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </Button.Resources>
              </Button>
              <!-- 专辑:可点击 → 专辑页(仿原版 AlbumButton)。
                   有名即显示;无 id(如云盘无版权歌曲)时显示但禁用点击 -->
              <Button Grid.Column="5" Theme="{StaticResource RowButtonTheme}" Classes="row-link"
                      Command="{Binding OpenAlbumCommand}" VerticalAlignment="Center" ToolTip.Tip="打开专辑页"
                      IsVisible="{Binding HasAlbumName}" IsEnabled="{Binding HasAlbum}">
                <TextBlock Text="{Binding Album}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
              </Button>
              <!-- 时长 + 更多(同列居中,更多盖住时长) -->
              <Grid Grid.Column="6" VerticalAlignment="Center">
                <TextBlock Classes="row-duration" Text="{Binding DurationText}" FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <Button x:Name="MoreButton" Theme="{StaticResource RowButtonTheme}" Classes="row-ops row-action"
                        HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="更多操作">
                  <TextBlock Text="{DynamicResource IconMore}" FontFamily="{DynamicResource LyricEaseIcons}"
                             FontSize="16" />
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <!-- 专辑行:仿原版 PlaylistTrackListItemWideStyle 但去掉封面列。
         专辑内歌曲封面与专辑一致,行内不再重复显示 Image,红心移到歌名右侧悬停浮现。 -->
    <ControlTheme x:Key="TrackRowAlbumTheme" TargetType="views:TrackRow">
      <Setter Property="Template">
        <ControlTemplate TargetType="views:TrackRow" x:DataType="vm:SongItemViewModel">
          <Grid Background="{TemplateBinding Background}" Classes="track-root" IsEnabled="{Binding IsPlayable}">
            <!-- 悬停高亮 -->
            <Border Classes="row-hover-bg" CornerRadius="4" IsHitTestVisible="False" />
            <Border Classes="row-pressed-bg" />
            <Grid Classes="album-row-grid" ColumnDefinitions="64,3*,32,2*,32" Margin="8,0" ColumnSpacing="8">
              <!-- 序号 + 红心(无封面,红心悬停时覆盖在序号上) -->
              <Grid Grid.Column="0" VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="{Binding DisplayIndex}" FontSize="12" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                <Button Theme="{StaticResource RowButtonTheme}" Classes="row-heart album-heart row-play-cover"
                        Command="{Binding PlayCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip.Tip="播放">
                  <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIconsFilled}"
                             FontSize="13" Foreground="White" />
                </Button>
                <Button Theme="{StaticResource RowButtonTheme}" Classes="row-heart album-heart"
                        Command="{Binding LikeCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip.Tip="喜欢">
                  <Grid>
                    <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}"
                               FontSize="15"
                               Foreground="White"
                               IsVisible="{Binding IsInLikelist, Converter={x:Static BoolConverters.Not}}" />
                    <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}"
                               FontSize="15"
                               Foreground="#FFE74C3C" IsVisible="{Binding IsInLikelist}" />
                  </Grid>
                </Button>
              </Grid>
              <!-- 歌名 -->
              <TextBlock Classes="row-title" Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <!-- 播放按钮 -->
              <Button Grid.Column="2" Theme="{StaticResource RowButtonTheme}" Classes="row-ops row-action row-play-inline"
                      Command="{Binding PlayCommand}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="播放">
                <TextBlock Text="{DynamicResource IconPlayFilled}" FontFamily="{DynamicResource LyricEaseIconsFilled}"
                           FontSize="15" />
              </Button>
              <Button Grid.Column="2" Theme="{StaticResource RowButtonTheme}" Classes="row-action row-like-inline"
                      Command="{Binding LikeCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="喜欢">
                <Grid>
                  <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="15"
                             Foreground="White" IsVisible="{Binding IsInLikelist, Converter={x:Static BoolConverters.Not}}" />
                  <TextBlock Text="{DynamicResource IconHeart}" FontFamily="{DynamicResource LyricEaseIcons}" FontSize="15"
                             Foreground="#FFE74C3C" IsVisible="{Binding IsInLikelist}" />
                </Grid>
              </Button>
              <!-- 歌手:有名即显示,无 id 时禁用点击 -->
              <Button Grid.Column="3" x:Name="ArtistButton" Theme="{StaticResource RowButtonTheme}" Classes="row-link"
                      Command="{Binding OpenArtistCommand}" VerticalAlignment="Center" ToolTip.Tip="打开歌手页"
                      IsVisible="{Binding HasArtistName}" IsEnabled="{Binding HasArtist}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button.Resources>
                  <MenuFlyout x:Key="ArtistMenuFlyout" ShowMode="Transient" ItemsSource="{Binding Artists}">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" x:DataType="vm:ArtistNavItem"
                                    BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding OpenCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding Id}" />
                        <Setter Property="IsEnabled" Value="{Binding HasTarget}" />
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </Button.Resources>
              </Button>
              <!-- 时长 + 更多 -->
              <Grid Grid.Column="4" VerticalAlignment="Center">
                <TextBlock Classes="row-duration" Text="{Binding DurationText}" FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <Button x:Name="MoreButton" Theme="{StaticResource RowButtonTheme}" Classes="row-ops row-action"
                        HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="更多操作">
                  <TextBlock Text="{DynamicResource IconMore}" FontFamily="{DynamicResource LyricEaseIcons}"
                             FontSize="16" />
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

  </Styles.Resources>

  <!-- 默认样式:默认套用歌单宽行;Background=Transparent 让整行可命中(:pointerover 悬停高亮 + 双击播放) -->
  <Style Selector="views|TrackRow">
    <Setter Property="Theme" Value="{StaticResource TrackRowPlaylistWideTheme}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="60" />
  </Style>

  <!-- 悬停高亮:画在内容之后(仿原版行背景色动画),不遮罩封面/红心;
       暗色 hover #343434 / pressed #464646(与用户页歌单行一致),亮色为 20%→35% 黑叠加 -->
  <Style Selector="views|TrackRow Border.row-hover-bg">
    <Setter Property="Background" Value="{DynamicResource RowHoverBackground}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="views|TrackRow:pointerover Border.row-hover-bg">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- :pressed 伪类由 TrackRow.cs 手动维护(TemplatedControl 不自带;此前此文件里的 :pressed 样式
       无人设置、从不生效)。Avalonia 12 捕获期间 hit≠捕获元素 ⇒ over 链清空,:pointerover 抖动,
       按住期间的视觉锁存必须挂 :pressed。各组声明在对应 :pointerover 之后,按住时覆盖 hover 态 -->
  <Style Selector="views|TrackRow:pressed Border.row-hover-bg">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="views|TrackRow:pressed Border.row-hover-bg">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- 按下层:瞬时显隐(无过渡语义)。按下色的变化不走画刷过渡 —— BrushTransition 实测比样式
       赋值晚一拍接管(赋值瞬间终值先落地可被渲染,探针 pressedtimeline 证实) -->
  <Style Selector="views|TrackRow Border.row-pressed-bg">
    <Setter Property="Background" Value="{DynamicResource RowPressedBackground}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow:pressed Border.row-pressed-bg">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- 悬停浮现操作按钮(播放/更多均为单个 Button,row-ops 类),同时隐藏时长 -->
  <Style Selector="views|TrackRow Button.row-ops">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow:pointerover Button.row-ops">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="views|TrackRow:pressed Button.row-ops">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="views|TrackRow:pointerover TextBlock.row-duration">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow:pressed TextBlock.row-duration">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- 行标题:默认跨占播放按钮列(ColumnSpan=2,文本延伸),悬停时收起为 1,给浮现的播放按钮让位。
       标题元素每日行是 StackPanel、歌单行是 TextBlock,故用类选择器 + x:SetterTargetType 让 setter 可解析 -->
  <Style Selector="views|TrackRow .row-title" x:SetterTargetType="Control">
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="views|TrackRow:pointerover .row-title" x:SetterTargetType="Control">
    <Setter Property="Grid.ColumnSpan" Value="1" />
  </Style>
  <Style Selector="views|TrackRow:pressed .row-title" x:SetterTargetType="Control">
    <Setter Property="Grid.ColumnSpan" Value="1" />
  </Style>

  <!-- 圆形操作按钮(播放/更多)的几何与配色已升为全局 Button.row-action 样式(Styles/Controls/Buttons.axaml),
       歌曲行与用户页歌单行共用;此处仅保留行内浮现(row-ops)与红心/文本链接等行专属样式 -->

  <!-- 歌手/专辑文本链接按钮:仿原版(Background #00FFFFFF CornerRadius4 Padding4),内容靠左、不撑满整列;
       悬停 SystemBaseLow、按下 SystemBaseMediumLow。同 row-action,控件级 setter 可靠生效 -->
  <Style Selector="views|TrackRow Button.row-link">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="views|TrackRow Button.row-link:pointerover">
    <Setter Property="Background" Value="{DynamicResource SystemBaseLow}" />
  </Style>
  <Style Selector="views|TrackRow Button.row-link:pressed">
    <Setter Property="Background" Value="{DynamicResource SystemBaseMediumLow}" />
  </Style>

  <!-- 封面红心按钮:黑圆底(仿原版 LikeToggleButtonStyle Background=#FF000000) + 实心爱心,悬停浮现;爱心颜色由模板内双 TextBlock 按 IsInLikelist 切换 -->
  <Style Selector="views|TrackRow Button.row-heart">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="#FF000000" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- 专辑行序号上的红心:比通用 row-heart 更具体,覆盖为 32 -->
  <Style Selector="views|TrackRow Button.row-heart.album-heart">
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="views|TrackRow:pointerover Button.row-heart">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="views|TrackRow:pressed Button.row-heart">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- 按钮/喜欢位置互换(swap-ops 类由 TrackRow 按 AppState.SwapPlayAndLikeOnRows 挂):
       开启时播放钮挪到封面(黑圆▶,占原红心位)、喜欢钮挪到行中播放列(透明圆♥)。
       各副本默认 IsVisible=False,swap+hover/pressed 时显示;原位按钮被 swap 抑制样式恒隐。
       声明顺序在 row-heart/row-ops 的 :pointerover/:pressed 之后,保证抑制生效 -->
  <Style Selector="views|TrackRow Button.row-play-cover">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow.swap-ops:pointerover Button.row-play-cover">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="views|TrackRow.swap-ops:pressed Button.row-play-cover">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="views|TrackRow Button.row-like-inline">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow.swap-ops:pointerover Button.row-like-inline">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="views|TrackRow.swap-ops:pressed Button.row-like-inline">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- 原位按钮抑制:封面/序号上的原红心(除互换播放钮)与行中原播放钮 -->
  <Style Selector="views|TrackRow.swap-ops Button.row-heart:not(.row-play-cover)">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow.swap-ops Button.row-play-inline">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- 音源角标(每日行 item 左下):默认隐藏;悬停显现规则由各页面局部样式定义
       (仅推荐页混排两音源需要角标,歌手/歌单页单源无意义,见 RecommendView.axaml) -->
  <Style Selector="views|TrackRow Panel.source-badge">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <!-- 不可播放歌曲行:整行禁用置灰(IsPlayable=false),输入与双击播放一并失效。
       注意必须禁用 TrackRow 控件本身(而非只禁模板内 Grid):悬停高亮/操作按钮浮现都是
       TrackRow:pointerover 驱动,控件禁用后 :pointerover 不再触发,hover 一并消失 -->
  <Style Selector="views|TrackRow" x:DataType="vm:SongItemViewModel">
    <Setter Property="IsEnabled" Value="{Binding IsPlayable}" />
  </Style>
  <Style Selector="views|TrackRow Grid.track-root:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- 触控模式覆盖(TrackRow 构造时按 InteractionDefaults.IsTouchPrimary 挂 touch 类;
       放在文件末尾保证压过上面的 :pointerover 样式):触屏整行单击即播放(控件内处理),
       hover 才浮现的控件(播放/更多/红心/时长切换/标题列宽变化)一律保持桌面默认的隐藏状态,
       包括触屏按下瞬间 :pointerover 短暂触发造成的闪现,也一并压制 -->
  <Style Selector="views|TrackRow.touch Button.row-ops">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow.touch TextBlock.row-duration">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="views|TrackRow.touch Button.row-heart">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow.touch Button.row-like-inline">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|TrackRow.touch .row-title" x:SetterTargetType="Control">
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
</Styles>
